    Public Function AreTablesTheSame() As Boolean
        'Dim tbl1 As DataTable = Session("OrderProduct")
        Dim tbl1 As DataTable = ViewState("OrderProduct1")
        Dim tbl2 As DataTable
        '----starts
        Dim dtN As New DataTable()
        '   For i As Integer = 0 To grditemproduct.Columns.Count - 1
        'dtN.Columns.Add("column" + i.ToString())
        Dim count As Integer = 82
        dtN.Columns.Add("ItemDt_ID", GetType(Integer))
        dtN.Columns.Add("ProductId", GetType(Integer))
        dtN.Columns.Add("Product_Name", GetType(String))
        dtN.Columns.Add("Product_Code", GetType(String))
        dtN.Columns.Add("Packing_Packing", GetType(String))
        dtN.Columns.Add("Packing_Weight", GetType(String))
        dtN.Columns.Add("ItemDt_Rate", GetType(String))
        dtN.Columns.Add("ItemDt_Qty", GetType(String))
        dtN.Columns.Add("Product_Vat", GetType(String))
        dtN.Columns.Add("ItemDt_Amount", GetType(String))
        dtN.Columns.Add("Discounted_Rate", GetType(String))
        dtN.Columns.Add("Product_Margin", GetType(String))
        dtN.Columns.Add("Product_Cost", GetType(String))
        dtN.Columns.Add("Product_CostSKU", GetType(String))
        dtN.Columns.Add("Product_Rate", GetType(String))
        dtN.Columns.Add("ItemDt_DesiredMargin", GetType(String))


        For Each row In grditemproduct.Rows
            Dim txtdmarginp As TextBox = TryCast(row.FindControl("txtdmarginp"), TextBox)
            Dim ltProductId = DirectCast(row.FindControl("ltProductId"), Label)
            Dim ltproductname = DirectCast(row.FindControl("ltproductname"), Label)
            Dim ltproductcode = DirectCast(row.FindControl("ltproductcode"), Label)
            Dim ltpackingpacking = DirectCast(row.FindControl("ltpackingpacking"), Label)
            Dim ltproductWeight As Label = TryCast(row.FindControl("ltproductWeight"), Label)
            Dim ltproductrate = DirectCast(row.FindControl("ltproductrate"), Label)
            Dim ltdisounted = DirectCast(row.FindControl("ltdisounted"), Label)
            Dim txtquantity As TextBox = TryCast(row.FindControl("txtquantity"), TextBox)
            Dim ltkg As Label = TryCast(row.FindControl("ltkg"), Label)

            Dim lblname = DirectCast(row.FindControl("lblname"), Label)
            Dim lblcode = DirectCast(row.FindControl("ltproductcode"), Label)

            Dim ltpacking = DirectCast(row.FindControl("ltpacking"), Label)

            Dim lblrate = DirectCast(row.FindControl("lblrate"), Label)
            '  Dim ckselect = DirectCast(row.FindControl("ckselect"), CheckBox)

            Dim lblprductcost = DirectCast(row.FindControl("lblprductcost"), Label)

            Dim ltproductcost = DirectCast(row.FindControl("ltproductcost"), Label)
            Dim ltproductSKUcost = DirectCast(row.FindControl("ltproductSKUcost"), Label)
            Dim lblproductrate = DirectCast(row.FindControl("lblproductrate"), Label)
            Dim ltsumamount = DirectCast(row.FindControl("ltamount"), Label)
            Dim ltmarginp = DirectCast(row.FindControl("ltmarginp"), Label)
            Dim ltrate1 = DirectCast(row.FindControl("ltrate"), Label)
            ltsumamount.Text = (CDbl(ltsumamount.Text)).ToString("N2")



            dtN.Rows.Add(count, ltProductId.Text, ltproductname.Text, ltproductcode.Text, ltpackingpacking.Text,
                         ltproductWeight.Text, ltrate1.Text.Replace(",", ""), txtquantity.Text, ltkg.Text, ltsumamount.Text.Replace(",", ""),
                         ltproductrate.Text.Replace(",", ""),
                         ltmarginp.Text, lblprductcost.Text, ltsumamount.Text.Replace(",", ""), ltproductrate.Text.Replace(",", ""), txtdmarginp.Text)
            count = count + 1
            ''check txtquantity.Text(7)
            '' ltsumamount.Text(9)
            ''ltrate.Text(10)
        Next
        tbl2 = dtN
        If tbl1.Rows.Count <> tbl2.Rows.Count OrElse tbl1.Columns.Count <> tbl2.Columns.Count Then
            Return False
        End If


        For i As Integer = 0 To tbl1.Rows.Count - 1
            ' For c As Integer 
            If Not Equals(tbl1.Rows(i)(7).ToString(), tbl2.Rows(i)(7).ToString()) Then
                Return False
            End If
            If Not Equals(tbl1.Rows(i)(9).ToString(), tbl2.Rows(i)(9).ToString()) Then
                Return False
            End If
            'If Not Equals(tbl1.Rows(i)(10).ToString(), tbl2.Rows(i)(10).ToString()) Then
            '    Return False
            'End If
            If Not Equals(tbl1.Rows(i)(6).ToString(), tbl2.Rows(i)(6).ToString()) Then
                Return False
            End If
            'Next
        Next
        Return True
    End Function
    Protected Sub btnopen_Click(sender As Object, e As EventArgs) Handles btnopen.Click
        Try
            btnsave.Enabled = True
            btnsave.Text = "Save"
            If ddrelatedtypeid.SelectedValue = "" Then
                ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + ("Please select a account before adding item").ToString + "')", True)
            Else
                fillUser()
                'GridView1.DataSource = ViewState("Fillproduct")
                'GridView1.DataBind()
                mpe.Show()
