    Public Sub addItem(ByVal flag As String)
        Try
            Dim count As Integer
            'If Session("OrderProduct") Is Nothing Then
            If ViewState("OrderProduct") Is Nothing Then


                count = 0
                Dim dt As New DataTable
                dt.Columns.Add("ItemDt_ID", GetType(Integer))
                dt.Columns.Add("ProductId", GetType(Integer))
                dt.Columns.Add("Product_Name", GetType(String))
                dt.Columns.Add("Product_Code", GetType(String))
                dt.Columns.Add("Packing_Packing", GetType(String))
                dt.Columns.Add("Packing_Weight", GetType(String))
                dt.Columns.Add("ItemDt_Rate", GetType(String))
                dt.Columns.Add("ItemDt_Qty", GetType(String))
                dt.Columns.Add("Product_Vat", GetType(String))
                dt.Columns.Add("ItemDt_Amount", GetType(String))
                dt.Columns.Add("Discounted_Rate", GetType(String))
                dt.Columns.Add("Product_Margin", GetType(String))
                dt.Columns.Add("Product_Cost", GetType(String))
                dt.Columns.Add("Product_CostSKU", GetType(String))
                dt.Columns.Add("Product_Rate", GetType(String))
                dt.Columns.Add("ItemDt_DesiredMargin", GetType(String))

                For Each row As GridViewRow In GridView1.Rows
                    Dim lblproductId = DirectCast(row.FindControl("lblproductId"), Label)
                    Dim lblname = DirectCast(row.FindControl("lblname"), Label)
                    Dim lblcode = DirectCast(row.FindControl("ltproductcode"), Label)
                    Dim lblunit = DirectCast(row.FindControl("lblunit"), Label)
                    Dim ltpacking = DirectCast(row.FindControl("ltpacking"), Label)
                    Dim lblvat = DirectCast(row.FindControl("lblvat"), Label)
                    Dim lblrate = DirectCast(row.FindControl("lblrate"), Label)
                    '  Dim ckselect = DirectCast(row.FindControl("ckselect"), CheckBox)
                    Dim lbldiscount = DirectCast(row.FindControl("lbldiscount"), Label)
                    Dim ltdisounted = DirectCast(row.FindControl("ltdisounted"), Label)
                    Dim ltproductmargin = DirectCast(row.FindControl("ltproductmargin"), Label)
                    Dim ltproductcost = DirectCast(row.FindControl("ltproductcost"), Label)
                    Dim ltproductSKUcost = DirectCast(row.FindControl("ltproductSKUcost"), Label)
                    Dim lblproductrate = DirectCast(row.FindControl("lblproductrate"), Label)
                    Dim txtOrderQty = DirectCast(row.FindControl("txtOrderQty"), TextBox)


                    '     If ckselect.Checked = True Then
                    If txtOrderQty.Text <> "" And txtOrderQty.Text <> "0" Then

                        If lbldiscount.Text = "" Then
                        Else
                            countrate = (Convert.ToDouble(lbldiscount.Text) / 100)
                            countrate1 = (Convert.ToDouble(lblrate.Text)) * countrate
                            lblrate.Text = Math.Round(Math.Round(Convert.ToDouble(lblrate.Text)) - countrate1)
                        End If
                        TotalAmount = Math.Round(Convert.ToDouble(lblrate.Text)) * Convert.ToDouble(lblunit.Text) * 1
                        Dim VAT As Double = Math.Round(Convert.ToDouble((lblvat.Text * TotalAmount) / 100))
                        TotalAmount = TotalAmount + VAT
                        dt.Rows.Add(count, lblproductId.Text, lblname.Text, lblcode.Text, ltpacking.Text, lblunit.Text, lblrate.Text, txtOrderQty.Text,
                                    lblvat.Text, TotalAmount, ltdisounted.Text, ltproductmargin.Text, ltproductcost.Text, ltproductSKUcost.Text, lblproductrate.Text)
                        count = count + 1
                    End If
                Next
                'Session("OrderProduct") = dt
                'If Session("OrderProduct") IsNot Nothing Then
                '    dt = DirectCast(Session("OrderProduct"), DataTable)
                ViewState("OrderProduct") = dt
                If ViewState("OrderProduct") IsNot Nothing Then
                    dt = DirectCast(ViewState("OrderProduct"), DataTable)
                    If dt.Rows.Count > 0 Then
                        grditemproduct.DataSource = dt
                        grditemproduct.DataBind()
                        Dim lttotalamount As Label = DirectCast(grditemproduct.FooterRow.FindControl("lttotalamount"), Label)

                        Dim lttotalvat As Label = DirectCast(grditemproduct.FooterRow.FindControl("lttotalvat"), Label)
                        Dim lblfreight As Label = DirectCast(grditemproduct.FooterRow.FindControl("lblfreight"), Label)
                        'If String.IsNullOrEmpty(lblfreight.Text) Then
                        '    If Not String.IsNullOrEmpty(txtFreight.Text) Then
                        '        lblfreight.Text = txtFreight.Text
                        '    Else
                        '        lblfreight.Text = "0"
                        '    End If
                        'End If
                        fixfreight()
                        lblfreight.Text = (CDbl(txtFreight.Text) + CDbl(txtdocnclr.Text) + CDbl(txtocfrei.Text) + CDbl(txtinsurance.Text)).ToString("N2")

                        For i As Integer = 0 To grditemproduct.Rows.Count - 1
                            Dim ltamount As Label = DirectCast(grditemproduct.Rows(i).FindControl("ltamount"), Label)
                            Dim lblvatinrs As Label = DirectCast(grditemproduct.Rows(i).FindControl("lblvatinrs"), Label)
                            If ddCurrency.SelectedValue = "USD" Then
                                VatAmount = 0
                            Else
                                ' ''VatAmount = VatAmount + Math.Round(Convert.ToDouble(lblvatinrs.Text))'***MUBYN
                                VatAmount = VatAmount + (Convert.ToDouble(lblvatinrs.Text))
                            End If
                            FooterTotalAmount = FooterTotalAmount + Math.Round(Convert.ToDouble(ltamount.Text))
                        Next
                        Dim divfootvat As HtmlGenericControl = TryCast(grditemproduct.FooterRow.FindControl("divfootvat"), HtmlGenericControl)
                        Dim divfootvatamt As HtmlGenericControl = TryCast(grditemproduct.FooterRow.FindControl("divfootvatamt"), HtmlGenericControl)
                        If ddCurrency.SelectedValue = "USD" Then
                            VatAmount = 0
                            lttotalvat.Text = "0"
                            divfootvat.Visible = False
                            divfootvatamt.Visible = False
                        Else
                            divfootvat.Visible = True
                            divfootvatamt.Visible = True
                        End If
                        lttotalamount.Text = Math.Round(FooterTotalAmount + VatAmount + Convert.ToDouble(lblfreight.Text)).ToString("N2")
                        lttotalvat.Text = Math.Round(VatAmount).ToString("N2")
                        'mpe.Hide()
                        If flag = "Save" Then
                            fillUser()
                        Else

                            mpe.Hide()
                        End If
                    End If
                End If
            Else
                'Dim dt As DataTable = DirectCast(Session("OrderProduct"), DataTable)
                Dim dt As DataTable = DirectCast(ViewState("OrderProduct"), DataTable)
                count = dt.Rows.Count
                For Each row As GridViewRow In GridView1.Rows
                    Dim lblproductId = DirectCast(row.FindControl("lblproductId"), Label)
                    Dim lblname = DirectCast(row.FindControl("lblname"), Label)
                    Dim lblcode = DirectCast(row.FindControl("ltproductcode"), Label)
                    Dim lblunit = DirectCast(row.FindControl("lblunit"), Label)
                    Dim ltpacking = DirectCast(row.FindControl("ltpacking"), Label)
                    Dim lblvat = DirectCast(row.FindControl("lblvat"), Label)
                    Dim lblrate = DirectCast(row.FindControl("lblrate"), Label)
                    '  Dim ckselect = DirectCast(row.FindControl("ckselect"), CheckBox)
                    Dim lbldiscount = DirectCast(row.FindControl("lbldiscount"), Label)
                    Dim ltdisounted = DirectCast(row.FindControl("ltdisounted"), Label)
                    Dim ltproductmargin = DirectCast(row.FindControl("ltproductmargin"), Label)
                    Dim ltproductcost = DirectCast(row.FindControl("ltproductcost"), Label)
                    Dim ltproductSKUcost = DirectCast(row.FindControl("ltproductSKUcost"), Label)
                    Dim lblproductrate = DirectCast(row.FindControl("lblproductrate"), Label)
                    Dim txtOrderQty = DirectCast(row.FindControl("txtOrderQty"), TextBox)

                    '      If ckselect.Checked = True Then
                    If txtOrderQty.Text <> "" And txtOrderQty.Text <> "0" Then

                        If lbldiscount.Text = "" Then
                        Else
                            countrate = (Convert.ToDouble(lbldiscount.Text) / 100)
                            countrate1 = (Convert.ToDouble(lblrate.Text)) * countrate
                            lblrate.Text = Math.Round(Math.Round(Convert.ToDouble(lblrate.Text)) - countrate1)
                        End If
                        TotalAmount = Math.Round(Convert.ToDouble(lblrate.Text)) * Math.Round(Convert.ToDouble(lblunit.Text)) * 1
                        Dim VAT As Double = Math.Round(Convert.ToDouble((lblvat.Text * TotalAmount) / 100))
                        TotalAmount = TotalAmount + VAT
                        dt.Rows.Add(count, lblproductId.Text, lblname.Text, lblcode.Text, ltpacking.Text, lblunit.Text, lblrate.Text, txtOrderQty.Text,
                                    lblvat.Text, TotalAmount, ltdisounted.Text, ltproductmargin.Text, ltproductcost.Text, ltproductSKUcost.Text, lblproductrate.Text)
                        count = count + 1
                    End If
                Next
                'Session("OrderProduct") = dt
                'If Session("OrderProduct") IsNot Nothing Then
                '    dt = DirectCast(Session("OrderProduct"), DataTable)
                ViewState("OrderProduct") = dt
                If ViewState("OrderProduct") IsNot Nothing Then
                    dt = DirectCast(ViewState("OrderProduct"), DataTable)
                    If dt.Rows.Count > 0 Then
                        grditemproduct.DataSource = dt
                        grditemproduct.DataBind()
                        Dim lttotalamount As Label = DirectCast(grditemproduct.FooterRow.FindControl("lttotalamount"), Label)
                        Dim lttotalvat As Label = DirectCast(grditemproduct.FooterRow.FindControl("lttotalvat"), Label)
                        Dim lblfreight As Label = DirectCast(grditemproduct.FooterRow.FindControl("lblfreight"), Label)
                        'If String.IsNullOrEmpty(lblfreight.Text) Then
                        '    If Not String.IsNullOrEmpty(txtFreight.Text) Then
                        '        lblfreight.Text = txtFreight.Text
                        '    Else
                        '        lblfreight.Text = "0"
                        '    End If
                        'End If
                        fixfreight()
                        lblfreight.Text = (CDbl(txtFreight.Text) + CDbl(txtdocnclr.Text) + CDbl(txtocfrei.Text) + CDbl(txtinsurance.Text)).ToString("N2")

                        For i As Integer = 0 To grditemproduct.Rows.Count - 1
                            Dim ltamount As Label = DirectCast(grditemproduct.Rows(i).FindControl("ltamount"), Label)
                            Dim lblvatinrs As Label = DirectCast(grditemproduct.Rows(i).FindControl("lblvatinrs"), Label)
                            If ddCurrency.SelectedValue = "USD" Then
                                VatAmount = 0
                            Else
                                ' ''VatAmount = VatAmount + Math.Round(Convert.ToDouble(lblvatinrs.Text))'***MUBYN
                                VatAmount = VatAmount + (Convert.ToDouble(lblvatinrs.Text))
                            End If
                            FooterTotalAmount = FooterTotalAmount + Math.Round(Convert.ToDouble(ltamount.Text))
                        Next
                        Dim divfootvat As HtmlGenericControl = TryCast(grditemproduct.FooterRow.FindControl("divfootvat"), HtmlGenericControl)
                        Dim divfootvatamt As HtmlGenericControl = TryCast(grditemproduct.FooterRow.FindControl("divfootvatamt"), HtmlGenericControl)
                        If ddCurrency.SelectedValue = "USD" Then
                            VatAmount = 0
                            lttotalvat.Text = "0"
                            divfootvat.Visible = False
                            divfootvatamt.Visible = False
                        Else
