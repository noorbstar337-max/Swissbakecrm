    Public Sub fillproductdiscount()
        Try
            MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
            btnadd.Visible = True
            grddiscount.PageIndex = 0
            grddiscount.PageSize = 10
            grddiscount.DataSource = QuotationBLL.Quotationdiscount("Quotationdiscount", ddrelatedtypeid.SelectedValue, MainID) 'MainBLL.FillGridViewDiscountbyid("DiscountGridviewbyid", ddlcustid.SelectedValue, ddProduct.SelectedValue)
            grddiscount.DataBind()
