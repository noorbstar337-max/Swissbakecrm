    Private Sub SaveProduct(ByVal enumOperation As DML_OPERATION)
        If txtCurrencyRate.Text = "" Then
            txtCurrencyRate.Text = 1
        End If

        Select Case enumOperation

            Case DML_OPERATION.UPDATE
                MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
                Try
                    If txtamount.Text = "" Then
                        txtamount.Text = 0
                    End If
                    If txtFreight.Text = "" Then
                        txtFreight.Text = "0.00"
                    End If
                    If String.IsNullOrEmpty(txtclosing.Text) Then
                        txtclosing.Text = Date.Now.Date.ToString("yyyy-MM-dd")
                    End If
                    If ddQuotationType.SelectedValue = "Domestic" Then
                        QuotationBLL.Update(ddrelatedtype.SelectedValue, ddrelatedtypeid.SelectedValue, ddstatus.SelectedValue, txtQuotationdate.Text.Trim,
                        txtvalidity.Text.Trim, txtpayment.Text.Trim, txtdomdelterms.Text.Trim, txtdispath.Text.Trim, txtsign.Text.Trim, txtclosing.Text.Trim,
                        ddowner.SelectedValue, txtamount.Text, Session("UserId"), Session("Audlog_Id"), MainID, txtFreight.Text, ddCurrency.SelectedValue, Convert.ToDouble(txtCurrencyRate.Text),
                        ddPaymentTerms.SelectedValue, ddModeOfTransport.SelectedValue, ddlcountrybillCOO.SelectedValue, ddlcountrybill.SelectedValue, txtPortLoading.Text, txtPortDischarge.Text,
                        ddlstatebill.SelectedValue, txtmopsub.Text.Trim, txtdocnclr.Text, txtocfrei.Text, txtinsurance.Text, chkqif.Checked, "INR", ddlBank.SelectedItem.Value, 0)

                        Dim FreightTax As Double = ConfigurationManager.AppSettings("freightvalue")
                        QuotationBLL.UpdateQuotationFreight(FreightTax, MainID)
                        ' ' update frrigt tax here 
                    Else
                        QuotationBLL.Update(ddrelatedtype.SelectedValue, ddrelatedtypeid.SelectedValue, ddstatus.SelectedValue, txtQuotationdate.Text.Trim,
                        txtvalidity.Text.Trim, txtpayment.Text.Trim, dddelivery.SelectedValue, txtdispath.Text.Trim, txtsign.Text.Trim, txtclosing.Text.Trim,
                        ddowner.SelectedValue, txtamount.Text, Session("UserId"), Session("Audlog_Id"), MainID, txtFreight.Text, ddCurrency.SelectedValue, Convert.ToDouble(txtCurrencyRate.Text),
                        ddPaymentTerms.SelectedValue, ddModeOfTransport.SelectedValue, ddlcountrybillCOO.SelectedValue, ddlcountrybill.SelectedValue, txtPortLoading.Text, txtPortDischarge.Text,
                        ddlstatebill.SelectedValue, txtmopsub.Text.Trim, txtdocnclr.Text, txtocfrei.Text, txtinsurance.Text, chkqif.Checked, ddlPrint.SelectedValue, ddlBank.SelectedItem.Value, 0)
                    End If

                    assigncontrol.AddAssignTo(MainID)

                    If Request.QueryString("returnurl") = "y" Then
                        Response.Redirect("ViewQuotation.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(MainID.ToString())) & "&Qtyp=" + HttpUtility.UrlEncode(Security.Encrypt((ddCurrency.SelectedValue).ToString())))
                    Else
                        Response.Redirect("Quotation.aspx")
                    End If
                    'returnurl = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("returnurl")))
                    'ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "window.location='" + returnurl + "';", True)
                    'Response.Redirect("Quotation.aspx")
                Catch ex As Exception
                    Dim error1 As String = ex.Message.Replace(Chr(34), "")
                    error1 = error1.Replace(Chr(39), "")
                    ExecptionBLL.Insert("ModifyQuotation", "UPDATE", error1, Session("UserId"))
                    ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
                End Try
            Case DML_OPERATION.INSERT
                Try
                    If MainID = "0" Then

                        If txtamount.Text = "" Then
                            txtamount.Text = 0
                        End If
                        If txtFreight.Text = "" Then
                            txtFreight.Text = "0.00"
                        End If

                        If String.IsNullOrEmpty(txtclosing.Text) Then
                            txtclosing.Text = Date.Now.Date.ToString("yyyy-MM-dd")
                        End If
                        If ddQuotationType.SelectedValue = "Domestic" Then
                            MainID = QuotationBLL.Insert(ddrelatedtype.SelectedValue, ddrelatedtypeid.SelectedValue, ddstatus.SelectedValue, txtQuotationdate.Text.Trim,
                             txtvalidity.Text.Trim, txtpayment.Text.Trim, txtdomdelterms.Text.Trim, txtdispath.Text.Trim, txtsign.Text.Trim, txtclosing.Text.Trim,
                             ddowner.SelectedValue, txtamount.Text, Session("UserId"), Session("Audlog_Id"), txtFreight.Text, ddCurrency.SelectedValue, Convert.ToDouble(txtCurrencyRate.Text),
                            ddPaymentTerms.SelectedValue, ddModeOfTransport.SelectedValue, ddlcountrybillCOO.SelectedValue, ddlcountrybill.SelectedValue, txtPortLoading.Text, txtPortDischarge.Text,
                            ddlstatebill.SelectedValue, txtmopsub.Text.Trim, txtdocnclr.Text, txtocfrei.Text, txtinsurance.Text, chkqif.Checked, "INR", ddlBank.SelectedItem.Value, 0)

                            Dim FreightTax As Double = ConfigurationManager.AppSettings("freightvalue")
                            'Dim freightamt As Double = Math.Round(Convert.ToDouble(txtFreight.Text) * CDbl(FreightTax) / 100).ToString("N2")
                            QuotationBLL.UpdateQuotationFreight(FreightTax, MainID)
                            ' ' update frrigt tax here 
                        Else
                            MainID = QuotationBLL.Insert(ddrelatedtype.SelectedValue, ddrelatedtypeid.SelectedValue, ddstatus.SelectedValue, txtQuotationdate.Text.Trim,
                             txtvalidity.Text.Trim, txtpayment.Text.Trim, dddelivery.SelectedValue, txtdispath.Text.Trim, txtsign.Text.Trim, txtclosing.Text.Trim,
                             ddowner.SelectedValue, txtamount.Text, Session("UserId"), Session("Audlog_Id"), txtFreight.Text, ddCurrency.SelectedValue, Convert.ToDouble(txtCurrencyRate.Text),
                            ddPaymentTerms.SelectedValue, ddModeOfTransport.SelectedValue, ddlcountrybillCOO.SelectedValue, ddlcountrybill.SelectedValue, txtPortLoading.Text, txtPortDischarge.Text,
                            ddlstatebill.SelectedValue, txtmopsub.Text.Trim, txtdocnclr.Text, txtocfrei.Text, txtinsurance.Text, chkqif.Checked, ddlPrint.SelectedValue, ddlBank.SelectedItem.Value, 0)
                        End If

                        assigncontrol.AddAssignTo(MainID)
                        additemtoquotation(MainID)
                        'Dim CheckID As Integer = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
                        ''If CheckID = 0 Then
                        ''    Response.Redirect("ViewQuotation.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(MainID).ToString()))
                        ''Else
                        ''    returnurl = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("returnurl")))
                        ''    ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "window.location='" + returnurl + "';", True)
                        ''End If

                        'If Request.QueryString("returnurl") = "y" Then
                        Response.Redirect("ViewQuotation.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(MainID.ToString())) & "&Qtyp=" + HttpUtility.UrlEncode(Security.Encrypt((ddCurrency.SelectedValue).ToString())))
                        'Else
                        '    Response.Redirect("Quotation.aspx")
                        'End If
                    Else
                        If txtamount.Text = "" Then
                            txtamount.Text = 0
                        End If
                        If txtFreight.Text = "" Then
                            txtFreight.Text = "0.00"
                        End If

                        If String.IsNullOrEmpty(txtclosing.Text) Then
                            txtclosing.Text = Date.Now.Date.ToString("yyyy-MM-dd")
                        End If

                        '===============INSERTING AND CREATING NEW VERSION =========================================
                        Dim QuotationId As Integer
                        If ddQuotationType.SelectedValue = "Domestic" Then
                            QuotationId = QuotationBLL.InsertRevision(
                           ddrelatedtype.SelectedValue, ddrelatedtypeid.SelectedValue, "Negotiation/Review",
                           txtQuotationdate.Text.Trim, txtvalidity.Text.Trim,
                                            txtpayment.Text.Trim,
                                          txtdomdelterms.Text.Trim,
                                           txtdispath.Text.Trim,
                                             txtsign.Text.Trim,
                                           txtclosing.Text.Trim,
                                           ddowner.SelectedValue,
                                          txtamount.Text,
                                           Session("UserId"), Session("Audlog_Id"),
                                           txtFreight.Text,
                                          ddCurrency.SelectedValue,
                                          Convert.ToDouble(txtCurrencyRate.Text),
                                           MainID,
                                          ddPaymentTerms.SelectedValue,
                                           ddModeOfTransport.SelectedValue,
                                          ddlcountrybillCOO.SelectedValue,
                                            ddlcountrybill.SelectedValue,
                                          txtPortLoading.Text,
                                          txtPortDischarge.Text, ddlstatebill.SelectedValue, txtmopsub.Text.Trim, txtdocnclr.Text, txtocfrei.Text, txtinsurance.Text, chkqif.Checked, "INR")

                            Dim FreightTax As Double = ConfigurationManager.AppSettings("freightvalue")
                            'Dim freightamt As Double = Math.Round(Convert.ToDouble(txtFreight.Text) * CDbl(FreightTax) / 100).ToString("N2")
                            QuotationBLL.UpdateQuotationFreight(FreightTax, QuotationId)
                            ' ' update frrigt tax here 
                        Else
                            QuotationId = QuotationBLL.InsertRevision(
                           ddrelatedtype.SelectedValue, ddrelatedtypeid.SelectedValue, "Negotiation/Review",
                           txtQuotationdate.Text.Trim, txtvalidity.Text.Trim,
                                            txtpayment.Text.Trim,
                                          dddelivery.SelectedValue,
                                           txtdispath.Text.Trim,
                                             txtsign.Text.Trim,
                                           txtclosing.Text.Trim,
                                           ddowner.SelectedValue,
                                          txtamount.Text,
                                           Session("UserId"), Session("Audlog_Id"),
                                           txtFreight.Text,
                                          ddCurrency.SelectedValue,
                                          Convert.ToDouble(txtCurrencyRate.Text),
                                           MainID,
                                          ddPaymentTerms.SelectedValue,
                                           ddModeOfTransport.SelectedValue,
                                          ddlcountrybillCOO.SelectedValue,
                                            ddlcountrybill.SelectedValue,
                                          txtPortLoading.Text,
                                          txtPortDischarge.Text, ddlstatebill.SelectedValue, txtmopsub.Text.Trim, txtdocnclr.Text, txtocfrei.Text, txtinsurance.Text, chkqif.Checked, ddlPrint.SelectedValue)
                        End If

                        assigncontrol.AddAssignTo(QuotationId)
                        additemtoquotation(QuotationId)
                        Response.Redirect("ViewQuotation.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(QuotationId.ToString())) & "&Qtyp=" + HttpUtility.UrlEncode(Security.Encrypt((ddCurrency.SelectedValue).ToString())))
                    End If
                Catch ex As Exception
                    Dim error1 As String = ex.Message.Replace(Chr(34), "")
                    error1 = error1.Replace(Chr(39), "")
                    ExecptionBLL.Insert("ModifyQuotation", "INSERT", error1, Session("UserId"))
                    ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
                End Try
        End Select
    End Sub

    Protected Sub btnadd_Click(sender As Object, e As EventArgs) Handles btnadd.Click
        Try
            'If Request.QueryString("Id") <> Nothing And Request.QueryString("type") <> Nothing Then
            '    SaveProduct(DML_OPERATION.INSERT)
            'Else


            'End If
            'MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
            MainID = hfMainID.Value
            If ddQuotationType.SelectedValue = "Domestic" Then
                If txtFreight.Text = "0" Or txtFreight.Text = "" Then
                    txtFreight.Text = "0.00"
                End If
            Else
                If dddelivery.SelectedValue = "EXW" Then
                    txtFreight.Text = "0.00"
                    txtdocnclr.Text = "0.00"
                    txtocfrei.Text = "0.00"
                    txtinsurance.Text = "0.00"
                ElseIf dddelivery.SelectedValue = "FOB" Then
                    txtocfrei.Text = "0.00"
                    txtinsurance.Text = "0.00"
                ElseIf dddelivery.SelectedValue = "CNF" Then
                    txtinsurance.Text = "0.00"
                ElseIf dddelivery.SelectedValue = "CIF" Then

                End If
            End If

            If ViewState("OrderProduct") IsNot Nothing Then

                If MainID = 0 Then
                    SaveProduct(DML_OPERATION.INSERT)
                ElseIf MainID > 0 Then
                    tablecheck.Value = AreTablesTheSame()

                    If hffreight.Value = CDbl(txtFreight.Text) And hfcurrencyrate.Value = txtCurrencyRate.Text And tablecheck.Value = True And
                        txtdocnclr.Text = hfdocclear.Value And txtinsurance.Text = hfinsurance.Value And
                    txtocfrei.Text = hfocfreight.Value And
                    chkqif.Checked = hfchkqif.Value Then
                        SaveProduct(DML_OPERATION.UPDATE)
                    Else
                        MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
                        Dim index As Integer = MainID

                        Dim check As String = QuotationBLL.CheckQtnbeforedit(index)
                        If check = "Already Exist" Then

                            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('Your trying to open Quotation through a invalid link, you will be redirected.');window.location='quotation.aspx'", True)
                        Else
                            SaveProduct(DML_OPERATION.INSERT)
                        End If
                    End If
                End If
            Else
                If ddrelatedtypeid.SelectedValue = "" Then
                    ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + ("Please select a account before adding item").ToString + "')", True)
                Else
                    ScriptManager.RegisterClientScriptBlock(Page, Me.GetType(), "Call", "alert('Please select product before saving')", True)
                    'fillUser()
                    GridView1.DataSource = ViewState("Fillproduct")
                    GridView1.DataBind()
                    mpe.Show()
                End If
            End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("ModifyQuotation", "btnadd_Click", error1, Session("UserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub

    Protected Sub ddrelatedtype_TextChanged(sender As Object, e As EventArgs) Handles ddrelatedtype.TextChanged
        Try
            lbltypeid.Text = ddrelatedtype.SelectedValue
            If (ddrelatedtype.SelectedValue = "Prospect") Then
                Dim ds As DataSet
                MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
                If MainID = 0 Then
                    'ds = MainBLL.DropdownWithtypeAndID1("AccountDropDowndomestic", "Prospect", Session("UserId"), ddQuotationType.SelectedValue)
                    ds = MainBLL.NewDropdownWithtypeAndID("AccountDropDowndomestic", "Prospect", Session("UserId"), ddQuotationType.SelectedValue)
                Else
                    ds = MainBLL.DropdownWithtype("EditAccountDropDown", "Prospect")
                End If
                ddrelatedtypeid.DataSource = ds
                ddrelatedtypeid.DataTextField = "Acc_Name"
                ddrelatedtypeid.DataValueField = "Acc_Id"
                ddrelatedtypeid.DataBind()
                If ddrelatedtypeid.Items.Count >= 1 Then
                Else
                    ddrelatedtype.SelectedValue = "None"
                    ddrelatedtypeid.DataSource = ""
                    ddrelatedtypeid.DataBind()
                    ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + ("No prospect found").ToString + "')", True)
                End If
                CheckType()
            ElseIf (ddrelatedtype.SelectedValue = "Account") Then
                Dim ds As DataSet
                MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
                If MainID = 0 Then
                    'ds = MainBLL.DropdownWithtypeAndID1("AccountDropDowndomestic", "Account", Session("UserId"), ddQuotationType.SelectedValue)
                    ds = MainBLL.NewDropdownWithtypeAndID("AccountDropDowndomestic", "Account", Session("UserId"), ddQuotationType.SelectedValue)
                Else
                    ds = MainBLL.DropdownWithtype("EditAccountDropDown", "Account")
                End If
                ddrelatedtypeid.DataSource = ds
                ddrelatedtypeid.DataTextField = "Acc_Name"
                ddrelatedtypeid.DataValueField = "Acc_Id"
                ddrelatedtypeid.DataBind()
                If ddrelatedtypeid.Items.Count >= 1 Then
                Else
                    ddrelatedtype.SelectedValue = "None"
                    ddrelatedtypeid.DataSource = ""
                    ddrelatedtypeid.DataBind()
                    ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + ("No account found").ToString + "')", True)
                End If
                CheckType()
            ElseIf (ddrelatedtype.SelectedValue = "None") Then
                ddrelatedtypeid.DataSource = ""
                ddrelatedtypeid.DataBind()
            End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("ModifyQuotation", "ddrelatedtype_TextChanged", error1, Session("UserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub

    Public Sub FillOwner()
        Try
            ddowner.DataSource = MainBLL.Dropdown("UserDropDown")
            ddowner.DataTextField = "U_FirstName"
            ddowner.DataValueField = "U_ID"
            ddowner.DataBind()
            ddowner.SelectedValue = Session("UserId")
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("ModifyQuotation", "FillOwner", error1, Session("UserId"))
            'ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
            Throw ex
        End Try
    End Sub

    Public Sub FillDetail()
        Try
            MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
            Dim dt As DataSet = MainBLL.ViewByID(MainID, "QuotationViewByID")
            Dim dtUser As New DataTable
            dtUser = dt.Tables(0)
            Dim drLogin As DataRow
            drLogin = dtUser.Rows(0)

            ddrelatedtype.SelectedValue = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_Type").ToString())
            'gayatri added this code from PackOne on 18-08-2017 to check type of quotation account/prospect
            If ddrelatedtype.SelectedValue = "Prospect" Then
                Dim checkcname As String = QuotationBLL.Checktypebyid(DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_TypeID").ToString()))
                If (checkcname = "Already Exist") Then

                    ddrelatedtype.SelectedValue = "Account"

                End If
            End If
            lblQNo.Text = "(" + DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_No").ToString()) + ")"
            ddrelatedtype_TextChanged(Nothing, Nothing)
            ddrelatedtypeid.SelectedValue = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_TypeID").ToString())
            '''''''''''''''''''''''''''''''''''''''''''''''added By Sufiyan
            Dim dt1 As DataSet = AccountBLL.SelectCategoryByAccId(ddrelatedtypeid.SelectedValue)
            Dim dtUser1 As New DataTable
            dtUser1 = dt1.Tables(0)
            Dim drLogin1 As DataRow
            drLogin1 = dtUser1.Rows(0)
            If drLogin1("Acc_Category").ToString() = "Domestic" Then
                divDomestic.Visible = False
                ddQuotationType.SelectedValue = "Domestic"
                ' CheckType()
            Else
                divDomestic.Visible = True
                ddQuotationType.SelectedValue = "Export"
                ' CheckType()

            End If
            '''''''''''''''''''''''''
            ddstatus.SelectedValue = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_QuoStatus").ToString())
            txtQuotationdate.Text = DynamicparcelDataManipulation.DateFormat(drLogin("Quotation_Date").ToString())
            txtvalidity.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_Validity").ToString())
            txtpayment.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_ModeOFPayment").ToString())
            If ddQuotationType.SelectedValue = "Domestic" Then
                txtdomdelterms.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_TermOFDelivery").ToString())
                dddelivery.Visible = False
                ddlPrint.SelectedValue = "INR"
            Else
                dddelivery.SelectedValue = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_TermOFDelivery").ToString())
                dddelivery_TextChanged(Nothing, Nothing)
                txtdomdelterms.Visible = False
                ddlPrint.SelectedValue = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_PrintIn").ToString())
            End If

            txtdispath.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_DispatchThrough").ToString())
            txtsign.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_AuthSign").ToString())
            txtclosing.Text = DynamicparcelDataManipulation.DateFormat(drLogin("Quotation_ExpClosing").ToString())
            txtamount.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_PrdAmount").ToString())
            txtFreight.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_Freight").ToString())
            hffreight.Value = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_Freight").ToString())

            hfFreightTaxPer.Value = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_FreightTaxPer").ToString()) 'Added by MUBYN
            If hfFreightTaxPer.Value = "" Then
                hfFreightTaxPer.Value = ConfigurationManager.AppSettings("freightvalue")
            End If
            ddowner.SelectedValue = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_OwnerID").ToString())
            lblmodifieddate.Text = DynamicparcelDataManipulation.AlphaDateFormat(drLogin("Quotation_ModifiedDate").ToString())
            lblmodifiedname.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("U_FirstName").ToString())
            ddCurrency.SelectedValue = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_Currency").ToString())
            hfcurrencyrate.Value = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_CurrencyRate").ToString())
            txtCurrencyRate.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_CurrencyRate").ToString())
            If drLogin("Quotation_Currency").ToString() = "USD" Then
                '  txtCurrencyRate.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_CurrencyRate").ToString())
                divCurrencyRate.Visible = True
            End If
            If drLogin("Quotation_TermsOfPayment").ToString() <> "" Then
                ddPaymentTerms.SelectedValue = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_TermsOfPayment").ToString())
            End If

            If drLogin("Quotation_ModeOfTransport").ToString() <> "" Then
                ddModeOfTransport.SelectedValue = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_ModeOfTransport").ToString())
            End If
            If drLogin("Quotation_CountryOfOrigin").ToString() <> "" Then
                ddlcountrybillCOO.SelectedValue = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_CountryOfOrigin").ToString())
            End If
            If drLogin("Quotation_CountryOfFinalDestination").ToString() <> "" Then
                Dim test As String = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_CountryOfOrigin").ToString())

                ddlcountrybill.SelectedValue = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_CountryOfFinalDestination").ToString())
                ddlcountrybill_SelectedIndexChanged(Nothing, Nothing)
            End If
            If drLogin("Quotation_PortOfLoading").ToString() <> "" Then
                txtPortLoading.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_PortOfLoading").ToString())
            End If
            If drLogin("Quotation_PortOfDischarge").ToString() <> "" Then
                txtPortDischarge.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_PortOfDischarge").ToString())
            End If
            If drLogin("Quotation_FinalDestination").ToString() <> "" Then
                ddlstatebill.SelectedValue = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_FinalDestination").ToString())
            End If
            txtmopsub.Visible = True
            If drLogin("Quotation_TrmsPyt_Card_doc").ToString() <> "" Then
                txtmopsub.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_TrmsPyt_Card_doc").ToString())
            End If

            ddPaymentTerms_SelectedIndexChanged(ddPaymentTerms.SelectedValue, New EventArgs())


            txtdocnclr.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_Doc_Clearance").ToString())
            txtinsurance.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_Insurance").ToString())
            txtocfrei.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_OceanFreight").ToString())
            chkqif.Checked = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_WithFreight").ToString())

            hfchkqif.Value = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_WithFreight").ToString())
            hfdocclear.Value = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_Doc_Clearance").ToString())
            hfinsurance.Value = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_Insurance").ToString())
            hfocfreight.Value = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_OceanFreight").ToString())
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("ModifyQuotation", "FillDetail", error1, Session("UserId"))
            'ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
            Throw ex
        End Try
    End Sub

    Protected Sub hfcancel_Click(sender As Object, e As EventArgs) Handles hfcancel.Click
        Try
            MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
            If Request.QueryString("returnurl") = "y" Then
                Response.Redirect("ViewQuotation.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(MainID.ToString())) & "&Qtyp=" + HttpUtility.UrlEncode(Security.Encrypt((ddCurrency.SelectedValue).ToString())))
            Else
                Response.Redirect("Quotation.aspx")
            End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
