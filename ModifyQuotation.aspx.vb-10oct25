    Protected Sub Page_Load(sender As Object, e As EventArgs) Handles Me.Load
        If Not IsPostBack Then
            Try
                MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
                hfMainID.Value = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
                CheckPrivi()
                If Request.QueryString("Id") <> Nothing And Request.QueryString("type") <> Nothing Then
                    assigncontrol.Uhftype.Value = "Quotation"
                    assigncontrol.Uhftypeid.Value = 0
                    FillOwner()
                    hfMainID.Value = 0
                    txtQuotationdate.Text = Date.Now.ToString("yyyy-MM-dd")
                    Typeid = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
                    Type = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("type")))
                    ddrelatedtype.SelectedValue = Type
                    ddrelatedtype_TextChanged(Nothing, Nothing)
                    ddrelatedtypeid.SelectedValue = Typeid
                    Convertcurrency()
                    FillBanks()
                Else
                    MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
                    assigncontrol.Uhftype.Value = "Quotation"
                    assigncontrol.Uhftypeid.Value = MainID
                    FillOwner()
                    If MainID = "0" Then
                        'Session("OrderProduct") = Nothing
                        ViewState("OrderProduct") = Nothing


                        lbltitle1.Text = "New Quotation"
                        lbltitle2.Text = "New Quotation"
                        'txtCurrencyRate.Text = "65"
                        divdate.Visible = False
                        modifyspan.Visible = False
                        divadditem.Visible = True
                        'itemdtcontrol.Visible = False
                        txtQuotationdate.Text = Date.Now.ToString("yyyy-MM-dd")
                        ddrelatedtype.SelectedValue = "Prospect"
                        ddrelatedtype_TextChanged(Nothing, Nothing)
                        FillCountry()
                        '  FillStatebill()
                        FillCountryCOO()
                        CheckType()
                        fillUser()
                        Convertcurrency()
                        FillBanks()
                    Else
                        'Session("OrderProduct") = Nothing
                        Dim check As String = QuotationBLL.CheckQtnbeforedit(MainID)
                        If check = "Already Exist" Then
                            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('Your trying to open Quotation through a invalid link, you will be redirected.');window.location='quotation.aspx'", True)
                        Else
                            ViewState("OrderProduct") = Nothing
                            ViewState("OrderProduct1") = Nothing
                            lbltitle1.Text = "Modify Quotation"
                            lbltitle2.Text = "Modify Quotation"
                            FillCountry()
                            ' FillStatebill()
                            FillCountryCOO()
                            FillDetail()
                            '  CheckType()
                            fillUser()
                            Convertcurrency()
                            FillBanks()
                            '  divadditem.Visible = False
                            ' itemdtcontrol.Visible = True

                            '  itemdtcontrol.Uhftype.Value = ddrelatedtype.SelectedValue
                            '  itemdtcontrol.Uhftypeid.Value = ddrelatedtypeid.SelectedValue
                            '  itemdtcontrol.Uhfopptype.Value = "Quotation"
                            '  itemdtcontrol.Uhfopptypeid.Value = MainID
                            fillproductonedit()
                            ddrelatedtype.Enabled = False
                            ddrelatedtypeid.Enabled = False
                            ddQuotationType.Enabled = False
                            ddrelatedtypeid.CssClass = "form-control"
                            '================================================
                            Dim dt As DataSet = AccountBLL.SelectCategoryByAccId(ddrelatedtypeid.SelectedValue)
                            Dim dtUser As New DataTable
                            dtUser = dt.Tables(0)
                            Dim drLogin As DataRow
                            drLogin = dtUser.Rows(0)
                            If drLogin("Acc_Category").ToString() = "Domestic" Then
                                divDomestic.Visible = False
                                ddQuotationType.SelectedValue = "Domestic"
                                CheckType()
                            Else
                                divDomestic.Visible = True
                                ddQuotationType.SelectedValue = "Export"
                                CheckType()
                                dddelivery_TextChanged(Nothing, Nothing)
                            End If
                            '=======================================================
                        End If

                    End If
                End If
                Me.txtsearch.Attributes.Add("onkeyup", String.Format("javascript:__doPostBack('{0}','')", Me.UpdatePanel1.ClientID))
                If Not Request.QueryString("pu") = Nothing Then

                    ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + ("Quotation was successfully updated").ToString + "')", True)
                End If
                If Not Request.QueryString("tp") = Nothing Then
                    Dim tp As String = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("tp")))
                    If tp = "Export" Then
                        ddQuotationType.SelectedValue = "Export"
                        ddQuotationType_SelectedIndexChanged(Nothing, Nothing)
                    End If
                End If
                '  MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))

                'If MainID = 0 Then
                'Else
                'End If
                'FillCountry()
                'FillStatebill()
                'FillCountryCOO()
            Catch ex As Exception
                'Response.Redirect("index.aspx")
                Dim error1 As String = ex.Message.Replace(Chr(34), "")
                error1 = error1.Replace(Chr(39), "")
                ExecptionBLL.Insert("ModifyQuotation", "Page_Load", error1, Session("UserId"))
                ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
            End Try
        Else
            Dim target As String = Me.Request.Form("__EVENTTARGET")
            If Not String.IsNullOrEmpty(target) AndAlso target.Equals(Me.UpdatePanel1.ClientID) Then
                If Not String.IsNullOrEmpty(Me.txtsearch.Text) Then
                    'GridView1.AllowCustomPaging = False
                    FillSearch()
                Else
                    'GridView1.AllowCustomPaging = True
                    fillUser()
                End If
            End If

        End If



    End Sub
    Public Sub fillproductonedit()

        GridView1.DataSource = ItemDetailBLL.ViewItemDetail(ddrelatedtypeid.SelectedValue)
        GridView1.DataBind()
        Dim dt As DataTable = ItemDetailBLL.FillItemOnedit("Quotation", MainID, ddrelatedtypeid.SelectedValue).Tables(0)
        ' Session("OrderProduct") = dt
        ViewState("OrderProduct") = dt
        ViewState("OrderProduct1") = dt
        ' Session("OrderProductN") = Session("OrderProduct")
        grditemproduct.DataSource = dt
        grditemproduct.DataBind()

        If grditemproduct.Rows.Count > 0 Then


            Dim lttotalamount As Label = DirectCast(grditemproduct.FooterRow.FindControl("lttotalamount"), Label)


            Dim lttotalvat As Label = DirectCast(grditemproduct.FooterRow.FindControl("lttotalvat"), Label)
            Dim lblfreight As Label = DirectCast(grditemproduct.FooterRow.FindControl("lblfreight"), Label)
            'lblfreight.Text = txtFreight.Text
            fixfreight()
            lblfreight.Text = (CDbl(txtFreight.Text) + CDbl(txtdocnclr.Text) + CDbl(txtocfrei.Text) + CDbl(txtinsurance.Text)).ToString("N2")

            For i As Integer = 0 To grditemproduct.Rows.Count - 1
                Dim ltamount As Label = DirectCast(grditemproduct.Rows(i).FindControl("ltamount"), Label)
                Dim lblvatinrs As Label = DirectCast(grditemproduct.Rows(i).FindControl("lblvatinrs"), Label)
                If ddCurrency.SelectedValue = "USD" Then
                    VatAmount = 0
                Else
                    ' ''VatAmount = VatAmount + Math.Round(Convert.ToDouble(lblvatinrs.Text))***********MUBYN
                    VatAmount = VatAmount + (Convert.ToDouble(lblvatinrs.Text))
                End If
                FooterTotalAmount = FooterTotalAmount + Math.Round(Convert.ToDouble(ltamount.Text))
            Next
            VatAmount = VatAmount + (hfFreightTaxPer.Value * CDbl(txtFreight.Text) / 100)

            lttotalamount.Text = Math.Round(FooterTotalAmount + VatAmount + Convert.ToDouble(lblfreight.Text)).ToString("N2")
            ' ''lttotalvat.Text = Math.Round(VatAmount).ToString("N2")'***MUBYN
            lttotalvat.Text = (VatAmount).ToString("N2")
            Dim divfootvat As HtmlGenericControl = TryCast(grditemproduct.FooterRow.FindControl("divfootvat"), HtmlGenericControl)
            Dim divfootvatamt As HtmlGenericControl = TryCast(grditemproduct.FooterRow.FindControl("divfootvatamt"), HtmlGenericControl)
            If ddCurrency.SelectedValue = "USD" Then
                VatAmount = 0
                lttotalvat.Text = "0"
                divfootvat.Visible = False
                divfootvatamt.Visible = False
            Else
                divfootvat.Visible = True
                divfootvatamt.Visible = True
            End If
        End If
    End Sub
    Public Sub fillUser()
        Try
            If ViewState("OrderProduct") IsNot Nothing Then
                Dim dt As DataTable = DirectCast(ViewState("OrderProduct"), DataTable)
                If dt.Rows.Count > 0 Then
                    For Each row As DataRow In dt.Rows
                        Dim a As String = ""
                        strvat.Add(row("ProductId").ToString)

                    Next
                End If
            End If
            'Dim dt As DataTable = ItemDetailBLL.ViewItemDetail("Quotation", 0, ddrelatedtypeid.SelectedValue).Tables(0)
            'ViewState("Fillproduct") = dt

            ViewState("Fillproduct") = ItemDetailBLL.ViewItemDetail(ddrelatedtypeid.SelectedValue).Tables(0)
            GridView1.DataSource = ViewState("Fillproduct")
            GridView1.DataBind()

            For Each value As String In strvat
                For Each row As GridViewRow In GridView1.Rows
                    Dim lblproductId = DirectCast(row.FindControl("lblproductId"), Label)
                    If lblproductId.Text = value Then
                        row.Visible = False
                    End If
                Next
            Next
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("ItemDetailControl", "fillUser", error1, Session("UserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub

    Public Sub FillSearch()
        Try
            If ViewState("OrderProduct") IsNot Nothing Then
                Dim dt As DataTable = DirectCast(ViewState("OrderProduct"), DataTable)
                If dt.Rows.Count > 0 Then
                    For Each row As DataRow In dt.Rows
                        Dim a As String = ""
                        strvat.Add(row("ProductId").ToString)

                    Next
                End If
            End If
            GridView1.DataSource = ItemDetailBLL.Searchquationproduct(ddrelatedtypeid.SelectedValue, txtsearch.Text.Trim)
            GridView1.DataBind()
            For Each value As String In strvat
                For Each row As GridViewRow In GridView1.Rows
                    Dim lblproductId = DirectCast(row.FindControl("lblproductId"), Label)
                    If lblproductId.Text = value Then
                        row.Visible = False
                    End If
                Next
            Next
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("ItemDetailControl", "FillSearch", error1, Session("UserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
    Protected Sub txtdmarginp_TextChanged(sender As Object, e As EventArgs)
        Dim rd As TextBox = DirectCast(sender, TextBox)
        Dim row As GridViewRow = DirectCast(rd.NamingContainer, GridViewRow)
        Dim txtdmarginp As TextBox = TryCast(row.FindControl("txtdmarginp"), TextBox)
        Dim txtquantity As TextBox = TryCast(row.FindControl("txtquantity"), TextBox)
        Dim ltrate As Label = TryCast(row.FindControl("ltrate"), Label)
        ' Dim ltrate As label = TryCast(row.FindControl("ltdisountedrate"), label)
        Dim ltitemid As Label = TryCast(row.FindControl("ltitemid"), Label)
        Dim ltproductWeight As Label = TryCast(row.FindControl("ltproductWeight"), Label)
        Dim ltkg As Label = TryCast(row.FindControl("ltkg"), Label)
        Dim ltamount As Label = TryCast(row.FindControl("ltamount"), Label)
        Dim ltdisamount As Label = TryCast(row.FindControl("ltdisamount"), Label)
        Dim lblvat As Label = TryCast(row.FindControl("lblvat"), Label)
        Dim lblvatinrs As Label = TryCast(row.FindControl("lblvatinrs"), Label)

        Dim lbldiscount = TryCast(row.FindControl("lbldiscount"), Label)
        '  Dim ltdisountedrate = TryCast(row.FindControl("ltdisountedrate"), label)
        Dim ltproductmargin = TryCast(row.FindControl("ltproductmargin"), Label)
        Dim lblprductcost = TryCast(row.FindControl("lblprductcost"), Label)
        Dim lblproductskucost = TryCast(row.FindControl("lblproductskucost"), Label)

        Dim ltdollarrate = TryCast(row.FindControl("ltdollarrate"), Label)
        Dim ltDrateSKU = TryCast(row.FindControl("ltDrateSKU"), Label)
        Dim ltrateSKU = TryCast(row.FindControl("ltrateSKU"), Label)

        If txtdmarginp.Text <> "" Or txtdmarginp.Text <> "0" Then

            Dim sp As Double = 0.0
            sp = (100 / (100 - CDbl(txtdmarginp.Text))) * CDbl(lblprductcost.Text)
            '   sp = CDbl(lblprductcost.Text) * ((CDbl(txtdmarginp.Text) / 100))
            '  sp = sp + CDbl(lblprductcost.Text)
            ltrate.Text = (Math.Round(sp)).ToString("N2")
            'ltrate.Text = sp.ToString("N2")
            ltdollarrate.Text = (CDbl(sp) / CDbl(txtCurrencyRate.Text)).ToString("N2")
            'lblproductskucost.Text = (CDbl(ltrateSKU.Text) / CDbl(txtCurrencyRate.Text)).ToString("N2")
            Dim varible As String = (CDbl(ltdollarrate.Text) * CDbl(ltproductWeight.Text)).ToString("N2")
            lblproductskucost.Text = varible
            ltDrateSKU.Text = varible



            ltkg.Text = ltproductWeight.Text * txtquantity.Text
            ltamount.Text = ltkg.Text * Math.Round(Convert.ToDouble(ltrate.Text))
            ltkg.Text = (CDbl(ltkg.Text)).ToString("N2")
            ltdisamount.Text = Math.Round(Convert.ToDouble(ltamount.Text))
            Dim VAT As Double
            If ddCurrency.SelectedValue = "USD" Then
                VAT = 0.0
            Else

                ' ''VAT = Math.Round(Convert.ToDouble((Math.Round(Convert.ToDouble(lblvat.Text)) * ltamount.Text) / 100))'***MUBYN
                VAT = (Convert.ToDouble((Math.Round(Convert.ToDouble(lblvat.Text)) * ltamount.Text) / 100))
            End If
            lblvatinrs.Text = VAT.ToString("N2")
            ltdisamount.Text = Math.Round(Convert.ToDouble(ltdisamount.Text)).ToString("N2")
            ltamount.Text = (Math.Round(Convert.ToDouble(ltamount.Text))).ToString("N2")
            If grditemproduct.Rows.Count > 0 Then
                Dim lttotalamount As Label = DirectCast(grditemproduct.FooterRow.FindControl("lttotalamount"), Label)
                Dim lttotalvat As Label = DirectCast(grditemproduct.FooterRow.FindControl("lttotalvat"), Label)
                Dim lblfreight As Label = DirectCast(grditemproduct.FooterRow.FindControl("lblfreight"), Label)
                'If String.IsNullOrEmpty(lblfreight.Text) Then
                '    If Not String.IsNullOrEmpty(txtFreight.Text) Then
                '        lblfreight.Text = txtFreight.Text
                '    Else
                '        lblfreight.Text = "0"
                '    End If
                'End If
                fixfreight()
                lblfreight.Text = (CDbl(txtFreight.Text) + CDbl(txtdocnclr.Text) + CDbl(txtocfrei.Text) + CDbl(txtinsurance.Text)).ToString("N2")

                For i As Integer = 0 To grditemproduct.Rows.Count - 1
                    ltamount = DirectCast(grditemproduct.Rows(i).FindControl("ltamount"), Label)
                    lblvatinrs = DirectCast(grditemproduct.Rows(i).FindControl("lblvatinrs"), Label)
                    VatAmount = VatAmount + Math.Round(Convert.ToDouble(lblvatinrs.Text))
                    FooterTotalAmount = FooterTotalAmount + Math.Round(Convert.ToDouble(ltamount.Text))

                Next
                lttotalamount.Text = Math.Round(FooterTotalAmount + VatAmount + Convert.ToDouble(lblfreight.Text)).ToString("N2")
                lttotalvat.Text = Math.Round(VatAmount).ToString("N2")


                Dim divfootvat As HtmlGenericControl = TryCast(grditemproduct.FooterRow.FindControl("divfootvat"), HtmlGenericControl)
                Dim divfootvatamt As HtmlGenericControl = TryCast(grditemproduct.FooterRow.FindControl("divfootvatamt"), HtmlGenericControl)
                If ddCurrency.SelectedValue = "USD" Then
                    VatAmount = 0
                    lttotalvat.Text = "0"
