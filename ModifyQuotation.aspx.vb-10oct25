            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub


    Public Sub additemtoquotation(ByVal QuotationID As Integer)
        Try
            ' If mode = "insert" Then
            Count = MainBLL.GetCode("MaxItemDT")
            Count = Count + 1
            Dim sb As New StringBuilder
            sb.Append("<root>")
            For i As Integer = 0 To grditemproduct.Rows.Count - 1
                Dim txtquantity As TextBox = TryCast(grditemproduct.Rows(i).FindControl("txtquantity"), TextBox)
                Dim txtdmarginp As TextBox = TryCast(grditemproduct.Rows(i).FindControl("txtdmarginp"), TextBox)


                Dim ltrate As Label = TryCast(grditemproduct.Rows(i).FindControl("ltrate"), Label)
                Dim ltProductId As Label = TryCast(grditemproduct.Rows(i).FindControl("ltProductId"), Label)
                Dim ltamount As Label = TryCast(grditemproduct.Rows(i).FindControl("ltamount"), Label)
                Dim lblvatinrs As Label = TryCast(grditemproduct.Rows(i).FindControl("lblvatinrs"), Label)
                Dim ltproductWeight As Label = TryCast(grditemproduct.Rows(i).FindControl("ltproductWeight"), Label)
                Dim lblvat As Label = TryCast(grditemproduct.Rows(i).FindControl("lblvat"), Label)

                '   ltdisamount.Text = ltdisamount.Text.Replace(",", "")
                ltamount.Text = (CDbl(ltproductWeight.Text) * CDbl(txtquantity.Text) * CDbl(ltrate.Text)) 'ltamount.Text.Replace(",", "")

                ' ''lblvatinrs.Text = Math.Round(CDbl(ltamount.Text) * (CDbl(lblvat.Text) / 100))***********MUBYN
                lblvatinrs.Text = (CDbl(ltamount.Text) * (CDbl(lblvat.Text) / 100))

                If ddCurrency.SelectedValue <> "INR" Then
                    lblvatinrs.Text = "0.0"
                End If
                If txtdmarginp.Text = "" Then
                    txtdmarginp.Text = "0"
                End If
                sb.Append("<row ItemDt_ID='" & Count.ToString & "' ItemDt_Type='" & "Quotation" &
                          "' ItemDt_TypeId='" & QuotationID & "' ItemDt_ProductId='" & ltProductId.Text &
                          "' ItemDt_Qty='" & txtquantity.Text & "' ItemDt_Rate='" & ltrate.Text.Replace(",", "") & "' ItemDt_Amount='" & ltamount.Text.Replace(",", "") &
                           "' ItemDt_Vat='" & lblvatinrs.Text.Replace(",", "") & "' ItemDt_DesiredMargin='" & txtdmarginp.Text.Replace(",", "") & "' />")
                Count = Count + 1
            Next
            sb.Append("</root>")
            QuotationBLL.XMLItemDtInsert(sb.ToString)
            'Else

            'End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("ItemDetailControl", "btnsave_Click", error1, Session("UserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
    Public Sub CheckType()
        Try
            ' Dim dt As DataSet = AccountBLL.SelectCategoryByAccId(ddrelatedtypeid.SelectedValue)
            ' Dim dtUser As New DataTable
            '' dtUser = dt.Tables(0)
            ' Dim drLogin As DataRow
            ' drLogin = dtUser.Rows(0)
            qtntype.Value = ddQuotationType.SelectedValue ' drLogin("Acc_Category").ToString() 
            If ddQuotationType.SelectedValue = "Export" Then
                ddCurrency.SelectedValue = "USD"
                divCurrencyRate.Visible = True
                divinclude.Visible = True
                ' divmop.Visible = True
                If Session("UserRoleID") = "1" Then
                    divcalc.Visible = True
                Else
                    divcalc.Visible = False

                End If
            Else
                divcalc.Visible = False
                ddCurrency.SelectedValue = "INR"
                divCurrencyRate.Visible = False
                ' divmop.Visible = False
                divinclude.Visible = False
            End If
            If ddQuotationType.SelectedValue = "Domestic" Then
                divDomestic.Visible = False
                'divmop.Visible = False
                dddelivery.Visible = False
                txtdomdelterms.Visible = True
                divinclude.Visible = False
            Else
                divDomestic.Visible = True
                ' divmop.Visible = True
                dddelivery.Visible = True
                txtdomdelterms.Visible = False
                divinclude.Visible = True
            End If
            If Session("UserRoleID") = "1" Then

                btndiscount.Visible = False
                ' divcalc.Visible = False
            Else

                If MainID = 0 Then
                    btndiscount.Visible = False

                End If
            End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("ModifyQuotation", "CheckType", error1, Session("UserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
