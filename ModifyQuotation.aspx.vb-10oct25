    Protected Sub valueCheck(ByVal source As Object, ByVal e As System.Web.UI.WebControls.ServerValidateEventArgs)
        For Each row As GridViewRow In grddiscount.Rows
            If row.RowType = DataControlRowType.DataRow Then
                Dim cv As CustomValidator = CType(row.FindControl("CustomValidator1"), CustomValidator)
                Dim txtdiscount As TextBox = DirectCast(row.FindControl("txtdiscount"), TextBox)
                Dim ltCost As Literal = DirectCast(row.FindControl("ltCost"), Literal)
                Dim ltMargin As Literal = DirectCast(row.FindControl("ltMargin"), Literal)
                Dim ltRate As Literal = DirectCast(row.FindControl("ltRate"), Literal)
                Dim cost As Double = Convert.ToDouble(ltCost.Text)
                Dim Rate As Double = Convert.ToDouble(ltRate.Text)
                Dim marginPercent As Double = Convert.ToDouble(ltMargin.Text)
                Dim cal, cal1 As Double
                If cost <> 0 Or marginPercent <> 0 Then
                    margin = Convert.ToDouble((cost * marginPercent * 0.01) + cost).ToString("N2")
                    If Convert.ToDouble(Rate - (Convert.ToDouble(txtdiscount.Text) * Rate * 0.01)) < margin Then
                        cal = Convert.ToDouble((100 * margin) / Rate).ToString("N2")
                        cal1 = Convert.ToDouble(100 - cal)
                        cv.ErrorMessage = "Discount must be less than " + cal1.ToString("N2") + " %"
                        'cv.ErrorMessage = "Discount must be less than " + margin.ToString("N2") + " ₹"
                        e.IsValid = False
                        '  e.IsValid = True
                    Else
                        cv.ErrorMessage = ""
                    End If
                End If

            End If
        Next


    End Sub
    Public Sub updateqtnwithdisc()
        MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
        Dim index As Integer = MainID
        Try
            Dim check As String = QuotationBLL.CheckQtnbeforedit(index)
            If check = "Already Exist" Then

                ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('Your trying to open Quotation through a invalid link, you will be redirected.');window.location='quotation.aspx'", True)
            Else

                Dim dt As DataSet = QuotationBLL.getQuotationById(index)
                Dim dtUser As New DataTable
                dtUser = dt.Tables(0)
                Dim drLogin As DataRow
                drLogin = dtUser.Rows(0)
                '===============to fetch previous quotation details only isChild is new column which =========================================
                If txtamount.Text = "" Then
                    txtamount.Text = 0
                End If
                If txtFreight.Text = "" Then
                    txtFreight.Text = "0.00"
                End If

                If String.IsNullOrEmpty(txtclosing.Text) Then
                    txtclosing.Text = Date.Now.Date.ToString("yyyy-MM-dd")
                End If

                '===============INSERTING AND CREATING NEW VERSION =========================================
                Dim QuotationId As Integer
                If ddQuotationType.SelectedValue = "Domestic" Then
                    QuotationId = QuotationBLL.InsertRevision(
                   ddrelatedtype.SelectedValue, ddrelatedtypeid.SelectedValue, "Negotiation/Review",
                   txtQuotationdate.Text.Trim, txtvalidity.Text.Trim,
                                    txtpayment.Text.Trim,
                                  txtdomdelterms.Text.Trim,
                                   txtdispath.Text.Trim,
                                     txtsign.Text.Trim,
                                   txtclosing.Text.Trim,
                                   ddowner.SelectedValue,
                                  txtamount.Text,
                                   Session("UserId"), Session("Audlog_Id"),
                                   txtFreight.Text,
                                  ddCurrency.SelectedValue,
                                  Convert.ToDouble(txtCurrencyRate.Text),
                                   MainID,
                                  ddPaymentTerms.SelectedValue,
                                   ddModeOfTransport.SelectedValue,
                                  ddlcountrybillCOO.SelectedValue,
                                    ddlcountrybill.SelectedValue,
                                  txtPortLoading.Text,
                                  txtPortDischarge.Text, ddlstatebill.SelectedValue, txtmopsub.Text.Trim, txtdocnclr.Text, txtocfrei.Text, txtinsurance.Text, chkqif.Checked, "INR")

                    Dim FreightTax As Double = ConfigurationManager.AppSettings("freightvalue")
                    'Dim freightamt As Double = Math.Round(Convert.ToDouble(txtFreight.Text) * CDbl(FreightTax) / 100).ToString("N2")
                    QuotationBLL.UpdateQuotationFreight(FreightTax, QuotationId)
                    ''call to update freight tax where QuotationId
                Else
                    QuotationId = QuotationBLL.InsertRevision(
                   ddrelatedtype.SelectedValue, ddrelatedtypeid.SelectedValue, "Negotiation/Review",
                   txtQuotationdate.Text.Trim, txtvalidity.Text.Trim,
                                    txtpayment.Text.Trim,
                                  dddelivery.SelectedValue,
                                   txtdispath.Text.Trim,
                                     txtsign.Text.Trim,
                                   txtclosing.Text.Trim,
                                   ddowner.SelectedValue,
                                  txtamount.Text,
                                   Session("UserId"), Session("Audlog_Id"),
                                   txtFreight.Text,
                                  ddCurrency.SelectedValue,
                                  Convert.ToDouble(txtCurrencyRate.Text),
                                   MainID,
                                  ddPaymentTerms.SelectedValue,
                                   ddModeOfTransport.SelectedValue,
                                  ddlcountrybillCOO.SelectedValue,
                                    ddlcountrybill.SelectedValue,
                                  txtPortLoading.Text,
                                  txtPortDischarge.Text, ddlstatebill.SelectedValue, txtmopsub.Text.Trim, txtdocnclr.Text, txtocfrei.Text, txtinsurance.Text, chkqif.Checked, ddlPrint.SelectedValue)
                End If

                assigncontrol.AddAssignTo(QuotationId)
                '===============to fetch items from previous quotation===========================
                'Dim dt1 As DataSet = ItemDetailBLL.getQuotationDetailsById(index)
                'Dim dtUser1 As New DataTable
                'dtUser1 = dt1.Tables(0)

                For i As Integer = 0 To dtUser.Rows.Count - 1
                    '===============to fetch latest discount=========================================
                    Dim dsDiscount As DataSet = ItemDetailBLL.DiscountItemDetail("DiscountItemDetail", index, Convert.ToInt32(dtUser.Rows(i)("ItemDt_ID").ToString()), Convert.ToInt32(dtUser.Rows(i)("Quotation_TypeID").ToString()))
                    Dim dtDiscount As New DataTable
                    dtDiscount = dsDiscount.Tables(0)
                    Dim drDiscount As DataRow
                    drDiscount = dtDiscount.Rows(0)
                    If drDiscount("Discount_Discount").ToString() <> "" Then
                        countrate = (Convert.ToDouble(drDiscount("Discount_Discount").ToString()) / 100)
                        countrate1 = (Convert.ToDouble(drDiscount("Product_Rate").ToString())) * countrate
                        If ddQuotationType.SelectedValue = "Domestic" Then
                            rate = Math.Round(Convert.ToDouble(drDiscount("Product_Rate").ToString())) - Math.Round(countrate1)
                        Else

                            rate = (Convert.ToDouble(drDiscount("Product_Rate").ToString())) - (countrate1)
                        End If
                    End If
                    TotalAmount = Convert.ToDouble(rate) * Math.Floor(Convert.ToDouble(drDiscount("Packing_weight").ToString())) * Math.Floor(Convert.ToDouble(dtUser.Rows(i)("ItemDt_Qty").ToString()))
                    Dim VAT As Double = Math.Round(Convert.ToDouble((Math.Round(Convert.ToDouble(drDiscount("Product_Vat").ToString())) * Math.Round(TotalAmount)) / 100))
                    '===================insert items in item detail=========================

                    Count = MainBLL.GetCode("MaxItemDT")
                    Count = Count + 1
                    Dim sb As New StringBuilder
                    sb.Append("<root>")

                    sb.Append("<row ItemDt_ID='" & Count.ToString & "' ItemDt_Type='" & DynamicparcelDataManipulation.FixNullFromDB(dtUser.Rows(i)("ItemDt_Type").ToString()) &
                          "' ItemDt_TypeId='" & QuotationId & "' ItemDt_ProductId='" & DynamicparcelDataManipulation.FixNullFromDB(dtUser.Rows(i)("ItemDt_ProductId").ToString()) &
                          "' ItemDt_Qty='" & DynamicparcelDataManipulation.FixNullFromDB(dtUser.Rows(i)("ItemDt_Qty").ToString()) & "' ItemDt_Rate='" & rate & "' ItemDt_Amount='" & TotalAmount &
                           "' ItemDt_Vat='" & VAT & "' ItemDt_DesiredMargin='" & DynamicparcelDataManipulation.FixNullFromDB(CDbl(dtUser.Rows(i)("ItemDt_DesiredMargin").ToString())) & "'/>")
                    Count = Count + 1
                    sb.Append("</root>")
                    QuotationBLL.XMLItemDtInsert(sb.ToString)

                Next i

                ' fillLead()
                ' url = "ModifyQuotation.aspx?ID=" + HttpUtility.UrlEncode(Security.Encrypt(QuotationId))
                Response.Redirect("ModifyQuotation.aspx?ID=" + HttpUtility.UrlEncode(Security.Encrypt(QuotationId)) + "&pu=y")

            End If
            '  ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + ("Quotation was successfully updated").ToString + "')", True)
            ' ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('Quotation was successfully updated.');window.location=" + url, True)
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("Quotation", "statuslink", error1, Session("UserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub

    Protected Sub btnupdatedisc_Click(sender As Object, e As EventArgs) Handles btnupdatedisc.Click

        Try

            If (IsValid = True) Then

                Dim custid As String = ddrelatedtypeid.SelectedValue
                '  DiscountBLL.Delete(Convert.ToInt32(custid))
                discountId = DiscountBLL.MaxDiscountID
                Dim sb As New StringBuilder
                sb.Append("<root>")
                For i As Integer = 0 To grddiscount.Rows.Count - 1 Step 1
                    Dim productid As String = grddiscount.DataKeys(i).Value
                    Dim txtdiscount As TextBox = CType(grddiscount.Rows(i).FindControl("txtdiscount"), TextBox)
                    DiscountBLL.DeleteSingle(Convert.ToInt32(custid), CInt(productid))

                    If String.IsNullOrEmpty(txtdiscount.Text) Or txtdiscount.Text = "0" Then
                    Else
                        sb.Append("<row Discount_ID='" & CStr(discountId) & "' Discount_CustId='" & custid & "' Discount_ProductId='" & productid & "' Discount_Discount='" & txtdiscount.Text &
                              "' Discount_CreatedDate='" & DateAndTime.DateString & "' Discount_CreatedID='" & Session("UserId") &
                              "' Discount_ModifiedDate='" & DateAndTime.DateString & "' Discount_ModifiedID='" & Session("UserId") &
                              "' Discount_Del='0' Discount_Status='Active'/>")
                        discountId = discountId + 1
                    End If
                Next
                sb.Append("</root>")
                DiscountBLL.Update(sb.ToString)
                '  fillproductbyid()
                updateqtnwithdisc()
                'ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + ("Discount Updated successfully").ToString + "')", True)
            Else
                mpe1.Show()
            End If




        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
    Protected Sub grditemproduct_RowDataBound(sender As Object, e As GridViewRowEventArgs) Handles grditemproduct.RowDataBound
        If e.Row.RowType = DataControlRowType.DataRow Then
            Dim ltproductid As Label = DirectCast(e.Row.FindControl("ltproductid"), Label)
            Dim txtquantity As TextBox = TryCast(e.Row.FindControl("txtquantity"), TextBox)
            Dim txtdmarginp As TextBox = TryCast(e.Row.FindControl("txtdmarginp"), TextBox)

            Dim ltrate As Label = TryCast(e.Row.FindControl("ltrate"), Label)
            Dim ltitemid As Label = TryCast(e.Row.FindControl("ltitemid"), Label)
            Dim ltproductWeight As Label = TryCast(e.Row.FindControl("ltproductWeight"), Label)
            Dim ltkg As Label = TryCast(e.Row.FindControl("ltkg"), Label)
            Dim ltamount As Label = TryCast(e.Row.FindControl("ltamount"), Label)
            Dim ltdisamount As Label = TryCast(e.Row.FindControl("ltdisamount"), Label)
            Dim lblvat As Label = TryCast(e.Row.FindControl("lblvat"), Label)
            Dim lblvatinrs As Label = TryCast(e.Row.FindControl("lblvatinrs"), Label)
            Dim lblprductcost As Label = TryCast(e.Row.FindControl("lblprductcost"), Label)
            Dim ltproductrate As Label = TryCast(e.Row.FindControl("ltproductrate"), Label)

            Dim hflblvatinrs As HiddenField = TryCast(e.Row.FindControl("hflblvatinrs"), HiddenField)
            Dim hfltamount As HiddenField = TryCast(e.Row.FindControl("hfltamount"), HiddenField)

            Dim ltamtdollar As Label = DirectCast(e.Row.FindControl("ltamtdollar"), Label)
            Dim ltamtrupee As Label = DirectCast(e.Row.FindControl("ltamtrupee"), Label)

            If txtquantity.Text = "" Then
                txtquantity.Text = 1
            End If
            If txtquantity.Text.Contains(".") Then
                txtquantity.Text = Math.Floor(CDbl(txtquantity.Text))
            End If



            'ltamount.Text = Math.Round(Convert.ToDouble(ltamount.Text) + VAT).ToString("N2")



            Dim difference As Double = CDbl(ltrate.Text) - CDbl(lblprductcost.Text)
            MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
            If ddCurrency.SelectedValue = "USD" Then
                If MainID = 0 And ddCurrency.SelectedValue = "USD" Then

                    Dim lblproductskucost = TryCast(e.Row.FindControl("lblproductskucost"), Label)

                    Dim ltdollarrate = TryCast(e.Row.FindControl("ltdollarrate"), Label)
                    Dim ltDrateSKU = TryCast(e.Row.FindControl("ltDrateSKU"), Label)
                    Dim ltrateSKU = TryCast(e.Row.FindControl("ltrateSKU"), Label)
                    If Session("UserRoleID") = "1" Then
                        txtdmarginp.Text = "30.0"
                        Dim sp As Double = 0.0
                        sp = (100 / (100 - CDbl(txtdmarginp.Text))) * CDbl(lblprductcost.Text)
                        '   sp = CDbl(lblprductcost.Text) * ((CDbl(txtdmarginp.Text) / 100))
                        '  sp = sp + CDbl(lblprductcost.Text)
                        ltrate.Text = (Math.Round(sp)).ToString("N2")
                        'ltrate.Text = sp.ToString("N2")
                        ltdollarrate.Text = (CDbl(sp) / CDbl(txtCurrencyRate.Text)).ToString("N2")
                        'lblproductskucost.Text = (CDbl(ltrateSKU.Text) / CDbl(txtCurrencyRate.Text)).ToString("N2")
                        Dim varible As String = (CDbl(ltdollarrate.Text) * CDbl(ltkg.Text)).ToString("N2")
                        lblproductskucost.Text = varible
                        ltDrateSKU.Text = varible
                    Else
                        ltdollarrate.Text = (CDbl(ltrate.Text) / CDbl(txtCurrencyRate.Text)).ToString("N2")
                        Dim varible As String = (CDbl(ltdollarrate.Text) * CDbl(ltkg.Text)).ToString("N2")
                        lblproductskucost.Text = varible
                        ltDrateSKU.Text = varible
                    End If
                    ltkg.Text = ltproductWeight.Text * txtquantity.Text
                    hfltamount.Value = Math.Round(CDbl(ltkg.Text) * CDbl(ltrate.Text))
                    ltamount.Text = ltkg.Text * Math.Round(Convert.ToDouble(ltrate.Text))
                    ltrate.Text = Math.Round(Convert.ToDouble(ltrate.Text)).ToString("N2")
                    ltdisamount.Text = Math.Round(Convert.ToDouble(ltamount.Text))
                    Dim VAT As Double = 0.0 ' Math.Round(Convert.ToDouble((lblvat.Text * ltamount.Text) / 100))
                    hflblvatinrs.Value = VAT
                    lblvatinrs.Text = Math.Round(VAT).ToString("N2")
                    ltdisamount.Text = Math.Round(Convert.ToDouble(ltdisamount.Text)).ToString("N2")
                Else
                    ltkg.Text = ltproductWeight.Text * txtquantity.Text
                    hfltamount.Value = (CDbl(ltkg.Text) * CDbl(ltrate.Text))
                    ltamount.Text = ltkg.Text * (Convert.ToDouble(ltrate.Text))
                    ltrate.Text = (Convert.ToDouble(ltrate.Text)).ToString("N2")
                    ltdisamount.Text = (Convert.ToDouble(ltamount.Text))
                    Dim VAT As Double
                    If ddCurrency.SelectedValue = "USD" Then
                        VAT = 0.0
                    Else
                        VAT = (Convert.ToDouble((lblvat.Text * ltamount.Text) / 100))
                    End If
                    hflblvatinrs.Value = VAT
                    lblvatinrs.Text = (VAT).ToString("N2")
                    ltdisamount.Text = (Convert.ToDouble(ltdisamount.Text)).ToString("N2")
                    If txtdmarginp.Text = "" Or txtdmarginp.Text = "0.00" Then
                        txtdmarginp.Text = ((difference / CDbl(ltrate.Text)) * 100).ToString("N2")
                    Else

                    End If

                End If
            Else
                'here for domectic quote
                If MainID = 0 And ddCurrency.SelectedValue = "USD" Then

                    Dim lblproductskucost = TryCast(e.Row.FindControl("lblproductskucost"), Label)

                    Dim ltdollarrate = TryCast(e.Row.FindControl("ltdollarrate"), Label)
                    Dim ltDrateSKU = TryCast(e.Row.FindControl("ltDrateSKU"), Label)
                    Dim ltrateSKU = TryCast(e.Row.FindControl("ltrateSKU"), Label)
                    If Session("UserRoleID") = "1" Then
                        txtdmarginp.Text = "30.0"
                        Dim sp As Double = 0.0
                        sp = (100 / (100 - CDbl(txtdmarginp.Text))) * CDbl(lblprductcost.Text)
                        '   sp = CDbl(lblprductcost.Text) * ((CDbl(txtdmarginp.Text) / 100))
                        '  sp = sp + CDbl(lblprductcost.Text)
                        ltrate.Text = (Math.Round(sp)).ToString("N2")
                        'ltrate.Text = sp.ToString("N2")
                        ltdollarrate.Text = (CDbl(sp) / CDbl(txtCurrencyRate.Text)).ToString("N2")
                        'lblproductskucost.Text = (CDbl(ltrateSKU.Text) / CDbl(txtCurrencyRate.Text)).ToString("N2")
                        Dim varible As String = (CDbl(ltdollarrate.Text) * CDbl(ltkg.Text)).ToString("N2")
                        lblproductskucost.Text = varible
                        ltDrateSKU.Text = varible
                    Else
                        ltdollarrate.Text = (CDbl(ltrate.Text) / CDbl(txtCurrencyRate.Text)).ToString("N2")
                        Dim varible As String = (CDbl(ltdollarrate.Text) * CDbl(ltkg.Text)).ToString("N2")
                        lblproductskucost.Text = varible
                        ltDrateSKU.Text = varible
                    End If
                    ltkg.Text = ltproductWeight.Text * txtquantity.Text
                    hfltamount.Value = Math.Round(CDbl(ltkg.Text) * CDbl(ltrate.Text))
                    ltamount.Text = ltkg.Text * Math.Round(Convert.ToDouble(ltrate.Text))
                    ltrate.Text = Math.Round(Convert.ToDouble(ltrate.Text)).ToString("N2")
                    ltdisamount.Text = Math.Round(Convert.ToDouble(ltamount.Text))
                    Dim VAT As Double = 0.0 ' Math.Round(Convert.ToDouble((lblvat.Text * ltamount.Text) / 100))
                    hflblvatinrs.Value = VAT
                    lblvatinrs.Text = Math.Round(VAT).ToString("N2")
                    ltdisamount.Text = Math.Round(Convert.ToDouble(ltdisamount.Text)).ToString("N2")
                Else
                    ltkg.Text = ltproductWeight.Text * txtquantity.Text
                    hfltamount.Value = Math.Round(CDbl(ltkg.Text) * CDbl(ltrate.Text))
                    ltamount.Text = ltkg.Text * Math.Round(Convert.ToDouble(ltrate.Text))
                    ltrate.Text = Math.Round(Convert.ToDouble(ltrate.Text)).ToString("N2")
                    ltdisamount.Text = Math.Round(Convert.ToDouble(ltamount.Text))
                    Dim VAT As Double
                    If ddCurrency.SelectedValue = "USD" Then
                        VAT = 0.0
                    Else
                        ' ''VAT = Math.Round(Convert.ToDouble((lblvat.Text * ltamount.Text) / 100))'***MUBYN
                        VAT = Math.Round(Convert.ToDouble((lblvat.Text * ltamount.Text) / 100))
                    End If
                    hflblvatinrs.Value = VAT
                    ' ''lblvatinrs.Text = Math.Round(VAT).ToString("N2")'***MUBYN
                    lblvatinrs.Text = (VAT).ToString("N2")
                    ltdisamount.Text = Math.Round(Convert.ToDouble(ltdisamount.Text)).ToString("N2")
                    If txtdmarginp.Text = "" Or txtdmarginp.Text = "0.00" Then
                        txtdmarginp.Text = ((difference / CDbl(ltrate.Text)) * 100).ToString("N2")
                    Else

                    End If

                End If
            End If

            ''faisal increase all columns by +1  pending
            If Session("UserRoleID") = "1" Then

                grditemproduct.Columns(6).Visible = True  'margin
                grditemproduct.Columns(7).Visible = True  ' desired textbox

            Else
