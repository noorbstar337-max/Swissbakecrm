        function calculatekg(txtOrderQty) {
            // debugger;
            var hfPacking_Weight = document.getElementById(txtOrderQty.id.replace('txtOrderQty', 'hfPacking_Weight'))
            var txtOrderKG = document.getElementById(txtOrderQty.id.replace('txtOrderQty', 'txtOrderKG'))
            var txtOrderQty = document.getElementById(txtOrderQty.id.replace('txtOrderQty', 'txtOrderQty'))

            if (txtOrderQty.value != "" && txtOrderQty.value != "0") {
                if (!isNaN(txtOrderQty.value)) {
                    var txtOrderKG = document.getElementById(txtOrderQty.id.replace('txtOrderQty', 'txtOrderKG'))
                    var kg = (hfPacking_Weight.value * txtOrderQty.value);

                    document.getElementById(txtOrderQty.id.replace('txtOrderQty', 'txtOrderKG')).value = kg;
                    var qty = (kg / hfPacking_Weight.value);
                    //var kg = (hfPacking_Weight.value * txtOrderQty.value).toFixed(2);

                    //  txtOrderQty.textContent = (txtOrderKG.textContent / hfPacking_Weight.value).toFixed(2);
                    document.getElementById(txtOrderQty.id.replace('txtOrderQty', 'txtOrderQty')).value = qty;
                }
            }
        }
        function calculateqty(txtOrderKG) {
            //  debugger;
            var hfPacking_Weight = document.getElementById(txtOrderKG.id.replace('txtOrderKG', 'hfPacking_Weight'))
            var txtOrderKG = document.getElementById(txtOrderKG.id.replace('txtOrderKG', 'txtOrderKG'))
            var txtOrderQty = document.getElementById(txtOrderKG.id.replace('txtOrderKG', 'txtOrderQty'))

            if (txtOrderKG.value != "" && txtOrderKG.value != "0") {
                if (!isNaN(txtOrderKG.value)) {

                    var qty = (txtOrderKG.value / hfPacking_Weight.value);
                    if (qty < 1) {
                        qty = 1;
                        document.getElementById(txtOrderQty.id.replace('txtOrderKG', 'txtOrderQty')).value = Math.round(qty);
                    }
                    else {

                        document.getElementById(txtOrderQty.id.replace('txtOrderKG', 'txtOrderQty')).value = Math.round(qty);
                    }
                    calculatekg(txtOrderQty)
                    //  var kg = (hfPacking_Weight.value * qty);

                    //document.getElementById(txtOrderKG.id.replace('txtOrderKG', 'txtOrderKG')).value = kg;
                    //  txtOrderQty.textContent = (txtOrderKG.textContent / hfPacking_Weight.value).toFixed(2);
                }
            }
        }

        function calculatesp(txtcalSP) {
            // debugger;
            var lblcalmargin = document.getElementById(txtcalSP.id.replace('txtcalSP', 'lblcalmargin'))
            var txtcalSP = document.getElementById(txtcalSP.id.replace('txtcalSP', 'txtcalSP'))
            var txtcalCP = document.getElementById(txtcalSP.id.replace('txtcalSP', 'txtcalCP'))
            var txtdollarrate = document.getElementById(txtcalSP.id.replace('txtcalSP', 'txtCurrencyRate'))


            if (txtcalSP.value != "" && txtcalSP.value != "0" && txtcalCP.value != "" && txtcalCP.value != "0") {
                if (!isNaN(txtcalSP.value)) {

                    var sp = txtdollarrate.value * txtcalSP.value;

                    var margin = ((sp - txtcalCP.value) / sp) * 100;


                    lblcalmargin.textContent = (margin).toFixed(2);
                    //if (qty < 1) {
                    //    qty = 1;
                    //    document.getElementById(txtOrderQty.id.replace('txtOrderKG', 'txtOrderQty')).value = Math.round(qty);
                    //}
                    //else {

                    //    document.getElementById(txtOrderQty.id.replace('txtOrderKG', 'txtOrderQty')).value = Math.round(qty);
                    //}
                    // calculatekg(txtOrderQty)
                    //  var kg = (hfPacking_Weight.value * qty);

                    //document.getElementById(txtOrderKG.id.replace('txtOrderKG', 'txtOrderKG')).value = kg;
                    //  txtOrderQty.textContent = (txtOrderKG.textContent / hfPacking_Weight.value).toFixed(2);
                }
            }
        }
        function calculatecp(txtcalCP) {
            // ; debugger
            // var lblcalmargin = document.getElementById(txtcalCP.id.replace('txtcalCP', 'lblcalmargin'))
            var txtcalSP = document.getElementById(txtcalCP.id.replace('txtcalCP', 'txtcalSP'))
            var txtcalCP = document.getElementById(txtcalCP.id.replace('txtcalCP', 'txtcalCP'))
            //  var txtdollarrate = document.getElementById(txtcalCP.id.replace('txtcalCP', 'txtCurrencyRate'))

            calculatesp(txtcalSP)
        }
    </script>

    <script>
        function ChangeNoOfPack(txtQty) {
            debugger;
            var txtQty = document.getElementById(txtQty.id.replace('txtQty', 'txtQty'));
            var ltrate = document.getElementById(txtQty.id.replace('txtQty', 'ltrate'));
            var lblvatinrs = document.getElementById(txtQty.id.replace('txtQty', 'lblvatinrs'));
            var lblsubtotal = document.getElementById(txtQty.id.replace('txtQty', 'lblsubtotal'));
            //var lblrate = document.getElementById(txtOrderQty.id.replace('txtQty', 'Literal1'));
            //var lblpackweight = document.getElementById(txtOrderQty.id.replace('txtQty', 'lblpackweight'));

            if (txtQty.value != "" && txtQty.value != "0") {
                if (!isNaN(txtQty.value)) {
                    //  lblkgs.textContent = (parseFloat(txtQty.value) * parseFloat(txtRate.value)).toFixed(2);
                    //  lbltotalamount1.textContent = (parseFloat(lblkgs.textContent) * parseFloat(lblrate.textContent.replace(',', ''))).toFixed(2);
                    //  lbltotalamount1.textContent = lbltotalamount1.textContent.replace(/(\d)(?=(\d{3})+\.)/g, '$1,');
                    var Amount = 0;
                    var tax = 0;
                    var subtotal = 0;
                    subtotal = ((parseFloat(txtQty.value) * parseFloat(ltrate.value))).toFixed(2);

                    tax = (subtotal * (parseFloat(lblvatinrs.value) / 100)).toFixed(2);
                    lblsubtotal.textContent = (parseFloat(tax) + parseFloat(subtotal)).toFixed(2);
                    // alert(Amount);
                }
                //    else {
                //        lblkgs.textContent = "-";
                //        lbltotalamount1.textContent = "-";
                //    }
                //}
                //else {
                //    lblkgs.textContent = "-";
                //    lbltotalamount1.textContent = "-";
            }
        };
    </script>
    <script type="text/javascript">
        function DiscountRate(txtdiscount) {
            debugger;
            var txtCurrencyRate = document.getElementById("<%= txtCurrencyRate.ClientID%>");
            var txtDiscountedRate = document.getElementById(txtdiscount.id.replace('txtdiscount', 'txtDiscountedRate'));
            var txtdiscount = document.getElementById(txtdiscount.id.replace('txtdiscount', 'txtdiscount'));
            var lblRate = document.getElementById(txtdiscount.id.replace('txtdiscount', 'lblRate'));

            txtDiscountedRate.value = ((lblRate.innerText - (lblRate.innerText * txtdiscount.value) / 100) / txtCurrencyRate.value).toFixed(2);

        };</script>
    <script type="text/javascript">
        function DiscountPercent(txtDiscountedRate) {
            debugger;

            var txtCurrencyRate = document.getElementById("<%= txtCurrencyRate.ClientID%>");
            var txtDiscountedRate = document.getElementById(txtDiscountedRate.id.replace('txtDiscountedRate', 'txtDiscountedRate'));
            var txtdiscount = document.getElementById(txtDiscountedRate.id.replace('txtDiscountedRate', 'txtdiscount'));
            var lblRate = document.getElementById(txtDiscountedRate.id.replace('txtDiscountedRate', 'lblRate'));

            txtdiscount.value = ((lblRate.innerText - (txtDiscountedRate.value * txtCurrencyRate.value)) / lblRate.innerText * 100).toFixed(2);

        };</script>
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder1" runat="Server">
    <asp:HiddenField ID="hfMainID" runat="server" />
    <asp:HiddenField ID="deletestatus" runat="server" />
    <asp:HiddenField ID="tablecheck" runat="server" />
    <asp:HiddenField ID="hfFreightTaxPer" runat="server" />
    <asp:HiddenField ID="hffreight" runat="server" />
    <asp:HiddenField ID="hfdocclear" runat="server" />
    <asp:HiddenField ID="hfocfreight" runat="server" />
    <asp:HiddenField ID="hfinsurance" runat="server" />
    <asp:HiddenField ID="hfchkqif" runat="server" />

    <asp:HiddenField ID="hfcurrencyrate" runat="server" />
    <asp:HiddenField ID="qtntype" runat="server" />
    <div class="row">
        <div class="col-md-12">
            <div class="content-header">
                <div class="header-section">
                    <h1 style="font-weight: 400;">
                        <%-- <i class="fa fa-cubes" style="margin: -8px"></i>Modify Quotation<br>--%>
                        <asp:Label ID="lbltitle1" runat="server"></asp:Label><br>
                    </h1>
                </div>
            </div>
            <ul class="breadcrumb breadcrumb-top">
                <li><a href="index.aspx">Home</a></li>
                <li><a href="Quotation.aspx">Quotation</a></li>
                <li>
                    <asp:Label ID="lbltitle2" runat="server"></asp:Label></li>
                <%--<li>Modify Quotation</li>--%>
            </ul>

            <div class="col-md-12" style="margin-bottom: 11px; display: table; margin-top: -8px">
                <div class="pull-right">
                    <%--  <asp:Button Text="Create New Version" runat="server" ID="Button12" OnClientClick="if (!Page_ClientValidate('MasterGroup')){ return false; } this.disabled = true; this.value = 'Creating Version...';"
                        UseSubmitBehavior="false" class="btn btn-alt btn-sm btn-warning" ValidationGroup="MasterGroup" OnClick="btnversion_Click" />--%>
                    <asp:Button Text="Save" runat="server" ID="Button1" OnClientClick="if (!Page_ClientValidate('MasterGroup')){ return false; } this.disabled = true; this.value = 'Saving...';"
                        UseSubmitBehavior="false" class="btn btn-alt btn-sm btn-primary" ValidationGroup="MasterGroup" OnClick="btnadd_Click" />
                    <asp:LinkButton ID="HyperLink1" CausesValidation="false" Text="Cancel" runat="server" NavigateUrl="~/Quotation.aspx" class="btn btn-alt btn-sm btn-danger" OnClick="hfcancel_Click" />
                </div>
            </div>

            <div class="col-md-12">
                <div class="widget">
                    <div class="widget-extra themed-background-dark">
                        <h4 class="widget-content-light">
                            <strong>Quotation</strong> Information&nbsp;<asp:Label ID="lblQNo" runat="server" Font-Bold="true"></asp:Label>
                         <small>
                             <span class="pull-right" id="modifyspan" runat="server">By&nbsp;<a style="text-decoration: none;"><asp:Label ID="lblmodifiedname" runat="server" Font-Bold="true"></asp:Label></a>&nbsp;on&nbsp;<a style="text-decoration: none;"><asp:Label ID="lblmodifieddate" Font-Bold="true" runat="server" Font-Italic="true"></asp:Label></a>
                             </span>
                         </small>
                        </h4>
                    </div>
                    <div class="widget-extra-full">
                        <div class="form-horizontal form-bordered">
                            <div>
                                <div class="col-md-12">
                                    <br />
                                    <div class="col-md-4 pd-b-10">
                                        <label class="col-md-4 control-label" for="example-hf-email">Quotation Date<span class="text-danger"> *</span></label>
                                        <div class="col-md-8">
                                            <asp:TextBox ID="txtQuotationdate" runat="server" placeholder="Enter Quotation Name" data-toggle="tooltip" title="Enter Quotation Name" TextMode="Date"
                                                CssClass="form-control"></asp:TextBox>
                                            <asp:RequiredFieldValidator ID="remembername" runat="server" Display="Dynamic" ControlToValidate="txtQuotationdate" ValidationGroup="MasterGroup" CssClass="MasterValidationCSS"
                                                ErrorMessage="Please enter date" SetFocusOnError="true"></asp:RequiredFieldValidator>
                                        </div>
                                    </div>
                                    <div class="col-md-4 pd-b-10">
                                        <div class="">
                                            <label class="col-md-4 control-label" for="example-hf-password">Status</label>
                                            <div class="col-md-8">
                                                <asp:DropDownList ID="ddstatus" runat="server" CssClass="form-control">
                                                    <asp:ListItem Text="New" Value="New"></asp:ListItem>
                                                    <asp:ListItem Text="Negotiation/Review" Value="Negotiation/Review"></asp:ListItem>
                                                    <asp:ListItem Text="Repeated Order" Value="Repeated Order"></asp:ListItem>
                                                    <asp:ListItem Text="Closed Won" Value="Closed Won"></asp:ListItem>
                                                    <asp:ListItem Text="Closed Lost" Value="Closed Lost"></asp:ListItem>
                                                </asp:DropDownList>
                                                <asp:RequiredFieldValidator ID="RequiredFieldValidator1" Display="Dynamic" runat="server" ControlToValidate="ddstatus" ValidationGroup="MasterGroup1" CssClass="MasterValidationCSS"
                                                    ErrorMessage="Please select status" SetFocusOnError="true"></asp:RequiredFieldValidator>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 pd-b-10">
                                        <div class="">
                                            <label class="col-md-4 control-label" for="example-hf-password">Validity (days)<span class="text-danger"> *</span></label>
                                            <div class="col-md-8">
                                                <asp:TextBox ID="txtvalidity" runat="server" onkeyup="this.value=this.value.replace(/[^\d\.]/g,'');" placeholder="Enter Validity" data-toggle="tooltip" title="Enter Validity" TextMode="Number" min="1"
                                                    CssClass="form-control"></asp:TextBox>
                                                <asp:RequiredFieldValidator ID="RequiredFieldValidator4" Display="Dynamic" runat="server" ControlToValidate="txtvalidity" ValidationGroup="MasterGroup" CssClass="MasterValidationCSS"
                                                    ErrorMessage="Please enter days" SetFocusOnError="true"></asp:RequiredFieldValidator>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 pd-b-10">
                                        <label class="col-md-4 control-label" for="example-hf-password">Type<span class="text-danger"> *</span></label>
                                        <div class="col-md-8">
                                            <asp:DropDownList ID="ddrelatedtype" runat="server" AutoPostBack="true" data-toggle="tooltip" title="Related Type" CssClass="form-control">
                                                <%--<asp:ListItem Value="None">None</asp:ListItem>--%>
                                                <asp:ListItem Value="Prospect">Prospect</asp:ListItem>
                                                <asp:ListItem Value="Account">Account</asp:ListItem>
                                            </asp:DropDownList>
                                            <asp:RequiredFieldValidator ID="RequiredFieldValidator2" Display="Dynamic" runat="server" ControlToValidate="ddrelatedtype" ValidationGroup="MasterGroup" CssClass="MasterValidationCSS"
                                                ErrorMessage="Please select type" SetFocusOnError="true"></asp:RequiredFieldValidator>
                                        </div>
                                    </div>
                                    <div class="col-md-4 pd-b-10">
                                        <label class="col-md-4 control-label" for="example-hf-password">Quotation Type<span class="text-danger"> *</span></label>
                                        <div class="col-md-8">
                                            <asp:DropDownList ID="ddQuotationType" runat="server" AutoPostBack="true" data-toggle="tooltip" title="Quotation Type" CssClass="form-control">
                                                <%--<asp:ListItem Value="None">None</asp:ListItem>--%>
                                                <asp:ListItem Value="Domestic">Domestic</asp:ListItem>
                                                <asp:ListItem Value="Export">Export</asp:ListItem>
                                            </asp:DropDownList>
                                            <asp:RequiredFieldValidator ID="RequiredFieldValidator13" Display="Dynamic" runat="server" ControlToValidate="ddQuotationType" ValidationGroup="MasterGroup" CssClass="MasterValidationCSS"
                                                ErrorMessage="Please select Quotation Type" SetFocusOnError="true"></asp:RequiredFieldValidator>
                                        </div>
                                    </div>
                                    <div class="col-md-4 pd-b-10">
                                        <div class="">
                                            <asp:Label class="col-md-4 control-label" for="example-hf-password" ID="lbltypeid" runat="server">None</asp:Label>
                                            <div class="col-md-8">
                                                <asp:DropDownList ID="ddrelatedtypeid" runat="server" AutoPostBack="true" name="example-chosen" class="select-chosen" data-toggle="tooltip" title="Related Type ID"></asp:DropDownList>
                                                <asp:RequiredFieldValidator ID="RequiredFieldValidator3" Display="Dynamic" runat="server" ControlToValidate="ddrelatedtypeid" ValidationGroup="MasterGroup" CssClass="MasterValidationCSS"
                                                    ErrorMessage="Please select type id" SetFocusOnError="true"></asp:RequiredFieldValidator>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-4 pd-b-10">
                                        <div class="">
                                            <label class="col-md-4 control-label" for="example-hf-password">Auth.Signatory</label>
                                            <div class="col-md-8">
