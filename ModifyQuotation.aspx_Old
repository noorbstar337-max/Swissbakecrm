                                                                    <asp:GridView ID="grddiscount" runat="server" AutoGenerateColumns="False" DataKeyNames="Product_id"
                                                                        CssClass="table table-striped table-vcenter table-hover"
                                                                        AllowPaging="False" AllowSorting="True">
                                                                        <Columns>

                                                                            <asp:TemplateField HeaderText="ID" HeaderStyle-CssClass="MasterGridviewHeader" ItemStyle-CssClass="MasterGridviewItem" SortExpression="Product_id" Visible="false">
                                                                                <ItemTemplate>
                                                                                    <asp:Literal ID="lblProductid" runat="server" Text='<%#Eval("Product_id")%>' />
                                                                                </ItemTemplate>
                                                                            </asp:TemplateField>
                                                                            <asp:TemplateField HeaderText="Product Code" ItemStyle-CssClass="MasterGridviewItem" HeaderStyle-CssClass="MasterGridviewHeader" SortExpression="Product_Code">
                                                                                <ItemTemplate>
                                                                                    <asp:Literal ID="lblcode" runat="server" Text='<%#Eval("Product_Code")%>' />
                                                                                </ItemTemplate>
                                                                            </asp:TemplateField>
                                                                            <asp:TemplateField HeaderText="Product Name" ItemStyle-CssClass="MasterGridviewItem" HeaderStyle-CssClass="MasterGridviewHeader" SortExpression="Product_Name">
                                                                                <ItemTemplate>
                                                                                    <asp:Literal ID="lblname" runat="server" Text='<%#Eval("Product_Name")%>' />
                                                                                </ItemTemplate>
                                                                            </asp:TemplateField>
                                                                            <asp:TemplateField HeaderText="Product Rate" ItemStyle-CssClass="MasterGridviewItem" HeaderStyle-CssClass="MasterGridviewHeader">
                                                                                <ItemTemplate>
                                                                                    ₹
                                                                                    <asp:Label ID="lblRate" runat="server" Text='<%#(Eval("Product_Rate"))%>' />
                                                                                </ItemTemplate>
                                                                            </asp:TemplateField>
                                                                            <asp:TemplateField HeaderText="Discount(%)" HeaderStyle-CssClass="MasterGridviewHeader" ItemStyle-CssClass="MasterGridviewItem" SortExpression="discount_discount">
                                                                                <ItemTemplate>
                                                                                    <asp:TextBox ID="txtdiscount" runat="server" Text='<%#Eval("discount_discount")%>' CssClass="decimal" onChange="DiscountRate(this)"></asp:TextBox>
                                                                                    <asp:Literal ID="ltCost" runat="server" Text='<%#Eval("Product_Cost")%>' Visible="false" />
                                                                                    <asp:Literal ID="ltMargin" runat="server" Text='<%#Eval("Product_Margin")%>' Visible="false" />
                                                                                    <asp:Literal ID="ltRate" runat="server" Text='<%#Eval("Product_Rate")%>' Visible="false" />
                                                                                    <br />
                                                                                    <asp:Literal ID="lblERR" runat="server" />
                                                                                    <asp:CustomValidator ID="CustomValidator1" runat="server" OnServerValidate="valueCheck" ControlToValidate="txtdiscount" ValidationGroup="MasterGroupDisc" CssClass="MasterValidationCSS" Display="Dynamic" SetFocusOnError="true"></asp:CustomValidator>
                                                                                    <asp:RegularExpressionValidator ID="RegularExpressionValidator1" runat="server" ControlToValidate="txtdiscount" ErrorMessage="Discount should be between 0 to 99" ValidationExpression="^(?:99|\d{1,2})(?:\.\d{1,2})?$" ValidationGroup="MasterGroupDisc" CssClass="MasterValidationCSS" Display="Dynamic"></asp:RegularExpressionValidator>
                                                                                </ItemTemplate>

                                                                            </asp:TemplateField>
                                                                            <asp:TemplateField HeaderText="Discounted Price ($)" HeaderStyle-CssClass="MasterGridviewHeader" ItemStyle-CssClass="MasterGridviewItem" SortExpression="discount_discount">
                                                                                <ItemTemplate>
                                                                                    <asp:TextBox ID="txtDiscountedRate" runat="server" Text='<%#(Convert.ToDouble(Eval("Product_Rate") - (Eval("Product_Rate") * Eval("discount_discount") / 100)) / txtCurrencyRate.Text).ToString("0.00")%>' onChange="DiscountPercent(this)" CssClass="decimal " Style="text-align: right;"></asp:TextBox>
                                                                                    <%--<asp:CustomValidator ID="CustomValidator1" runat="server"  OnServerValidate="valueCheck" ControlToValidate="txtdiscount" ValidationGroup="MasterGroupDisc" CssClass="MasterValidationCSS" Display="Dynamic" SetFocusOnError="true"></asp:CustomValidator>--%>
                                                                                    <%--<asp:RegularExpressionValidator ID="RegularExpressionValidator1" runat="server" ControlToValidate="txtdiscount" ErrorMessage="Discount should be between 0 to 99" ValidationExpression="^(?:99|\d{1,2})(?:\.\d{1,2})?$" ValidationGroup="MasterGroupDisc" CssClass="MasterValidationCSS" Display="Dynamic"></asp:RegularExpressionValidator>--%>
                                                                                </ItemTemplate>

                                                                            </asp:TemplateField>
                                                                        </Columns>
                                                                        <PagerStyle CssClass="MasterGridviewPaging" HorizontalAlign="Right" BackColor="White" />

                                                                        <FooterStyle HorizontalAlign="Center" BackColor="White" />
                                                                        <PagerSettings PageButtonCount="4" />

                                                                        <EmptyDataTemplate>
                                                                            <asp:Label ID="s" runat="server" Text="No Record Found"></asp:Label><br />
                                                                            <br />
                                                                        </EmptyDataTemplate>
                                                                        <EmptyDataRowStyle HorizontalAlign="Center" />
                                                                    </asp:GridView>
                                                                </div>
                                                            </ContentTemplate>
                                                            <%--<Triggers>
                                                                <asp:AsyncPostBackTrigger ControlID="btnsave" />
                                                                <asp:AsyncPostBackTrigger ControlID="btnopen" />
                                                              
                                                            </Triggers>--%>
                                                        </asp:UpdatePanel>

                                                    </div>
                                                    <%--       <asp:UpdatePanel ID="UpdatePanel5" runat="server" UpdateMode="Always">
                                                        <ContentTemplate>--%>
                                                    <div class="modal-footer">
                                                        <asp:Button Text="Update" runat="server" ID="btnupdatedisc" OnClientClick="if (!Page_ClientValidate('MasterGroupDisc')){ return false; } this.disabled = true; this.value = 'Saving...';"
                                                            UseSubmitBehavior="false" class="btn btn-alt btn-primary" ValidationGroup="MasterGroupDisc" />
                                                    </div>
                                                    <%--</ContentTemplate>
                                                        <Triggers>
                                                            <asp:AsyncPostBackTrigger ControlID="btndiscount" />
                                                        </Triggers>
                                                    </asp:UpdatePanel>--%>
                                                </div>
                                            </div>
                                        </asp:Panel>
                                    </div>
                                </div>
                            </div>
                            <div id="divdate" runat="server" visible="false">
                                <div class="col-md-3">
                                    <div class="">
                                        <label for="example-nf-email">Created Date</label>
                                        <asp:TextBox ID="txtcreatedate" runat="server" ReadOnly="true" placeholder="Created Date" data-toggle="tooltip" title="Created Date"
                                            CssClass="form-control"></asp:TextBox>

                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="">
                                        <label for="example-nf-email">Created Name</label>
                                        <asp:TextBox ID="txtcreatedname" runat="server" placeholder="Modified Date" ReadOnly="true" data-toggle="tooltip" title="Modified Date"
                                            CssClass="form-control"></asp:TextBox>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="">
                                        <label for="example-nf-email">Modified Date</label>
                                        <asp:TextBox ID="txtmodifieddate" runat="server" placeholder="Modified Date" ReadOnly="true" data-toggle="tooltip" title="Modified Date"
                                            CssClass="form-control"></asp:TextBox>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="">
                                        <label for="example-nf-email">Modified Name</label>
                                        <asp:TextBox ID="txtmodifiedname" runat="server" placeholder="Modified Date" ReadOnly="true" data-toggle="tooltip" title="Modified Date"
                                            CssClass="form-control"></asp:TextBox>
                                    </div>
                                </div>


                            </div>

                            <div style="clear: both"></div>


                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-12" style="margin-bottom: 11px; display: table; margin-top: -8px">
                <div class="pull-right">

                    <%--<asp:Button Text="Create New Version" runat="server" ID="btnversion" OnClientClick="if (!Page_ClientValidate('MasterGroup')){ return false; } this.disabled = true; this.value = 'Creating Version...';"
                        UseSubmitBehavior="false" class="btn btn-alt btn-sm btn-warning" ValidationGroup="MasterGroup"  />--%>
                    <asp:Button Text="Save" runat="server" ID="btnadd" OnClientClick="if (!Page_ClientValidate('MasterGroup')){ return false; } this.disabled = true; this.value = 'Saving...';"
                        UseSubmitBehavior="false" class="btn btn-alt btn-sm btn-primary" ValidationGroup="MasterGroup" />
                    <asp:LinkButton ID="hfcancel" CausesValidation="false" Text="Cancel" runat="server" NavigateUrl="~/Quotation.aspx" class="btn btn-alt btn-sm btn-danger" TabIndex="15" />
                </div>
            </div>

        </div>
    </div>
    <asp:UpdateProgress ID="UpdateProgress1" AssociatedUpdatePanelID="" runat="server" DisplayAfter="0">
        <ProgressTemplate>
            <br />
            <div class="divWaiting">
                <i class="fa fa-sun-o fa-spin" id="LoadingUpadatePanel"></i>
            </div>
        </ProgressTemplate>
    </asp:UpdateProgress>
</asp:Content>

