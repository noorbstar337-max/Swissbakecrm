                                                                                <ItemTemplate>

                                                                                    <asp:TextBox ID="txtOrderQty" runat="server" onblur="this.value=this.value.replace(/\D/g,'');calculatekg(this)" Style="width: 54px;" min="0"></asp:TextBox>

