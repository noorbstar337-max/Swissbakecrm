    <script type="text/javascript">
        function checkdelete() {
            if (confirm('Are you Sure want to Delete?')) {
                document.getElementById('<%=deletestatus.ClientID %>').value = "yes";
                return true
            }
            else {
                document.getElementById('<%=deletestatus.ClientID %>').value = "no";
                return true
            }
        }

        function calculateFinalPrice(txtquantity, hfkg) {
            debugger;
            var type = document.getElementById('<%=qtntype.ClientID%>').value
            var grdcellcount = $('.mT>tbody>tr>th').length - 1;
            if (type == "Domestic") {
                var hfPacking_Weight = document.getElementById(txtquantity.id.replace('txtquantity', 'hfkg'))
                var ltrate = document.getElementById(txtquantity.id.replace('txtquantity', 'ltrate'))
                var lblvat = document.getElementById(txtquantity.id.replace('txtquantity', 'lblvat'))
                var lblvatinrs = document.getElementById(txtquantity.id.replace('txtquantity', 'lblvatinrs'))
                var ltdisamount = document.getElementById(txtquantity.id.replace('txtquantity', 'ltdisamount'))
                var ltkg = document.getElementById(txtquantity.id.replace('txtquantity', 'ltkg'))
                var hfltamount = document.getElementById(txtquantity.id.replace('txtquantity', 'hfltamount'))
                var hflblvatinrs = document.getElementById(txtquantity.id.replace('txtquantity', 'hflblvatinrs'))

                //ltkg.textContent = hfPacking_Weight.value * txtquantity.value***MUBYN
                ltkg.textContent = parseFloat(hfPacking_Weight.value * txtquantity.value).toFixed(2);
                var amount = 0
                var vatinr = 0
                amount = parseFloat(ltrate.textContent.replace(/,/g, '')) * parseFloat(ltkg.textContent.replace(/,/g, ''));
                vatinr = amount * parseFloat(lblvat.textContent.replace(/,/g, '')) / 100;
                hfltamount.value = Math.round(amount);
                //hflblvatinrs.value = Math.round(vatinr);*********MUBYN
                hflblvatinrs.value = (vatinr);
                ltdisamount.textContent = Math.round(parseFloat(ltrate.textContent.replace(/,/g, '')) * parseFloat(ltkg.textContent.replace(/,/g, ''))).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
                //lblvatinrs.textContent = Math.round(vatinr).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');*********MUBYN
                lblvatinrs.textContent = (vatinr).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
                // Read_Data();

                ; debugger


                var total = 0;
                var vat = 0;
                var grandtoatal = 0;
                var totalkg = 0;
                var Grid_Table = document.getElementById('<%= grditemproduct.ClientID%>');
                var Freight = document.getElementById('<%= txtfreight.ClientID %>');
                for (var row = 1; row < Grid_Table.rows.length - 1; row++) {

                    vat = parseFloat(vat) + parseFloat(Grid_Table.rows[row].cells[grdcellcount - 2].textContent.split("(")[0].replace(/[^0-9.]/g, ""));
                    total = parseFloat(total) + parseFloat(Grid_Table.rows[row].cells[grdcellcount].textContent.replace(/[^0-9.]/g, ""));
                    totalkg = parseFloat(totalkg) + parseFloat(Grid_Table.rows[row].cells[6].textContent.replace(/[^0-9.]/g, ""));
                }
                if (!Freight.value.length > 0) {
                    Freight.value = 0;
                }
                var Freighttaxper = '<%= System.Configuration.ConfigurationManager.AppSettings("freightvalue").ToString()%>';
                var FreightAmt = parseFloat(Freight.value) * Freighttaxper / 100;

                grandtoatal = vat + total + parseFloat(Freight.value) + parseFloat(FreightAmt)
                //grandtoatal = vat + total + parseFloat(Freight.value)
                //  Grid_Table.rows[row].cells[6].innerHTML = "<b>" + totalkg + " Kg</b>";
                //Grid_Table.rows[row].cells[grdcellcount].innerHTML = "<b><i class='fa fa-rupee'></i> " + Math.round(vat + parseFloat(FreightAmt)).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>" + "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + parseFloat(Freight.value).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>" + "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + Math.round(grandtoatal).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>";************MUBYN
                Grid_Table.rows[row].cells[grdcellcount].innerHTML = "<b><i class='fa fa-rupee'></i> " + (vat + parseFloat(FreightAmt)).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>" + "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + parseFloat(Freight.value).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>" + "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + Math.round(grandtoatal).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>";
                document.getElementById('<%=hftotalvat.ClientID%>').value = vat;
                document.getElementById('<%=hfgrandtotal.ClientID%>').value = grandtoatal - parseFloat(Freight.value);
                return false;
            }

            else {
                var hfPacking_Weight = document.getElementById(txtquantity.id.replace('txtquantity', 'hfkg'))
                var ltrate = document.getElementById(txtquantity.id.replace('txtquantity', 'ltrate'))
                var lblvat = 0// document.getElementById(txtquantity.id.replace('txtquantity', 'lblvat'))
                var lblvatinrs = 0//document.getElementById(txtquantity.id.replace('txtquantity', 'lblvatinrs'))
                var ltdisamount = document.getElementById(txtquantity.id.replace('txtquantity', 'ltdisamount'))
                var ltkg = document.getElementById(txtquantity.id.replace('txtquantity', 'ltkg'))
                var hfltamount = document.getElementById(txtquantity.id.replace('txtquantity', 'hfltamount'))
                //var hflblvatinrs = document.getElementById(txtquantity.id.replace('txtquantity', 'hflblvatinrs'))

                //ltkg.textContent = hfPacking_Weight.value * txtquantity.value
                parseFloat(hfPacking_Weight.value * txtquantity.value).toFixed(2);
                var amount = 0
                var vatinr = 0
                amount = parseFloat(ltrate.textContent.replace(/,/g, '')) * parseFloat(ltkg.textContent.replace(/,/g, ''));

                //hfltamount.value = Math.round(amount);
                hfltamount.value = (amount);

                //ltdisamount.textContent = Math.round(parseFloat(ltrate.textContent.replace(/,/g, '')) * parseFloat(ltkg.textContent.replace(/,/g, ''))).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
                ltdisamount.textContent = (parseFloat(ltrate.textContent.replace(/,/g, '')) * parseFloat(ltkg.textContent.replace(/,/g, ''))).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
                lblvatinrs.textContent = 0
                //  Read_Data();
                ; debugger
                var total = 0;
                var vat = 0;
                var grandtoatal = 0;
                var totalkg = 0;
                var Grid_Table = document.getElementById('<%= grditemproduct.ClientID%>');
                var LocFreight = document.getElementById('<%= txtfreight.ClientID %>');
                var docclear = document.getElementById('<%= txtdocnclr.ClientID%>');
                var ocFreight = document.getElementById('<%= txtocfrei.ClientID%>');
                var Insurance = document.getElementById('<%= txtinsurance.ClientID%>');
                //   var Freight = (parseFloat(LocFreight.value) + parseFloat(docclear.value) + parseFloat(ocFreight.value) + parseFloat(Insurance.value));
                var Freight = (parseFloat(LocFreight == null || LocFreight == '' ? 0 : LocFreight.value) + parseFloat(docclear == null || docclear == '' ? 0 : docclear.value) + parseFloat(ocFreight == null || ocFreight == '' ? 0 : ocFreight.value) + parseFloat(Insurance == null || Insurance == '' ? 0 : Insurance.value));

                for (var row = 1; row < Grid_Table.rows.length - 1; row++) {

                    //  vat = parseFloat(vat) + parseFloat(Grid_Table.rows[row].cells[grdcellcount - 2].textContent.split("(")[0].replace(/[^0-9.]/g, ""));
                    total = parseFloat(total) + parseFloat(Grid_Table.rows[row].cells[grdcellcount].textContent.replace(/[^0-9.]/g, ""));
                    //totalkg = parseFloat(totalkg) + parseFloat(Grid_Table.rows[row].cells[6].textContent.replace(/[^0-9.]/g, ""));
                }
                //if (!Freight.value.length > 0) {
                //    Freight.value = 0;
                //}
                if (!Freight.value > 0) {
                    Freight.value = 0;
                }
                grandtoatal = vat + total + (Freight)

                //Grid_Table.rows[row].cells[grdcellcount].innerHTML = "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + parseFloat(Freight).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>" + "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + Math.round(grandtoatal).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>";
                Grid_Table.rows[row].cells[grdcellcount].innerHTML = "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + parseFloat(Freight).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>" + "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + (grandtoatal).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>";
                document.getElementById('<%=hftotalvat.ClientID%>').value = vat;
                document.getElementById('<%=hfgrandtotal.ClientID%>').value = grandtoatal - parseFloat(Freight.value);
                return false;

            }

        }

        //  strt
        function calculateFinalPrice1(txtquantity, hfkg) {
            debugger;
            var type = document.getElementById('<%=qtntype.ClientID%>').value
            var grdcellcount = $('.mT>tbody>tr>th').length - 1;
            if (type == "Domestic") {
                var txtquantity =  document.getElementById(txtquantity);//document.getElementById(txtquantity.replace('txtquantity', 'hfkg'))
                var hfPacking_Weight = document.getElementById(txtquantity.id.replace('txtquantity', 'hfkg'))
                var ltrate = document.getElementById(txtquantity.id.replace('txtquantity', 'ltrate'))
                var lblvat = document.getElementById(txtquantity.id.replace('txtquantity', 'lblvat'))
                var lblvatinrs = document.getElementById(txtquantity.id.replace('txtquantity', 'lblvatinrs'))
                var ltdisamount = document.getElementById(txtquantity.id.replace('txtquantity', 'ltdisamount'))
                var ltkg = document.getElementById(txtquantity.id.replace('txtquantity', 'ltkg'))
                var hfltamount = document.getElementById(txtquantity.id.replace('txtquantity', 'hfltamount'))
                var hflblvatinrs = document.getElementById(txtquantity.id.replace('txtquantity', 'hflblvatinrs'))

                //ltkg.textContent = hfPacking_Weight.value * txtquantity.value
                ltkg.textContent = parseFloat(hfPacking_Weight.value * txtquantity.value).toFixed(2);
                var amount = 0
                var vatinr = 0
                amount = parseFloat(ltrate.textContent.replace(/,/g, '')) * parseFloat(ltkg.textContent.replace(/,/g, ''));
                vatinr = amount * parseFloat(lblvat.textContent.replace(/,/g, '')) / 100;
                hfltamount.value = Math.round(amount);
                //hflblvatinrs.value = Math.round(vatinr);*****************MUBYN
                hflblvatinrs.value = (vatinr);
                ltdisamount.textContent = Math.round(parseFloat(ltrate.textContent.replace(/,/g, '')) * parseFloat(ltkg.textContent.replace(/,/g, ''))).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
                //lblvatinrs.textContent = Math.round(vatinr).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');*****************MUBYN
                lblvatinrs.textContent = (vatinr).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
                // Read_Data();

                ; debugger


                var total = 0;
                var vat = 0;
                var grandtoatal = 0;
                var totalkg = 0;
                var Grid_Table = document.getElementById('<%= grditemproduct.ClientID%>');
                var Freight = document.getElementById('<%= txtfreight.ClientID %>');
                for (var row = 1; row < Grid_Table.rows.length - 1; row++) {

                    vat = parseFloat(vat) + parseFloat(Grid_Table.rows[row].cells[grdcellcount - 2].textContent.split("(")[0].replace(/[^0-9.]/g, ""));
                    total = parseFloat(total) + parseFloat(Grid_Table.rows[row].cells[grdcellcount].textContent.replace(/[^0-9.]/g, ""));
                    totalkg = parseFloat(totalkg) + parseFloat(Grid_Table.rows[row].cells[6].textContent.replace(/[^0-9.]/g, ""));
                }
                if (!Freight.value.length > 0) {
                    Freight.value = 0;
                }
                var Freighttaxper = '<%= System.Configuration.ConfigurationManager.AppSettings("freightvalue").ToString()%>';
                var FreightAmt = parseFloat(Freight.value) * Freighttaxper / 100;

                grandtoatal = vat + total + parseFloat(Freight.value) + parseFloat(FreightAmt)
                //grandtoatal = vat + total + parseFloat(Freight.value)
                //  Grid_Table.rows[row].cells[6].innerHTML = "<b>" + totalkg + " Kg</b>";
                //Grid_Table.rows[row].cells[grdcellcount].innerHTML = "<b><i class='fa fa-rupee'></i> " + Math.round(vat + parseFloat(FreightAmt)).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>" + "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + parseFloat(Freight.value).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>" + "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + Math.round(grandtoatal).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>";**************MUBYN
                Grid_Table.rows[row].cells[grdcellcount].innerHTML = "<b><i class='fa fa-rupee'></i> " + (vat + parseFloat(FreightAmt)).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>" + "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + parseFloat(Freight.value).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>" + "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + Math.round(grandtoatal).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>";
                document.getElementById('<%=hftotalvat.ClientID%>').value = vat;
                document.getElementById('<%=hfgrandtotal.ClientID%>').value = grandtoatal - parseFloat(Freight.value);
                return false;
            }

            else {
                var txtquantity = document.getElementById(txtquantity);
                var hfPacking_Weight = document.getElementById(txtquantity.id.replace('txtquantity', 'hfkg'))
                var ltrate = document.getElementById(txtquantity.id.replace('txtquantity', 'ltrate'))
                var lblvat = 0// document.getElementById(txtquantity.id.replace('txtquantity', 'lblvat'))
                var lblvatinrs = 0//document.getElementById(txtquantity.id.replace('txtquantity', 'lblvatinrs'))
                var ltdisamount = document.getElementById(txtquantity.id.replace('txtquantity', 'ltdisamount'))
                var ltkg = document.getElementById(txtquantity.id.replace('txtquantity', 'ltkg'))
                var hfltamount = document.getElementById(txtquantity.id.replace('txtquantity', 'hfltamount'))
                //var hflblvatinrs = document.getElementById(txtquantity.id.replace('txtquantity', 'hflblvatinrs'))

                //ltkg.textContent = hfPacking_Weight.value * txtquantity.value
                ltkg.textContent = parseFloat(hfPacking_Weight.value * txtquantity.value).toFixed(2);
                var amount = 0
                var vatinr = 0
                amount = parseFloat(ltrate.textContent.replace(/,/g, '')) * parseFloat(ltkg.textContent.replace(/,/g, ''));

                //hfltamount.value = Math.round(amount);
                hfltamount.value = (amount);

                //ltdisamount.textContent = Math.round(parseFloat(ltrate.textContent.replace(/,/g, '')) * parseFloat(ltkg.textContent.replace(/,/g, ''))).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
                ltdisamount.textContent = (parseFloat(ltrate.textContent.replace(/,/g, '')) * parseFloat(ltkg.textContent.replace(/,/g, ''))).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
                lblvatinrs.textContent = 0
                //  Read_Data();
                ; debugger
                var total = 0;
                var vat = 0;
                var grandtoatal = 0;
                var totalkg = 0;
                var Grid_Table = document.getElementById('<%= grditemproduct.ClientID%>');
                var LocFreight = document.getElementById('<%= txtfreight.ClientID %>');
                var docclear = document.getElementById('<%= txtdocnclr.ClientID%>');
                var ocFreight = document.getElementById('<%= txtocfrei.ClientID%>');
                var Insurance = document.getElementById('<%= txtinsurance.ClientID%>');
                var Freight = (parseFloat(LocFreight == null || LocFreight == '' ? 0 : LocFreight.value) + parseFloat(docclear == null || docclear == '' ? 0 : docclear.value) + parseFloat(ocFreight == null || ocFreight == '' ? 0 : ocFreight.value) + parseFloat(Insurance == null || Insurance == '' ? 0 : Insurance.value));

                for (var row = 1; row < Grid_Table.rows.length - 1; row++) {

                    //  vat = parseFloat(vat) + parseFloat(Grid_Table.rows[row].cells[grdcellcount - 2].textContent.split("(")[0].replace(/[^0-9.]/g, ""));
                    total = parseFloat(total) + parseFloat(Grid_Table.rows[row].cells[grdcellcount].textContent.replace(/[^0-9.]/g, ""));
                    //totalkg = parseFloat(totalkg) + parseFloat(Grid_Table.rows[row].cells[6].textContent.replace(/[^0-9.]/g, ""));
                }
                //if (!Freight.value.length > 0) {
                //    Freight.value = 0;
                //}
                if (!Freight.value > 0) {
                    Freight.value = 0;
                }
                grandtoatal = vat + total + (Freight)

                //Grid_Table.rows[row].cells[grdcellcount].innerHTML = "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + parseFloat(Freight).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>" + "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + Math.round(grandtoatal).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>";
                Grid_Table.rows[row].cells[grdcellcount].innerHTML = "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + parseFloat(Freight).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>" + "<hr style='border: 0; border-top: 1px solid #eee; margin-top: 4px; margin-bottom: 4px;'>" + "<b><i class='fa fa-rupee'></i> " + (grandtoatal).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,') + "</b>";
                document.getElementById('<%=hftotalvat.ClientID%>').value = vat;
                document.getElementById('<%=hfgrandtotal.ClientID%>').value = grandtoatal - parseFloat(Freight.value);
                return false;

            }

        }
        //end
