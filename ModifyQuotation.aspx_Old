                                                                <asp:Button ID="Button4" runat="server" OnClientClick="if (!Page_ClientValidate('MasterGroupDisc')){ return false; } this.disabled = true; this.value = 'Saving...';"
                                                                    UseSubmitBehavior="false" class="btn btn-alt btn-primary" ValidationGroup="MasterGroupDisc" Text="Update" OnClick="btnupdatedisc_Click"></asp:Button>
