<%@ Page Title="" Language="VB" MasterPageFile="~/MainPage.master" AutoEventWireup="false" CodeFile="ModifyQuotation.aspx.vb" Inherits="ModifyQuotation" MaintainScrollPositionOnPostback="true" %>

<%@ Register TagPrefix="asp" Namespace="AjaxControlToolkit" Assembly="AjaxControlToolkit" %>
<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="Server">
    <script src="js/vendor/jquery-1.11.1.min.js"></script>
    <style>
        /*body{
            padding:0;
            margin:0;
            font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;

        }*/ .pd-b-10 {
            padding-bottom: 17px;
        }

        .btnCalC {
        }

        .calt {
            position: absolute;
            top: 0;
            left: 0;
            padding: 8px 12px;
            color: white;
        }

        .modal {
            display: none;
            position: fixed;
            z-index: 99999999;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.3);
        }

        .popup {
            position: fixed;
            z-index: 999999999;
            top: 25%;
            left: 35%;
            width: 30%;
            background: #f9f9f9;
            padding: 40px 25px 15px;
        }

            .popup ul {
                list-style-type: none;
                margin: 0;
                padding: 0;
            }

                .popup ul li {
                    margin: 15px 0;
                    float: left;
                    width: 88%;
                }

                    .popup ul li span {
                        margin-top: 8px;
                        float: left;
                    }

                    .popup ul li input {
                        float: right;
                    }
        /*.popup ul li:first-child input{
            margin-left:23px;
        }
        .popup ul li:nth-child(3)  span:first-child{
            margin-right:114px;
        }*/
        .close {
            position: absolute;
            top: 0;
            right: 0;
            padding: 8px 12px;
            color: white;
            font-weight: 700;
            cursor: pointer;
        }

        .pophead {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 40px;
            background: #7187d6;
        }
        /*.CalC{
            border:1px solid #1bbae1;
            background:none;
            padding:5px 10px;
            color:#1bbae1;
            cursor:pointer;
        }
        .CalC:hover{
            border:1px solid #1bbae1;
            background:#1bbae1;
            color:#fff;
        }*/
        .Calculate {
            background: none;
            padding: 5px 10px !important;
            margin: 0 20px 0 0;
            cursor: pointer;
        }

            .Calculate:first-child {
                border: 1px solid #1bbae1;
                color: #1bbae1;
            }

                .Calculate:first-child:hover {
                    border: 1px solid #1bbae1;
                    background: #1bbae1;
                    color: #fff;
                }

            .Calculate:last-child {
                border: 1px solid #e74c3c;
                color: #e74c3c;
            }

                .Calculate:last-child:hover {
                    border: 1px solid #e74c3c;
                    background: #e74c3c;
                    color: #fff;
                }
    </style>
    <script>
        $(document).ready(function () {
            $('.CalC').click(function () {
                $('.modal').css("display", "block");
            });
            $('.close').click(function () {
                $('.modal').removeAttr("style");
            });
            $('.close, .Calculate').click(function () {
                $('.reset').val('');
                $('.sclr').text('');
            });
        });

