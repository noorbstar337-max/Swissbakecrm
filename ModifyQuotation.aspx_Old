                                <div class="" id="divadditem" runat="server">
                                    <div class="panel-body">

                                        <asp:LinkButton ID="btnShow" Text="" runat="server" />
                                        <asp:LinkButton ID="btnShow1" Text="" runat="server" />
                                        <asp:LinkButton ID="btnopen" Text="Add Item" runat="server" class="btn btn-alt btn-xs btn-primary" />
                                        <asp:LinkButton ID="btndiscount" Text="Add Discount" runat="server" class="btn btn-alt btn-xs btn-primary" />
                                        <div id="divcalc" visible="false" runat="server" style="width: 45px; float: left; margin-left: 74px; margin-right: -132px;">
                                            <input type="button" runat="server" class="btn btn-alt btn-xs btn-warning CalC" value="Calculator" />
                                            <div style="position: fixed; z-index: 999999999;">
                                                <div class="modal">
                                                    <div class="popup">
                                                        <div class="pophead">
                                                            <span class="calt">Calculator</span>
                                                            <span class="close">X</span>
                                                        </div>
                                                        <ul>
                                                            <li>
                                                                <asp:Label runat="server" Text="Selling Price/KG $ :"></asp:Label><asp:TextBox ID="txtcalSP" onblur="this.value=this.value.replace(/[^0-9$.,]/g, '');calculatesp(this)" CssClass="reset" runat="server"></asp:TextBox>
                                                            </li>
                                                            <li>
                                                                <asp:Label runat="server" Text="Cost Price INR :"></asp:Label><asp:TextBox ID="txtcalCP" onblur="this.value=this.value.replace(/[^0-9$.,]/g, '');calculatecp(this)" CssClass="reset" runat="server"></asp:TextBox>
                                                            </li>
                                                            <%--<li>
																<asp:Label runat="server" text="3 Number :"></asp:Label><asp:TextBox ID="TextBox1" runat="server"></asp:TextBox>
																</li>--%>
                                                            <li>
                                                                <asp:Label runat="server" Text="Margin % :"></asp:Label><asp:Label runat="server" ID="lblcalmargin" CssClass="sclr" Style="margin-left: 90px;"></asp:Label>
                                                            </li>
                                                            <li>
                                                                <%--<asp:Button runat="server" ID="btnCalculate" CssClass="Calculate" Text="Submit"/>--%>
                                                                <button type="button" class="Calculate">Reset</button>
                                                            </li>
                                                        </ul>

                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <br />
                                        <br />
                                        <asp:UpdatePanel ID="UpdatePanel2" runat="server" UpdateMode="Always">
                                            <ContentTemplate>
                                                <asp:HiddenField ID="hftotalvat" runat="server" />
                                                <asp:HiddenField ID="hfgrandtotal" runat="server" />
                                                <div class="table-responsive">
                                                    <asp:GridView ID="grditemproduct" ShowFooter="true" GridLines="None" CssClass="table table-striped table-vcenter mT" HeaderStyle-Width="100" HeaderStyle-Font-Bold="true" HeaderStyle-Font-Size="Smaller" CellPadding="0" CellSpacing="0" runat="server" AutoGenerateColumns="false">
                                                        <Columns>
                                                            <asp:TemplateField ItemStyle-Width="" HeaderStyle-CssClass="" ItemStyle-CssClass="">
                                                                <HeaderTemplate>
                                                                    <asp:HyperLink ID="HyperLink1" runat="server"></asp:HyperLink>
                                                                </HeaderTemplate>
                                                                <ItemTemplate>
                                                                    <div class="btn-group btn-group-xs">
                                                                        <asp:LinkButton ID="lnkdelete" data-toggle="tooltip" title="Delete" class="btn btn-xs btn-danger" runat="server" OnClientClick="checkdelete();"
                                                                            CommandName="deletelink" CommandArgument="<%# CType(Container,GridViewRow).RowIndex %>">Delete</asp:LinkButton>
                                                                    </div>
                                                                </ItemTemplate>
                                                            </asp:TemplateField>
                                                            <asp:TemplateField HeaderText="Product Name" HeaderStyle-CssClass="" ItemStyle-CssClass="">
                                                                <HeaderTemplate>
                                                                    <asp:HyperLink ID="HyperLink11" runat="server">Product Name</asp:HyperLink>
                                                                </HeaderTemplate>
                                                                <ItemTemplate>
                                                                    <asp:Label ID="ltproductname" runat="server" Text='<%#Eval("Product_Name")%>'></asp:Label>
                                                                    <asp:Label ID="ltProductId" runat="server" Text='<%#Eval("ProductId")%>' Visible="false"></asp:Label>
                                                                </ItemTemplate>
                                                            </asp:TemplateField>

                                                            <asp:TemplateField HeaderText="Product Code" HeaderStyle-CssClass="" ItemStyle-CssClass="">
                                                                <HeaderTemplate>
                                                                    <asp:HyperLink ID="HyperLink12" runat="server">Product Code</asp:HyperLink>
                                                                </HeaderTemplate>
                                                                <ItemTemplate>
                                                                    <asp:Label ID="ltproductcode" runat="server" Text='<%#Eval("Product_Code")%>'></asp:Label>
                                                                </ItemTemplate>
                                                            </asp:TemplateField>
                                                            <asp:TemplateField HeaderText="SKU" HeaderStyle-CssClass="" ItemStyle-CssClass="">
                                                                <HeaderTemplate>
                                                                    <asp:HyperLink ID="HyperLink13" runat="server">SKU</asp:HyperLink>
                                                                </HeaderTemplate>
                                                                <ItemTemplate>
                                                                    <asp:Label ID="ltproductWeight" runat="server" Text='<%#Eval("Packing_Weight")%>' Visible="false"></asp:Label>
                                                                    <asp:Label ID="ltpackingpacking" runat="server" Text='<%#Eval("Packing_Packing")%>'></asp:Label>
                                                                    <asp:HiddenField ID="hfkg" runat="server" Value='<%#Eval("Packing_Weight")%>' />
                                                                </ItemTemplate>
                                                            </asp:TemplateField>
                                                            <asp:TemplateField HeaderText="Rate" HeaderStyle-CssClass="" ItemStyle-CssClass="">
                                                                <HeaderTemplate>
                                                                    <asp:HyperLink ID="HyperLink15" runat="server">Rate/kg</asp:HyperLink>
                                                                </HeaderTemplate>
                                                                <ItemTemplate>
                                                                    <i class="fa fa-rupee"></i>&nbsp;
                                                                         
                                                                              <asp:Label ID="ltproductrate" runat="server" Text='<%#Eval("Product_Rate")%>'></asp:Label>
                                                                </ItemTemplate>
