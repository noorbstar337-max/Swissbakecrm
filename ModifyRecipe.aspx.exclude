<%@ Page Title="" Language="VB" MasterPageFile="~/LMSMasterPage.master" AutoEventWireup="false" CodeFile="ModifyRecipe.aspx.vb" Inherits="ModifyRecipe" %>

<%@ Register TagPrefix="asp" Namespace="AjaxControlToolkit" Assembly="AjaxControlToolkit" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="Server">
    <script src="js/jquery.min.js"></script>
    <script type="text/javascript">
        function Validate() {
            var isValid = false;
            isValid = Page_ClientValidate('MasterGroup2');
            //if (isValid) {
            //    isValid = Page_ClientValidate('MasterGroupRecipe');
            //}
            //if (isValid) {
            //    isValid = Page_ClientValidate('MasterGroupProc');
            //}
            return isValid;
        }
        function ValidateWithGrid() {
            var isValid = false;
            isValid = Page_ClientValidate('MasterGroup2');
            if (isValid) {
                isValid = Page_ClientValidate('MasterGroupRecipe');
            }
            if (isValid) {
                isValid = Page_ClientValidate('MasterGroupProc');
            }
            return isValid;
        }
    </script>

</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder2" runat="Server">
</asp:Content>
