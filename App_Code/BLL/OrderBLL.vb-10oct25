Public Class OrderBLL
    Private Shared _spname As String = "_spOrder"
    
    Public Shared Function UpdateOrder(ByVal Order_ID As Integer, ByVal Order_OrderStatus As String, ByVal Order_ModifiedID As Integer,
                                       ByVal Order_PoNo As String, ByVal Order_PoDate As String) As Integer
        Dim sqlparams(6) As SqlParameter
        Try
            sqlparams(0) = New SqlParameter("@Mode", "UpdateOrder")
            sqlparams(1) = New SqlParameter("@Order_ID", Order_ID)
            sqlparams(2) = New SqlParameter("@Order_OrderStatus", Order_OrderStatus)
            sqlparams(4) = New SqlParameter("@Order_ModifiedID", Order_ModifiedID)
            sqlparams(5) = New SqlParameter("@Order_PoNo", Order_PoNo)
            sqlparams(6) = New SqlParameter("@Order_PoDate", Order_PoDate)
            Return DBBridge.ExecuteNonQuery(_spname, sqlparams)
        Catch ex As Exception
            Throw ex
        End Try
    End Function

    Public Shared Function UpdateAddress(ByVal Address_Cust_Name As String, ByVal Address_Cust_Mobile As String, ByVal Address_Cust_Email As String, ByVal Address_Country As String, ByVal Address_State As String, ByVal Address_City As String, ByVal Address_Pincode As String,
                                         ByVal Address_Address As String, ByVal Address_CustId As Integer, ByVal Address_Type As String, ByVal Address_ModifiedID As Integer) As Integer
        Dim sqlparams(11) As SqlParameter
        Try
            sqlparams(0) = New SqlParameter("@Mode", "UpdateAddress")
