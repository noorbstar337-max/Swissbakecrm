             ByVal _Order_ModeofPayment As String, ByVal _Order_TotalVat As Double, ByVal _Order_Freight As String, ByVal _Order_CreatedID As Integer, ByVal Order_PoNo As String,
             ByVal Order_PoDate As String, ByVal Order_CreatedDate As String, ByVal Order_TermsDelivery As String, ByVal Order_TermsPayment As String, ByVal Order_Dispach As String,
