    Public Shared Function UpdateCRMSalesOrder(ByVal Order_ID As Integer, ByVal Order_PoNo As String, ByVal Order_PoDate As String, ByVal Order_ModeofPayment As String,
                                               ByVal Order_ModifiedID As Integer, ByVal Order_CreatedDate As String, ByVal Order_TermsDelivery As String,
                                               ByVal Order_TermsPayment As String, ByVal Order_Dispach As String, ByVal _Order_Freight As String, ByVal Order_Billedfrom As Integer) As Integer
        Dim sqlparams(11) As SqlParameter
        Try
            sqlparams(0) = New SqlParameter("@Mode", "UpdateCRMSalesOrder")
            sqlparams(1) = New SqlParameter("@Order_ID", Order_ID)
            sqlparams(2) = New SqlParameter("@Order_PoNo", Order_PoNo)
            If Not String.IsNullOrEmpty(Order_PoDate) Then
                sqlparams(3) = New SqlParameter("@Order_PoDate", Order_PoDate)
            Else
                sqlparams(3) = New SqlParameter("@Order_PoDate", DBNull.Value)
            End If
            sqlparams(4) = New SqlParameter("@Order_ModeofPayment", Order_ModeofPayment)
            sqlparams(5) = New SqlParameter("@Order_ModifiedID", Order_ModifiedID)
            If Not String.IsNullOrEmpty(Order_CreatedDate) Then
                sqlparams(6) = New SqlParameter("@Order_CreatedDate", Order_CreatedDate)
            Else
                sqlparams(6) = New SqlParameter("@Order_CreatedDate", DBNull.Value)
            End If
            sqlparams(7) = New SqlParameter("@Order_TermsDelivery", Order_TermsDelivery)
            sqlparams(8) = New SqlParameter("@Order_TermsPayment", Order_TermsPayment)
            sqlparams(9) = New SqlParameter("@Order_Dispach", Order_Dispach)
            If String.IsNullOrEmpty(_Order_Freight) Then
                sqlparams(10) = New SqlParameter("@Order_Freight", "0")
            Else
                sqlparams(10) = New SqlParameter("@Order_Freight", _Order_Freight)
            End If
            sqlparams(11) = New SqlParameter("@Order_Billedfrom", Order_Billedfrom)
            Return DBBridge.ExecuteNonQuery(_spname, sqlparams)
        Catch ex As Exception
            Throw ex
        End Try
    End Function

    Public Shared Function UpdateCRMSalesOrderF(ByVal Order_ID As Integer, ByVal Order_PoNo As String, ByVal Order_PoDate As String, ByVal Order_ModeofPayment As String,
                                             ByVal Order_ModifiedID As Integer, ByVal Order_CreatedDate As String, ByVal Order_TermsDelivery As String,
                                             ByVal Order_TermsPayment As String, ByVal Order_Dispach As String, ByVal _Order_Freight As String, ByVal Order_Billedfrom As Integer,
                                             ByVal Freighttax As Double, ByVal _Order_Amount As Double, ByVal _Order_TotalVat As Double,
                                             ByVal Order_PrintIn As String, ByVal BankId As Integer) As Integer
        Dim sqlparams(16) As SqlParameter
        Try
            sqlparams(0) = New SqlParameter("@Mode", "UpdateCRMSalesOrderF")
            sqlparams(1) = New SqlParameter("@Order_ID", Order_ID)
            sqlparams(2) = New SqlParameter("@Order_PoNo", Order_PoNo)
            If Not String.IsNullOrEmpty(Order_PoDate) Then
                sqlparams(3) = New SqlParameter("@Order_PoDate", Order_PoDate)
            Else
                sqlparams(3) = New SqlParameter("@Order_PoDate", DBNull.Value)
            End If
            sqlparams(4) = New SqlParameter("@Order_ModeofPayment", Order_ModeofPayment)
            sqlparams(5) = New SqlParameter("@Order_ModifiedID", Order_ModifiedID)
            If Not String.IsNullOrEmpty(Order_CreatedDate) Then
                sqlparams(6) = New SqlParameter("@Order_CreatedDate", Order_CreatedDate)
            Else
                sqlparams(6) = New SqlParameter("@Order_CreatedDate", DBNull.Value)
            End If
            sqlparams(7) = New SqlParameter("@Order_TermsDelivery", Order_TermsDelivery)
            sqlparams(8) = New SqlParameter("@Order_TermsPayment", Order_TermsPayment)
            sqlparams(9) = New SqlParameter("@Order_Dispach", Order_Dispach)
            If String.IsNullOrEmpty(_Order_Freight) Then
                sqlparams(10) = New SqlParameter("@Order_Freight", "0")
            Else
                sqlparams(10) = New SqlParameter("@Order_Freight", _Order_Freight)
            End If
            sqlparams(11) = New SqlParameter("@Order_Billedfrom", Order_Billedfrom)
            sqlparams(12) = New SqlParameter("@Order_FreightTaxPer", Freighttax)
            sqlparams(13) = New SqlParameter("@Order_Amount", _Order_Amount)
            sqlparams(14) = New SqlParameter("@Order_TotalVat", _Order_TotalVat)
            sqlparams(15) = New SqlParameter("@Order_PrintIn", Order_PrintIn)
			sqlparams(16) = New SqlParameter("@BankId", BankId)
            Return DBBridge.ExecuteNonQuery(_spname, sqlparams)
        Catch ex As Exception
            Throw ex
        End Try
    End Function
