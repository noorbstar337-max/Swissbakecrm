	Public Shared Function InsertCRM(ByVal _Order_Code As String, ByVal _Order_CustId As Integer, ByVal _Order_Amount As Double, ByVal _Order_OrderStatus As String,
				ByVal _Order_ModeofPayment As String, ByVal _Order_TotalVat As Double, ByVal _Order_Freight As String, ByVal _Order_CreatedID As Integer, ByVal Order_PoNo As String,
				ByVal Order_PoDate As String, ByVal Order_CreatedDate As String, ByVal Order_TermsDelivery As String, ByVal Order_TermsPayment As String, ByVal Order_Dispach As String, ByVal Order_Billedfrom As Integer) As Integer
		Dim sqlparams(15) As SqlParameter
		Try
			sqlparams(0) = New SqlParameter("@Mode", "CrmInsert")
			sqlparams(1) = New SqlParameter("@Order_Code", _Order_Code)
			sqlparams(2) = New SqlParameter("@Order_CustId", _Order_CustId)
			sqlparams(3) = New SqlParameter("@Order_Amount", _Order_Amount)
			sqlparams(4) = New SqlParameter("@Order_OrderStatus", _Order_OrderStatus)
			sqlparams(5) = New SqlParameter("@Order_ModeofPayment", _Order_ModeofPayment)
			sqlparams(6) = New SqlParameter("@Order_TotalVat", _Order_TotalVat)
			If String.IsNullOrEmpty(_Order_Freight) Then
				sqlparams(7) = New SqlParameter("@Order_Freight", "0")
			Else
				sqlparams(7) = New SqlParameter("@Order_Freight", _Order_Freight)
			End If
			sqlparams(8) = New SqlParameter("@Order_CreatedID", _Order_CreatedID)
			sqlparams(9) = New SqlParameter("@Order_PoNo", Order_PoNo)
			If Not String.IsNullOrEmpty(Order_PoDate) Then
				sqlparams(10) = New SqlParameter("@Order_PoDate", Order_PoDate)
			Else
				sqlparams(10) = New SqlParameter("@Order_PoDate", DBNull.Value)
			End If
			If Not String.IsNullOrEmpty(Order_CreatedDate) Then
				sqlparams(11) = New SqlParameter("@Order_CreatedDate", Order_CreatedDate)
			Else
				sqlparams(11) = New SqlParameter("@Order_CreatedDate", DBNull.Value)
			End If
			sqlparams(12) = New SqlParameter("@Order_TermsDelivery", Order_TermsDelivery)
			sqlparams(13) = New SqlParameter("@Order_TermsPayment", Order_TermsPayment)
			sqlparams(14) = New SqlParameter("@Order_Dispach", Order_Dispach)
			sqlparams(15) = New SqlParameter("@Order_Billedfrom", Order_Billedfrom)
			Return DBBridge.ExecuteScalar(_spname, sqlparams)
		Catch ex As Exception
			Throw ex
		End Try
	End Function
    Public Shared Function InsertCRMF(ByVal _Order_Code As String, ByVal _Order_CustId As Integer, ByVal _Order_Amount As Double, ByVal _Order_OrderStatus As String,
                ByVal _Order_ModeofPayment As String, ByVal _Order_TotalVat As Double, ByVal _Order_Freight As String, ByVal _Order_CreatedID As Integer, ByVal Order_PoNo As String,
                ByVal Order_PoDate As String, ByVal Order_CreatedDate As String, ByVal Order_TermsDelivery As String, ByVal Order_TermsPayment As String,
                ByVal Order_Dispach As String, ByVal Order_Billedfrom As Integer, ByVal Order_FreightTaxPer As Double, ByVal Order_PrintIn As String,
				ByVal BankId As Integer, ByVal TcsAmount As Double) As Integer
        '========== new parameter Order_PrintIn added by MUBYN
        Dim sqlparams(19) As SqlParameter
        Try
            sqlparams(0) = New SqlParameter("@Mode", "CrmInsertf")
            sqlparams(1) = New SqlParameter("@Order_Code", _Order_Code)
            sqlparams(2) = New SqlParameter("@Order_CustId", _Order_CustId)
            sqlparams(3) = New SqlParameter("@Order_Amount", _Order_Amount)
            sqlparams(4) = New SqlParameter("@Order_OrderStatus", _Order_OrderStatus)
            sqlparams(5) = New SqlParameter("@Order_ModeofPayment", _Order_ModeofPayment)
            sqlparams(6) = New SqlParameter("@Order_TotalVat", _Order_TotalVat)
            If String.IsNullOrEmpty(_Order_Freight) Then
                sqlparams(7) = New SqlParameter("@Order_Freight", "0")
            Else
                sqlparams(7) = New SqlParameter("@Order_Freight", _Order_Freight)
            End If
            sqlparams(8) = New SqlParameter("@Order_CreatedID", _Order_CreatedID)
            sqlparams(9) = New SqlParameter("@Order_PoNo", Order_PoNo)
            If Not String.IsNullOrEmpty(Order_PoDate) Then
                sqlparams(10) = New SqlParameter("@Order_PoDate", Order_PoDate)
            Else
                sqlparams(10) = New SqlParameter("@Order_PoDate", DBNull.Value)
            End If
            If Not String.IsNullOrEmpty(Order_CreatedDate) Then
                sqlparams(11) = New SqlParameter("@Order_CreatedDate", Order_CreatedDate)
            Else
                sqlparams(11) = New SqlParameter("@Order_CreatedDate", DBNull.Value)
            End If
            sqlparams(12) = New SqlParameter("@Order_TermsDelivery", Order_TermsDelivery)
            sqlparams(13) = New SqlParameter("@Order_TermsPayment", Order_TermsPayment)
            sqlparams(14) = New SqlParameter("@Order_Dispach", Order_Dispach)
            sqlparams(15) = New SqlParameter("@Order_Billedfrom", Order_Billedfrom)
            sqlparams(16) = New SqlParameter("@Order_FreightTaxPer", Order_FreightTaxPer)
            sqlparams(17) = New SqlParameter("@Order_PrintIn", Order_PrintIn)
			sqlparams(18) = New SqlParameter("@BankId", BankId)
            sqlparams(19) = New SqlParameter("@Tcs_Amount", TcsAmount)
            Return DBBridge.ExecuteScalar(_spname, sqlparams)
        Catch ex As Exception
            Throw ex
        End Try
    End Function

