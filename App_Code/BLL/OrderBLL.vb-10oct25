            sqlparams(4) = New SqlParameter("@Address_Country", Address_Country)
            sqlparams(5) = New SqlParameter("@Address_State", Address_State)
            sqlparams(6) = New SqlParameter("@Address_City", Address_City)
            sqlparams(7) = New SqlParameter("@Address_Pincode", Address_Pincode)
            sqlparams(8) = New SqlParameter("@Address_Address", Address_Address)
            sqlparams(9) = New SqlParameter("@Address_CustId", Address_CustId)
            sqlparams(10) = New SqlParameter("@Address_Type", Address_Type)
            sqlparams(11) = New SqlParameter("@Address_ModifiedID", Address_ModifiedID)
            Return DBBridge.ExecuteNonQuery("_spCustomerAddress", sqlparams)
        Catch ex As Exception
            Throw ex
        End Try
    End Function

    Public Shared Function Insert(ByVal _Order_Code As String, ByVal _Order_CustId As Integer, ByVal _Order_Amount As Integer, ByVal _Order_OrderStatus As String, ByVal _Order_ModeofPayment As String, ByVal _Order_TotalVat As String, ByVal _Order_Freight As String) As Integer
