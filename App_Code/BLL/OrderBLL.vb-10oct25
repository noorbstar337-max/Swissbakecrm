    Public Shared Function InsertQuotationOrderE(ByVal _Order_Code As String, ByVal _Order_CustId As Integer, ByVal _Order_Amount As Double, ByVal _Order_OrderStatus As String,
               ByVal _Order_ModeofPayment As String, ByVal _Order_TotalVat As Double, ByVal _Order_Freight As String, ByVal _Order_CreatedID As Integer, ByVal Order_PoNo As String,
               ByVal Order_PoDate As String, ByVal Order_CreatedDate As String, ByVal Order_TermsDelivery As String, ByVal Order_TermsPayment As String, ByVal Order_Dispach As String, ByVal Order_Billedfrom As Integer,
               ByVal Order_isQuotaionId As Integer, ByVal Currency As String, ByVal CurrencyRate As Double,
             ByVal ModeOfTransport As String, ByVal CountryOfOrigin As String, ByVal CountryOfFinalDestination As String, ByVal PortOfLoading As String,
        ByVal PortOfDischarge As String, ByVal FinalDestination As String, ByVal Order_TrmsPyt_Card_doc As String, ByVal Order_Doc_Clearance As Double,
                                                ByVal Order_OceanFreight As Double, ByVal Order_Insurance As Double, ByVal Order_WithFreight As String,
                                                ByVal Order_PrintIn As String) As Integer
        Dim sqlparams(32) As SqlParameter
        Try
            sqlparams(0) = New SqlParameter("@Mode", "CrmInsert")
            sqlparams(1) = New SqlParameter("@Order_Code", _Order_Code)
            sqlparams(2) = New SqlParameter("@Order_CustId", _Order_CustId)
            sqlparams(3) = New SqlParameter("@Order_Amount", _Order_Amount)
            sqlparams(4) = New SqlParameter("@Order_OrderStatus", _Order_OrderStatus)
            sqlparams(5) = New SqlParameter("@Order_ModeofPayment", _Order_ModeofPayment)
            sqlparams(6) = New SqlParameter("@Order_TotalVat", _Order_TotalVat)
            If String.IsNullOrEmpty(_Order_Freight) Then
                sqlparams(7) = New SqlParameter("@Order_Freight", "0")
            Else
                sqlparams(7) = New SqlParameter("@Order_Freight", _Order_Freight.Replace(",", ""))
            End If
            sqlparams(8) = New SqlParameter("@Order_CreatedID", _Order_CreatedID)
            sqlparams(9) = New SqlParameter("@Order_PoNo", Order_PoNo)
            If Not String.IsNullOrEmpty(Order_PoDate) Then
                sqlparams(10) = New SqlParameter("@Order_PoDate", Order_PoDate)
            Else
                sqlparams(10) = New SqlParameter("@Order_PoDate", DBNull.Value)
            End If
            If Not String.IsNullOrEmpty(Order_CreatedDate) Then
                sqlparams(11) = New SqlParameter("@Order_CreatedDate", Order_CreatedDate)
            Else
                sqlparams(11) = New SqlParameter("@Order_CreatedDate", DBNull.Value)
            End If
            sqlparams(12) = New SqlParameter("@Order_TermsDelivery", Order_TermsDelivery)
            sqlparams(13) = New SqlParameter("@Order_TermsPayment", Order_TermsPayment)
            sqlparams(14) = New SqlParameter("@Order_Dispach", Order_Dispach)
            sqlparams(15) = New SqlParameter("@Order_Billedfrom", Order_Billedfrom)
            If Not String.IsNullOrEmpty(Order_isQuotaionId) Then
                sqlparams(16) = New SqlParameter("@Order_isQuotaionId", Order_isQuotaionId)
            Else
                sqlparams(16) = New SqlParameter("@Order_isQuotaionId", DBNull.Value)
            End If

            sqlparams(17) = New SqlParameter("@Order_CurrencyRate", CurrencyRate)
            'sqlparams(18) = New SqlParameter("@Order_TermsOfPayment", TermsOfPayment)
            sqlparams(19) = New SqlParameter("@Order_ModeOfTransport", ModeOfTransport)
            sqlparams(20) = New SqlParameter("@Order_CountryOfOrigin", CountryOfOrigin)
            sqlparams(21) = New SqlParameter("@Order_CountryOfFinalDestination", CountryOfFinalDestination)
            sqlparams(22) = New SqlParameter("@Order_PortOfLoading", PortOfLoading)
            sqlparams(23) = New SqlParameter("@Order_PortOfDischarge", PortOfDischarge)
            sqlparams(24) = New SqlParameter("@Order_FinalDestination", FinalDestination)
            sqlparams(25) = New SqlParameter("@Order_TrmsPyt_Card_doc", Order_TrmsPyt_Card_doc)
            sqlparams(26) = New SqlParameter("@Order_Currency", Currency)
            sqlparams(27) = New SqlParameter("@Order_Doc_Clearance", Order_Doc_Clearance)
            sqlparams(28) = New SqlParameter("@Order_OceanFreight", Order_OceanFreight)
            sqlparams(29) = New SqlParameter("@Order_Insurance", Order_Insurance)
            sqlparams(30) = New SqlParameter("@Order_WithFreight", Order_WithFreight)
            sqlparams(31) = New SqlParameter("@Order_PrintIn", Order_PrintIn)

            Return DBBridge.ExecuteScalar(_spname, sqlparams)
        Catch ex As Exception
            Throw ex
        End Try
    End Function
