            'sqlparams(18) = New SqlParameter("@Order_TermsOfPayment", TermsOfPayment)
            sqlparams(19) = New SqlParameter("@Order_ModeOfTransport", ModeOfTransport)
            sqlparams(20) = New SqlParameter("@Order_CountryOfOrigin", CountryOfOrigin)
