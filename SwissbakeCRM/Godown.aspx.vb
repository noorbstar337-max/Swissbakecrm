    Protected Sub GridView1_RowCommand(sender As Object, e As GridViewCommandEventArgs) Handles GridView1.RowCommand
        If e.CommandName = "deletelink" Then
            If deletestatus.Value = "yes" Then
                Dim index As Integer = Convert.ToInt32(e.CommandArgument)
                MainId = GridView1.DataKeys(index).Value
                Try
                    MainBLL.DeleteSI(MainId, Session("UserId"), "DeleteGodown", Session("Audlog_Id"))
                    IndexfillUser()
                Catch ex As Exception
                    Dim error1 As String = ex.Message.Replace(Chr(34), "")
                    error1 = error1.Replace(Chr(39), "")
                    ExecptionBLL.Insert("Godown", "deletelink", error1, Session("UserId"))
                    ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
                End Try
            Else
                If SearchControl.UtxtSearch.Text.Trim = "" Then
                    IndexfillUser()
                Else
                    SearchFillUser()
                End If
            End If

        ElseIf e.CommandName = "statuslink" Then
            Dim index As Integer = Convert.ToInt32(e.CommandArgument)
            MainId = GridView1.DataKeys(index).Value
            Try
                MainBLL.UpdateStatus(MainId, Session("UserId"), "GodownStatus", Session("Audlog_Id"))
                If SearchControl.UtxtSearch.Text.Trim = "" Then
                    IndexfillUser()
                Else
                    SearchFillUser()
                End If
            Catch ex As Exception
                Dim error1 As String = ex.Message.Replace(Chr(34), "")
                error1 = error1.Replace(Chr(39), "")
                ExecptionBLL.Insert("Godown", "statuslink", error1, Session("UserId"))
                ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
            End Try
        ElseIf e.CommandName = "addlink" Then
            Try
                txtgodname.Text = ""
                txtgodaddress.Text = ""
                txtgodCPName.Text = ""
                txtgodCPMobile.Text = ""
                txtgodCPEmail.Text = ""
                mpe.Enabled = True
                mpe.Show()
                hfcheck.Value = 0
            Catch ex As Exception
                Dim error1 As String = ex.Message.Replace(Chr(34), "")
                error1 = error1.Replace(Chr(39), "")
                ExecptionBLL.Insert("Godown", "addlink", error1, Session("UserId"))
                ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
            End Try
        ElseIf e.CommandName = "editlink" Then
            lblheading.Text = "Modify Godown"
            txtgodname.Focus()
            lblname1.Text = ""
            Dim index As Integer = Convert.ToInt32(e.CommandArgument)
            MainId = GridView1.DataKeys(index).Value
            hfcheck.Value = MainId
            Dim row As GridViewRow = GridView1.Rows(index)
            Try
                mpe.Enabled = True
                mpe.Show()
                Dim dt As DataSet = GodownBLL.GetGodwonById(MainId)

                '    Dim lblname As Literal = DirectCast(GridView1.Rows(row.RowIndex).FindControl("lblname"), Literal)
                '  Dim lbladd As Literal = DirectCast(GridView1.Rows(row.RowIndex).FindControl("lblAddress"), Literal)
                txtgodname.Text = dt.Tables(0).Rows(0)("Godown_Name").ToString()                        'lblname.Text
                txtgodaddress.Text = dt.Tables(0).Rows(0)("Godown_Address").ToString()                  'lbladd.Text
                txtgodCPName.Text = dt.Tables(0).Rows(0)("Godown_ContactPerson").ToString()
                txtgodCPMobile.Text = dt.Tables(0).Rows(0)("Godown_Mobile").ToString()
                txtgodCPEmail.Text = dt.Tables(0).Rows(0)("Godown_Email").ToString()
                CHKFactory.Checked = dt.Tables(0).Rows(0)("Godown_Factory").ToString()
                'If chk = 1 Then
                '    CHKFactory.Checked = True
                'Else
                '    CHKFactory.Checked = False
                'End If
                hfchanged.Value = txtgodname.Text
                'hfchanged.Value = lbladd.Text
            Catch ex As Exception
                Dim error1 As String = ex.Message.Replace(Chr(34), "")
                error1 = error1.Replace(Chr(39), "")
                ExecptionBLL.Insert("Godown", "editlink", error1, Session("UserId"))
                ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
            End Try
        End If

    End Sub

