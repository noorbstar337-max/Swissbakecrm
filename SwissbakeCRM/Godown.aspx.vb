    Protected Sub Button1_Click(sender As Object, e As EventArgs) Handles btnsave.Click
        Try
            If hfcheck.Value = 0 Then
                SaveProduct(DML_OPERATION.INSERT)
            ElseIf hfcheck.Value > 0 Then
                SaveProduct(DML_OPERATION.UPDATE)
            End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("Godown", "Button1_Click", error1, Session("UserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub

    Private Sub SaveProduct(ByVal enumOperation As DML_OPERATION)
        If CHKFactory.Checked = True Then
            chk = 1
        Else
            chk = 0
        End If
        Select Case enumOperation
            Case DML_OPERATION.UPDATE
                Try
                    Dim CheckPageName As String = ""
                    If Not txtgodname.Text = hfchanged.Value Then
                        CheckPageName = MainBLL.CheckPageName(txtgodname.Text.Trim, "GodownNameCheck")
                    End If
                    If (CheckPageName = "Already Exist") Then
                        lblname1.Text = "Godown already exist"
                        txtgodname.Focus()
                        godreq1.Display = ValidatorDisplay.Dynamic
                        mpe.Show()
                    Else
                        lblname1.Text = ""
                        godreq1.Display = ValidatorDisplay.Static
                        GodownBLL.Update(txtgodname.Text, txtgodaddress.Text, Session("UserId"), "", hfcheck.Value, txtgodCPName.Text, txtgodCPMobile.Text, txtgodCPEmail.Text, chk)
                        fillGodown()
                        mpe.Hide()
                        Response.Redirect(Request.RawUrl)
                    End If

                Catch ex As Exception
                    Dim error1 As String = ex.Message.Replace(Chr(34), "")
                    error1 = error1.Replace(Chr(39), "")
                    ExecptionBLL.Insert("Godown", "UPDATE", error1, Session("UserId"))
                    ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
                End Try
            Case DML_OPERATION.INSERT
                Try
                    Dim CheckPageName As String = MainBLL.CheckPageName(txtgodname.Text.Trim, "GodownNameCheck")
                    If (CheckPageName = "Already Exist") Then
                        lblname1.Text = "Godown name  already exist"
                        txtgodname.Focus()
                        godreq1.Display = ValidatorDisplay.Dynamic

                        mpe.Show()
                    Else
                        lblname1.Text = ""
                        godreq1.Display = ValidatorDisplay.Static
                        GodownBLL.Insert(txtgodname.Text, txtgodaddress.Text, Session("UserId"), "Admin", txtgodCPName.Text, txtgodCPMobile.Text, txtgodCPEmail.Text, chk)
                        GridView1.PageIndex = GridView1.PageIndex
                        fillGodown()
                        mpe.Hide()
                        Response.Redirect(Request.RawUrl)
                    End If
                Catch ex As Exception
                    Dim error1 As String = ex.Message.Replace(Chr(34), "")
                    error1 = error1.Replace(Chr(39), "")
                    ExecptionBLL.Insert("Godown", "INSERT", error1, Session("UserId"))
                    ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
                End Try
        End Select
    End Sub

    Protected Sub GridView1_Sorting(sender As Object, e As GridViewSortEventArgs)
        SetSortDirection(SortDireaction)
        Try
            Dim dt As DataSet = MainBLL.SortingGridView("GodownSorting")
            Dim DataTable As DataTable = dt.Tables(0)
            If DataTable IsNot Nothing Then
                DataTable.DefaultView.Sort = Convert.ToString(e.SortExpression) & " " & _sortDirection
                GridView1.DataSource = DataTable
                GridView1.DataBind()
                SortDireaction = _sortDirection
                Dim columnIndex As Integer = 0
                For Each headerCell As DataControlFieldHeaderCell In GridView1.HeaderRow.Cells
                    If headerCell.ContainingField.SortExpression = e.SortExpression Then
                        columnIndex = GridView1.HeaderRow.Cells.GetCellIndex(headerCell)
                    End If
                Next
                GridView1.HeaderRow.Cells(columnIndex).Controls.Add(sortImage)
            End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("Godown", "GridView1_Sorting", error1, Session("UserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
