<%@ Page Language="VB" AutoEventWireup="false" CodeFile="View_EmailPO.aspx.vb" Inherits="View_EmailPO" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head>
    <title></title>


    <script type="text/javascript">
        function printDiv(divID) {
            //Get the HTML of div
            var divElements = document.getElementById(divID).innerHTML;
            //Get the HTML of whole page
            var oldPage = document.body.innerHTML;

            //Reset the page's HTML with div's HTML only
            document.body.innerHTML = "<html><head></head><body>" + divElements + "</body>";

            //Print Page
            window.print();

            //Restore orignal HTML
            document.body.innerHTML = oldPage;
            function Redirect() {
                window.location = "/polist.aspx";
            }
        }
    </script>
      <script type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script type="text/javascript" src="http://cdn.rawgit.com/niklasvh/html2canvas/master/dist/html2canvas.min.js"></script>
    <script type="text/javascript">
        function ConvertToImage(btnExport) {
            ;debugger
            html2canvas($("#dvTable")[0]).then(function (canvas) {
                var base64 = canvas.toDataURL();
                $("[id*=hfImageData]").val(base64);
                __doPostBack(btnExport.name, "");
            });
            return false;
        }
</script>
     <script type="text/javascript">
         $(document).ready(function () {     
             ;debugger
             $("#btnExport1").click();
           
         });</script>
    <%-- <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.1.0/jquery.min.js"></script>--%>

    <script>
        function myFunction(){var a=$("#MyTable >tbody >tr").length;a>10?$("#bg").css("display","none"):($("#bg").css("display","block"),$("#tblsub >tbody >tr:first >td").css("border-top","1px solid #000"))}
    </script>
    <style>
        table {
            page-break-inside: auto;
        }

        tr {
            page-break-inside: avoid;
            page-break-after: auto;
        }

        @media print {
            thead {
                display: table-header-group;
            }

            tfoot {
                display: table-footer-group;
            }

            tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }
        }

        @media screen {
            thead {
                display: block;
            }

            tfoot {
                display: block;
            }
        }

        thead {
            display: table-header-group;
        }

        ul {
            padding-left: 0px;
            margin: 0px;
            list-style: none;
        }

            ul li {
                padding-left: 0px;
                margin: 0px;
                list-style: none;
                font-family: Arial;
                font-size: 12px;
                font-weight: normal;
            }
    </style>
</head>
