    Protected Sub Page_Load(sender As Object, e As EventArgs) Handles Me.Load
        If Not IsPostBack Then

            FillProductGrid()
        End If
    End Sub

    Public Sub FillProductGrid()
        Try

            GridView1.DataSource = ProductBLL.MainProductViewAll(Session("UserId"))
            GridView1.DataBind()
            btnsubmit.Visible = True
        Catch ex As Exception

        End Try
    End Sub

    Protected Sub ddrelatedtype_TextChanged(sender As Object, e As EventArgs) Handles ddrelatedtype.TextChanged
        Try
            If ddrelatedtype.SelectedValue = "Lead" Then
                Dim ds As DataSet = MainBLL.Dropdown("LeadContactDropDown")
                ddrelatedtypeid.DataSource = ds
                ddrelatedtypeid.DataTextField = "Lead_Name"
                ddrelatedtypeid.DataValueField = "Lead_Id"
                ddrelatedtypeid.DataBind()
            ElseIf (ddrelatedtype.SelectedValue = "Prospect") Then
                Dim ds As DataSet = MainBLL.DropdownWithtype("AccountDropDown", "Prospect")
                ddrelatedtypeid.DataSource = ds
                ddrelatedtypeid.DataTextField = "Acc_Name"
                ddrelatedtypeid.DataValueField = "Acc_Id"
                ddrelatedtypeid.DataBind()
            ElseIf (ddrelatedtype.SelectedValue = "Account") Then
                Dim ds As DataSet = MainBLL.DropdownWithtype("AccountDropDown", "Account")
                ddrelatedtypeid.DataSource = ds
                ddrelatedtypeid.DataTextField = "Acc_Name"
                ddrelatedtypeid.DataValueField = "Acc_Id"
                ddrelatedtypeid.DataBind()
            ElseIf (ddrelatedtype.SelectedValue = "Opportunity") Then
                Dim ds As DataSet = MainBLL.Dropdown("OpportunityDropDown")
                ddrelatedtypeid.DataSource = ds
                ddrelatedtypeid.DataTextField = "Opportunity_Name"
                ddrelatedtypeid.DataValueField = "Opportunity_Id"
                ddrelatedtypeid.DataBind()
            ElseIf (ddrelatedtype.SelectedValue = "None") Then
                ddrelatedtypeid.DataSource = ""
                ddrelatedtypeid.DataBind()
               
            End If

        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("ActivitTask", "ddrelatedtype_TextChanged", error1, Session("UserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
    Protected Sub txtOrderQty_TextChanged(sender As Object, e As EventArgs)
        Try

            For Each row As GridViewRow In GridView1.Rows
                Dim a As Integer
                Dim lbltotalamount2 As Literal = DirectCast(row.FindControl("lbltotalamount2"), Literal)
                Dim lbltotalamount As Label = DirectCast(row.FindControl("lbltotalamount"), Label)
                Dim lbltotalamount1 As Label = DirectCast(row.FindControl("lbltotalamount1"), Label)
                Dim lbl As Label = DirectCast(row.FindControl("lblunit"), Label)
                Dim txtOrderQty As TextBox = DirectCast(row.FindControl("txtOrderQty"), TextBox)
                Dim lblrate As Label = DirectCast(row.FindControl("lblrate"), Label)
                Dim lblkgs As Label = DirectCast(row.FindControl("lblkgs"), Label)
                ' Dim txtkgs As TextBox = DirectCast(row.FindControl("txtkgs"), TextBox)
                If txtOrderQty.Text.Contains(".") Then
                    txtOrderQty.Text = Math.Floor(CDbl(txtOrderQty.Text))
                End If

                If txtOrderQty.Text = "" Then
                Else
                    Dim numbers As String() = Regex.Split(lbl.Text, "\D+")
                    For Each value As String In numbers
                        If Not String.IsNullOrEmpty(value) Then
                            Dim i As Integer = Integer.Parse(value)
                            'txtkgs.Text = txtOrderQty.Text * i
                            lblkgs.Text = txtOrderQty.Text * i & "kg"
                            a = txtOrderQty.Text * i

                        End If
                    Next
                    lbltotalamount1.Text = "₹  " & (lbltotalamount.Text * a)
                    lbltotalamount2.Text = lbltotalamount.Text * a
                End If


            Next

        Catch ex As Exception

        End Try
    End Sub
