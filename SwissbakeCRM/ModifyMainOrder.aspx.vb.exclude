    Public Sub placeorder()
        Try
            Dim count As Integer
            If Session("OrderProduct") Is Nothing Then
                count = 0
                Dim dt As New DataTable
                dt.Columns.Add("Srno", GetType(Integer))
                dt.Columns.Add("ProductId", GetType(Integer))
                dt.Columns.Add("SwissBake Products", GetType(String))
                dt.Columns.Add("Code", GetType(String))

                dt.Columns.Add("Unit", GetType(String))
                dt.Columns.Add("Rate", GetType(String))
                dt.Columns.Add("Quantity", GetType(String))
                dt.Columns.Add("Amount", GetType(String))
                dt.Columns.Add("Vat", GetType(String))
                dt.Columns.Add("Weight", GetType(String))
                dt.Columns.Add("Vat1", GetType(String))
                For Each row As GridViewRow In GridView1.Rows
                    Dim txtOrderQty = DirectCast(row.FindControl("txtOrderQty"), TextBox)
                    Dim lblproductId = DirectCast(row.FindControl("lblproductId"), Label)
                    Dim lblname = DirectCast(row.FindControl("lblname"), Label)
                    Dim lblcode = DirectCast(row.FindControl("lblcode"), Label)
                    'Dim lbldosage = DirectCast(row.FindControl("lbldosage"), Label)
                    ' Dim lblusage = DirectCast(row.FindControl("lblusage"), Label)
                    Dim lblunit = DirectCast(row.FindControl("lblunit"), Label)
                    Dim Literal1 = DirectCast(row.FindControl("Literal1"), Literal)
                    Dim lblamount = DirectCast(row.FindControl("lblamount"), Label)
                    Dim lbltotalamount2 = DirectCast(row.FindControl("lbltotalamount2"), Literal)
                    Dim lblvat = DirectCast(row.FindControl("lblvat"), Label)
                    Dim lblkgs = DirectCast(row.FindControl("lblkgs"), Label)

                    If txtOrderQty.Text = "" Then
                    Else
                        If txtOrderQty.Text = 0 Then

                        Else
                            lblamount.Text = lbltotalamount2.Text
                            totalvat = Convert.ToDouble((lblvat.Text * lblamount.Text) / 100)
                            dt.Rows.Add(count, lblproductId.Text, lblname.Text, lblcode.Text, lblunit.Text, Literal1.Text, txtOrderQty.Text, lblamount.Text, totalvat, lblkgs.Text, lblvat.Text)
                            count = count + 1
                        End If

                    End If

                Next
                Session("OrderProduct") = dt
            Else
                Dim dt As DataTable = DirectCast(Session("OrderProduct"), DataTable)
                count = dt.Rows.Count
                For Each row As GridViewRow In GridView1.Rows
                    Dim txtOrderQty = DirectCast(row.FindControl("txtOrderQty"), TextBox)
                    Dim lblproductId = DirectCast(row.FindControl("lblproductId"), Label)
                    Dim lblname = DirectCast(row.FindControl("lblname"), Label)
                    Dim lblcode = DirectCast(row.FindControl("lblcode"), Label)
                    'Dim lbldosage = DirectCast(row.FindControl("lbldosage"), Label)
                    ' Dim lblusage = DirectCast(row.FindControl("lblusage"), Label)
                    Dim lblunit = DirectCast(row.FindControl("lblunit"), Label)
                    Dim Literal1 = DirectCast(row.FindControl("Literal1"), Literal)
                    Dim lblamount = DirectCast(row.FindControl("lblamount"), Label)
                    Dim lbltotalamount2 = DirectCast(row.FindControl("lbltotalamount2"), Literal)
                    Dim lblvat = DirectCast(row.FindControl("lblvat"), Label)
                    Dim lblkgs = DirectCast(row.FindControl("lblkgs"), Label)
                    If txtOrderQty.Text = "" Then
                    Else
                        If txtOrderQty.Text = 0 Then

                        Else

                            lblamount.Text = lbltotalamount2.Text
                            totalvat = Convert.ToDouble((lblvat.Text * lblamount.Text) / 100)
                            dt.Rows.Add(count, lblproductId.Text, lblname.Text, lblcode.Text, lblunit.Text, Literal1.Text, txtOrderQty.Text, lblamount.Text, totalvat, lblkgs.Text, lblvat.Text)
                            count = count + 1
                        End If
                    End If
                Next
            End If

            Dim dt1 As DataTable = DirectCast(Session("OrderProduct"), DataTable)
            If dt1.Rows.Count > 0 Then
                For Each row As DataRow In dt1.Rows

                Next
            End If
            Dim ProductId As Integer = 0
            Dim amount As Double = 0
            Dim rnd As New Random()
            Dim verfirycode As Integer = rnd.[Next](10000, 999999)
            Dim dice As String = "OD" + rnd.[Next](10000, 999999).ToString() + " "

            InvoiceID = OrderBLL.InsertCRM(dice, ddrelatedtypeid.SelectedValue, totalgrand, "Pending", ddpayment.SelectedItem.Text.Trim, totalgrandvat, 0, Session("UserId"), "", "")

            For Each row As DataRow In dt.Rows
                OrderBLL.Main_Order_Details(InvoiceID, row("ProductId").ToString, row("Quantity").ToString, row("Rate").ToString, row("Amount").ToString, row("Vat"))
            Next
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ScriptManager.RegisterClientScriptBlock(Page, Me.GetType(), "call", "alert('Error " + error1.ToString + "');", True)
        End Try
    End Sub

    Protected Sub btnsubmit_Click(sender As Object, e As EventArgs) Handles btnsubmit.Click
        Try
            placeorder()
            'Response.Redirect("Cart.aspx")
            ' ScriptManager.RegisterClientScriptBlock(Page, Me.GetType(), "call", "alert('Product has been added to your cart ');", True)
            Page.Response.Redirect(HttpContext.Current.Request.Url.ToString(), True)

        Catch ex As Exception

        End Try
    End Sub

    Protected Sub GridView1_RowDataBound1(sender As Object, e As GridViewRowEventArgs)
        If e.Row.RowType = DataControlRowType.DataRow Then

            Dim lblstock As Label = DirectCast(e.Row.FindControl("lblstock"), Label)
            Dim lblout As Label = DirectCast(e.Row.FindControl("lblout"), Label)

            Dim Literal1 As Literal = DirectCast(e.Row.FindControl("Literal1"), Literal)
            Dim lbl As Label = DirectCast(e.Row.FindControl("lblunit"), Label)
            Dim lblrate As Label = DirectCast(e.Row.FindControl("lblrate"), Label)
            Dim lbldiscount As Label = DirectCast(e.Row.FindControl("lbldiscount"), Label)
            Dim lbltotalamount As Label = DirectCast(e.Row.FindControl("lbltotalamount"), Label)
            Dim DropDownList1 As DropDownList = DirectCast(e.Row.FindControl("DropDownList1"), DropDownList)
            Dim txtOrderQty As TextBox = DirectCast(e.Row.FindControl("txtOrderQty"), TextBox)


            If lblstock.Text = "In Stock" Then
                lblout.Visible = False
                Dim numbers As String() = Regex.Split(lbl.Text, "\D+")
                For Each value As String In numbers
                    If Not String.IsNullOrEmpty(value) Then
                        Dim i As Integer = Integer.Parse(value)
                        txtOrderQty.Attributes.Add("step", i)
                    End If
                Next
            Else
                txtOrderQty.Visible = False
                lblout.Visible = True
            End If

            If lbldiscount.Text = "" Then
                lblrate.Visible = False
                Literal1.Text = lblrate.Text
                lbltotalamount.Text = Literal1.Text
            Else
                countrate = lbldiscount.Text / 100
                countrate1 = lblrate.Text * countrate
                Literal1.Text = lblrate.Text - countrate1
                lbltotalamount.Text = Literal1.Text
            End If
        End If
    End Sub

    


End Class
