	Private Sub ddlCatagory_SelectedIndexChanged(sender As Object, e As EventArgs) Handles ddlCatagory.SelectedIndexChanged
		FillddlProduct()
	End Sub

    Private Sub ddlUser_SelectedIndexChanged(sender As Object, e As EventArgs) Handles ddlUser.SelectedIndexChanged
        Try
            If ddlUser.SelectedValue = 0 Then
                divCompany.Visible = False
            Else
                divCompany.Visible = True
                FillddlCompany()
            End If

        Catch ex As Exception

        End Try
    End Sub
    Protected Sub btnExport_Click(sender As Object, e As EventArgs) Handles btnExport.Click
        Try

            Response.Clear()
            Response.Buffer = True
            Response.AddHeader("content-disposition", "attachment;filename=Product Report.xls")
            Response.Charset = ""
            Response.ContentType = "application/vnd.ms-excel"
            Dim sw As New StringWriter()
            Dim hw As New HtmlTextWriter(sw)

            Dim Gridview2 As New GridView

            Dim dt As New DataSet()
            'dt = MainBLL.SearchGridViewByID(txtSearch.Text.Trim, Session("UserId"), hfExcel.Value)
            dt = reportBLL.FillProductReport(ddlUser.SelectedValue, txtfrom.Text, txtto.Text, ddlCompany.SelectedValue, ddlCatagory.SelectedValue, ddlProduct.SelectedValue, ddlStage.SelectedValue, "ProductReportExcel")

            Dim dtExc As DataTable = dt.Tables(0)
            'dtExc.Columns.Remove("Order_ID")
            'dtExc.Columns.Remove("U_ID")
            'dtExc.Columns.Remove("Industry_Name")
            'dtExc.Columns.Remove("Industry_Id")
            'dtExc.Columns.Remove("Order_CustId")
            ''dtExc.Columns.Remove("RowNumber")
            dtExc.Columns("RowNumber").ColumnName = "Sr No."
            dtExc.Columns("Acc_Name").ColumnName = "Company"
            dtExc.Columns("PrdCategory_Name").ColumnName = "Category"
            dtExc.Columns("Product_Name").ColumnName = "Product Name"
            dtExc.Columns("OrDetail_Qty").ColumnName = "Quantity (KG)"
            dtExc.Columns("OrDetail_Rate").ColumnName = "Rate / KG (Rs)"
            dtExc.Columns("total").ColumnName = "Price (Rs)"
            dtExc.Columns("U_FirstName").ColumnName = "Owner"
            dtExc.Columns("Acc_Code").ColumnName = "Company Code"
            dtExc.Columns("Product_Code").ColumnName = "Product Code"
            dtExc.Columns("Invoice_Number").ColumnName = "Invoice Code"
            dtExc.Columns("OrderAddr_City").ColumnName = "City"
            dtExc.Columns("StateName").ColumnName = "State"
            dtExc.Columns("Contact_ContactPerson").ColumnName = "Contact Person"
            dtExc.Columns("Contact_Email").ColumnName = "Email"
            dtExc.Columns("Contact_Mobile").ColumnName = "Mobile"
            dtExc.Columns("Sr No.").SetOrdinal(0)
            dtExc.Columns("Company").SetOrdinal(1)
            dtExc.Columns("Company Code").SetOrdinal(2)
            dtExc.Columns("Contact Person").SetOrdinal(3)
            dtExc.Columns("Quantity (KG)").SetOrdinal(4)
            dtExc.Columns("Product Code").SetOrdinal(7)
            'dtExc.Columns("Assignto").SetOrdinal(10)

            Gridview2.DataSource = dtExc
            'Gridview2.DataBind()
            Gridview2.AllowPaging = False
            Gridview2.DataBind()
            Gridview2.RenderControl(hw)

            'style to format numbers to string
            Dim style As String = "<style> .textmode { mso-number-format:\@; } </style>"
            Response.Write(style)
            Response.Output.Write(sw.ToString())
            Response.Flush()
            Response.End()
            ' ''Dim html2 As String = Regex.Replace(sw.ToString(), "(<img\/?[^>]+>)", "", RegexOptions.IgnoreCase)
            '' ''html2 = Regex.Replace(html2, "(<input class=""checkbox""\/?[^>]+>)", "", RegexOptions.IgnoreCase)
            ' ''html2 = Regex.Replace(html2, "(<a \/?[^>]+>)", "", RegexOptions.IgnoreCase)
            ' ''html2 = Regex.Replace(html2, "(<i \/?[^>]+>)", "(INR)", RegexOptions.IgnoreCase)
            ' ''Response.Write(html2.ToString())
            ' ''Response.Flush()
            ' ''Response.End()

            'DoValidate.closeConn(_conn)

        Catch ex As Exception

        End Try
    End Sub
End Class
