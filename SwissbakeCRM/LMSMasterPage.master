        <div id="modal-userProfile-settings" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header text-center">
                        <h2 class="modal-title"><i class="fa fa-user"></i>Profile Settings</h2>
                    </div>
                    <div class="modal-body">
                        <div class="form-horizontal form-bordered">
                            <fieldset>
                                <div class="form-horizontal form-bordered">
                                </div>
                                <div class="form-group">
                                    <asp:UpdatePanel ID="UpdatePanel3" runat="server">
                                        <ContentTemplate>
                                            <table class="table table-borderless table-striped" style="margin-bottom: 0px;">
                                                <tbody>
                                                    <tr>
                                                        <td style="width: 20%;"><strong>First Name</strong></td>
                                                        <td>
                                                            <a href="javascript:void(0)">
                                                                <asp:Literal ID="lblfname" runat="server"></asp:Literal></a>
                                                            <asp:TextBox ID="txtfirstname" runat="server" Visible="false" OnTextChanged="txtfirstname_TextChanged" AutoPostBack="true"></asp:TextBox>
                                                            <div class="btn-group btn-group-xs">
                                                                <asp:LinkButton ID="lbtnFirst" EnableViewState="false"
                                                                    data-toggle="tooltip" title="Edit" class="btn btn-default" runat="server"><i class="fa fa-pencil"></i></asp:LinkButton>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td><strong>Last Name</strong></td>
                                                        <td><a href="javascript:void(0)">
                                                            <asp:Literal ID="lbllname" runat="server"></asp:Literal></a>
                                                            <asp:TextBox ID="txtlastname" runat="server" Visible="false" OnTextChanged="txtlastname_TextChanged" AutoPostBack="true"></asp:TextBox>
                                                            <div class="btn-group btn-group-xs">
                                                                <asp:LinkButton ID="lbtnLast" EnableViewState="false"
                                                                    data-toggle="tooltip" title="Edit" class="btn btn-default" runat="server"><i class="fa fa-pencil"></i></asp:LinkButton>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td><strong>Mobile no.</strong></td>
                                                        <td><a href="javascript:void(0)">
                                                            <asp:Literal ID="lblmobile" runat="server"></asp:Literal></a>
                                                            <asp:TextBox ID="txtmobile" runat="server" Visible="false" OnTextChanged="txtmobile_TextChanged" AutoPostBack="true"></asp:TextBox>
                                                            <div class="btn-group btn-group-xs">
                                                                <asp:LinkButton ID="lbtnMobile" EnableViewState="false"
                                                                    data-toggle="tooltip" title="Edit" class="btn btn-default" runat="server"><i class="fa fa-pencil"></i></asp:LinkButton>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td><strong>Date Of Birth</strong></td>
                                                        <td><a href="javascript:void(0)" class="label label-danger">
                                                            <asp:Literal ID="lbldate" runat="server"></asp:Literal></a>
                                                            <asp:TextBox ID="txtdate" runat="server" Visible="false" OnTextChanged="txtdate_TextChanged" AutoPostBack="true"></asp:TextBox>
                                                            <div class="btn-group btn-group-xs">
                                                                <asp:LinkButton ID="lbtndate" EnableViewState="false"
                                                                    data-toggle="tooltip" title="Edit" class="btn btn-default" runat="server"><i class="fa fa-pencil"></i></asp:LinkButton>
                                                            </div>
                                                        </td>
                                                    </tr>

                                                </tbody>
                                            </table>
                                        </ContentTemplate>
                                        <Triggers>
                                            <asp:AsyncPostBackTrigger ControlID="txtfirstname" />
                                            <asp:AsyncPostBackTrigger ControlID="txtlastname" />
                                            <asp:AsyncPostBackTrigger ControlID="txtmobile" />
                                            <asp:PostBackTrigger ControlID="txtdate" />
                                        </Triggers>
                                    </asp:UpdatePanel>


                                    <asp:UpdatePanel ID="UpdatePanel2" runat="server">
                                        <ContentTemplate>
                                            <table class="table table-borderless table-striped">
                                                <tbody>
                                                    <tr>
                                                        <td style="width: 20%;"><strong>Upload Image : </strong></td>
                                                        <td>
