        <script type="text/javascript">
            $(function Mandardecimal() {

                $('.decimal').keyup(function () {
                    var val = $(this).val();
                    if (isNaN(val)) {
                        val = val.replace(/[^0-9\.]/g, '');
                        if (val.split('.').length > 2)
                            val = val.replace(/\.+$/, "");
                    }
                    $(this).val(val);
                });
            });
        </script>

          <script>
              function onlyNos(e, t) {

                  try {
                      var cnt = 0;
                      if (window.event) {
                          var charCode = window.event.keyCode;
                      }
                      else if (e) {
                          var charCode = e.which;
                      }
                      else { return true; }
                      if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                          //if (charCode == 46) {
                          //    return true;
                          //}
                          //else
                          if (charCode == 45) {
                              return true;
                          }
                          else {
                              return false;
                          }
                      }
                      return true;
                  }
                  catch (err) {
                      alert(err.Description);
                  }
              }
              function insertColon(element, txt) {
                  // debugger;
                  var name = element.id;
                  var myString = (name).split("_");
                  var txtQty = document.getElementById(element.id.replace(myString[2], txt));
                  var name = txtQty.id;
                  var myString = (name).split("_");
                  var txtProcTime = document.getElementById(txtQty.id.replace(myString[2], txt));

                  if (txtProcTime.value.trim().length == 2) {
                      txtProcTime.value = txtProcTime.value + ':';
                  }
                  if (txtProcTime.value.trim().length == 4) {
                      var myString1 = (txtProcTime.value).split(":");
                      var nos = myString1[1];
                      if (parseInt(nos) > 5) {
                          txtProcTime.value = myString1[0] + ':5';
                      }

                  }
              }
              function Coloncheck(element, txt) {
                  debugger;
                  var name = element.id;
                  var myString = (name).split("_");
                  var txtQty = document.getElementById(element.id.replace(myString[2], txt));
                  var name = txtQty.id;
                  var myString = (name).split("_");
                  var txtProcTime = document.getElementById(txtQty.id.replace(myString[2], txt));

                  if (txtProcTime.value != '') {
                      if (txtProcTime.value.trim().length == 1) {

                          txtProcTime.value = '0' + txtProcTime.value + ':00';
                      }
                      else if (txtProcTime.value.trim().length == 3) {

                          txtProcTime.value = txtProcTime.value + '00';
                      }
                      else if (txtProcTime.value.trim().length == 4) {

                          txtProcTime.value = txtProcTime.value + '0';
                      }
                      if (txtProcTime.value.trim().length > 4) {
                          var myString1 = (txtProcTime.value).split(":");

                          if (typeof myString1[1] === 'undefined' || myString1[1] === null) {
                              // Do stuff

                              myString1[1] = txtProcTime.value.slice(-2);
                          }
                          var nos = myString1[1];
                          if (parseInt(myString1[0]) > 12) {
                              myString1[0] = '12';
                              txtProcTime.value = '12:' + myString1[1];
                          }
                          if (parseInt(nos) > 59) {
                              txtProcTime.value = myString1[0] + ':59';
                          }

                      }
                      if (txtProcTime.value.indexOf(':') > -1) {
                          //alert('String Contains Word');
                          //return true;
                      } else {
                          // alert('String Does not contains word');
                          //return false;
                          var val1 = txtProcTime.value.substring(0, 2);
                          var val2 = txtProcTime.value.substring(2, 4);
                          txtProcTime.value = val1 + ':' + val2;
                      }
                  }
              }
    </script>
