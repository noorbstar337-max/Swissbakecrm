            rpowner.DataBind()
            hfcontacttype.Value = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_Type").ToString())
            hfcontacttypeid.Value = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_TypeId").ToString())
