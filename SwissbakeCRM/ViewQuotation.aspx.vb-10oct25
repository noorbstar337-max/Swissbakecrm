            Dim dtUser As New DataTable
            dtUser = dt.Tables(0)
            Dim drLogin As DataRow
            drLogin = dtUser.Rows(0)
            'ltrevenue.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Revenue").ToString())
            ltcontactname.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_No").ToString())
            ltcompanyname.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Acc_Name").ToString())
            ltStage.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_Validity").ToString())
