                ltCountryFinalDestination.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_CountryOfFinalDestination").ToString())
                '  ltCountryFinalDestination.Text = country(0)(1).ToString + " "
                ' End If
                ' Dim state As Array = statedt.Select("ID = '" + drLogin("Quotation_FinalDestination").ToString() + "'")

                ' If state.Length <> 0 Then
                ltFinalDestination.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_FinalDestination").ToString())
                'ltFinalDestination.Text += state(0)(1).ToString + "- "
                'End If


            End If
            dt = Nothing
            dt = ActivityBLL.FillTaskType("Quotation", MainID, "CountActivity")
            dtUser = dt.Tables(0)
            drLogin = dtUser.Rows(0)
            ltcounttask.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Task").ToString())
            ltcountevent.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Evented").ToString())
