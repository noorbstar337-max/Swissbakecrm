            'ltprobability.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("OppStage_Probability").ToString())
            ltprobability.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Quotation_ModeOFPayment").ToString())
            'ltowner.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("U_FirstName").ToString())
