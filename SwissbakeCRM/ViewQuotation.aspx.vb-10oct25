    Protected Sub btnsave_Click(sender As Object, e As EventArgs) Handles btnsave.Click
        Try
            If txtpayablenow.Text = "" Then
                txtpayablenow.Text = 0
            End If
            If String.IsNullOrEmpty(txtduedate.Text) Then
                txtduedate.Text = Date.Now.Date.ToString("yyyy-MM-dd")
            End If
            MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
            ProformaBLL.Insert("Quotation", MainID, Convert.ToDateTime(txtduedate.Text.Trim).ToString("yyyy-MM-dd"), "True", "", Session("UserId"), lblquoamount.Text, txtpayablenow.Text, Session("UserId"), Session("UserId"))
            Response.Redirect(Request.RawUrl)
            'FillProforma()
            'mpe.Hide()
            'Me.RegisterPostBackControl()
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("ViewQuotation", "btnSaveClick", error1, Session("UserId"))
            'ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub

