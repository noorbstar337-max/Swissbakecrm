    Protected Sub Page_Init(sender As Object, e As EventArgs) Handles Me.Init
        If Session("UserId") = Nothing Then
            TryCast(Me.Master, MainPage).MaintainSession()
            Try
                If (Request.QueryString("Id") = Nothing) Then
                    Response.Redirect("index.aspx")
                End If
            Catch ex As Exception
                Dim error1 As String = ex.Message.Replace(Chr(34), "")
                error1 = error1.Replace(Chr(39), "")
                ExecptionBLL.Insert("ViewQuotation", "Page_Init", error1, Session("UserId"))
                ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
            End Try
        Else
            Try
                If (Request.QueryString("Id") = Nothing) Then
                    Response.Redirect("index.aspx")
                End If
            Catch ex As Exception
                Dim error1 As String = ex.Message.Replace(Chr(34), "")
                error1 = error1.Replace(Chr(39), "")
                ExecptionBLL.Insert("ViewQuotation", "Page_Init", error1, Session("UserId"))
                ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
            End Try
        End If
    End Sub

    Protected Sub Page_Load(sender As Object, e As EventArgs) Handles Me.Load
        Try
            If Not IsPostBack Then
                MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
                Qtyp = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Qtyp")))
                privilage()
                'aedit.HRef = Page.ResolveUrl("ModifyQuotation.aspx?chk=e&Id=" + HttpUtility.UrlEncode(Security.Encrypt(MainID.ToString())) + "&returnurl=" + HttpUtility.UrlEncode(Security.Encrypt(Request.Url.AbsoluteUri.ToString)))
                aedit.HRef = Page.ResolveUrl("ModifyQuotation.aspx?chk=e&Id=" + HttpUtility.UrlEncode(Security.Encrypt(MainID.ToString())) + "&returnurl=y")
                ' aedit.HRef = Page.ResolveUrl("ModifyQuotation.aspx?returnurl=" + HttpUtility.UrlEncode(Security.Encrypt(Request.Url.AbsoluteUri.ToString)) + "&Id=" + HttpUtility.UrlEncode(Security.Encrypt(MainID.ToString())) + "&returnurl=y")
                aprint.HRef = Page.ResolveUrl("PrintDocs.aspx?tpy=Quotation&type=" + HttpUtility.UrlEncode(Security.Encrypt((Qtyp).ToString())) + "&Id=" + HttpUtility.UrlEncode(Security.Encrypt((MainID).ToString())))
                FillDetail()
                FillQuotation()
                FillProforma()
                activitycontrol.Uhftype.Value = "Quotation"
                activitycontrol.Uhftypeid.Value = MainID
                documentcontrol.Uhftype.Value = "Quotation"
                documentcontrol.Uhftypeid.Value = MainID
                notecontrol.Uhftype.Value = "Quotation"
                notecontrol.Uhftypeid.Value = MainID
                itemdtcontrol.Uhftype.Value = hfcontacttype.Value
                itemdtcontrol.Uhftypeid.Value = hfcontacttypeid.Value
                itemdtcontrol.Uhfopptype.Value = "Quotation"
                itemdtcontrol.Uhfopptypeid.Value = MainID
                emailcontrol.Uhftype.Value = "Quotation"
                emailcontrol.Uhftypeid.Value = MainID
            End If
            Me.RegisterPostBackControl()
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("ViewQuotation", "Page_Load", error1, Session("UserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
        'FillDetail()
        'upquickaction.Update()
    End Sub
    'gayatri created this for quotation history on 23-08-2017
    Public Sub FillQuotation()
        Try
            MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
            Dim ChildId As Integer = QuotationBLL.getChildIdByQId("getChildIdByQId", MainID)
            If ChildId <> 0 Then
                '   rpgridhistory.DataSource = QuotationBLL.FillQDetailbyID("GetQuotHistory", ChildId)

                ' rpgridhistory.DataBind()

                'rptmaidq.DataSource = QuotationBLL.FillQDetailbyID("GetQuotHistory", ChildId)
                rptmaidq.DataSource = QuotationBLL.FillQDetailbyID("GetQuotHistory", MainID)
                rptmaidq.DataBind()
            Else
                rptmaidq.DataSource = QuotationBLL.FillQDetailbyID("GetQuotHistory", MainID)
                rptmaidq.DataBind()
            End If
            version = rptmaidq.Items.Count
            For i As Integer = 0 To rptmaidq.Items.Count - 1
                Dim lblversion As Label = TryCast(rptmaidq.Items(i).FindControl("lblversion"), Label)
                ' For j As Integer = rptmaidq.Items.Count To 0 Step -rptmaidq.Items.Count
                '  Dim lblversion As Label = DirectCast(grditemproduct.Parent.FindControl("lblversion"), Label)
                lblversion.Text = (CDbl(1) + CDbl(version / 100)).ToString("")
                version = version - 1
                'Exit For
                ' Next
            Next
            Dim totalcount As Integer = rptmaidq.Items.Count
            If totalcount > 0 Then
                lblitemdt.Text = "Quotation History (" + totalcount.ToString + ")"
            Else
                lblitemdt.Text = "No Quotation History"
            End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("ViewPrinciple", "FillPrinciple", error1, Session("UserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
    Public Function checkurledit(ByVal QuotId As Integer)
        Dim result As String = ""
        result = "ModifyQuotation.aspx?returnurl=" + HttpUtility.UrlEncode(Security.Encrypt(Request.Url.AbsoluteUri.ToString)) + "&Id=" + HttpUtility.UrlEncode(Security.Encrypt(Eval("Quotation_Id").ToString()))
        Return result
    End Function
    Public Function checkurlView(ByVal QuotId As Integer)
        Dim result As String = ""
        result = "ModifyQuotation.aspx?chk=v&returnurl=" + HttpUtility.UrlEncode(Security.Encrypt(Request.Url.AbsoluteUri.ToString)) + "&Id=" + HttpUtility.UrlEncode(Security.Encrypt(Eval("Quotation_Id").ToString()))
        Return result
    End Function
