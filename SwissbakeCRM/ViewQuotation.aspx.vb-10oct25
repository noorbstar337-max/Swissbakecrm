    Protected Sub grditemproduct_RowDataBound(sender As Object, e As GridViewRowEventArgs) Handles grditemproduct.RowDataBound
        Dim type As String = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Qtyp")))
        'Dim lblAmount As Literal = DirectCast(grditemproduct.Rows(0).FindControl("lblAmount1"), Literal)
        If e.Row.RowType = DataControlRowType.DataRow Then
            ltitemtypeid = DirectCast(e.Row.FindControl("ltitemtypeid"), Label)

            Dim ltproductid As Literal = DirectCast(e.Row.FindControl("ltproductid"), Literal)
            Dim txtquantity As Label = TryCast(e.Row.FindControl("txtquantity"), Label)
            Dim ltrate As Literal = TryCast(e.Row.FindControl("ltrate"), Literal)
            Dim ltitemid As Literal = TryCast(e.Row.FindControl("ltitemid"), Literal)
            Dim ltproductWeight As Literal = TryCast(e.Row.FindControl("ltproductWeight"), Literal)
            Dim ltkg As Literal = TryCast(e.Row.FindControl("ltkg"), Literal)
            Dim ltamount As Literal = TryCast(e.Row.FindControl("ltamount"), Literal)
            Dim lblvat As Literal = TryCast(e.Row.FindControl("lblvat"), Literal)
            Dim lblvatinrs As Literal = TryCast(e.Row.FindControl("lblvatinrs"), Literal)
            If txtquantity.Text = "" Then
                txtquantity.Text = 1
            End If
            If txtquantity.Text.Contains(".") Then
                txtquantity.Text = Math.Floor(CDbl(txtquantity.Text))
            End If
            ltkg.Text = ltproductWeight.Text * txtquantity.Text
            ltamount.Text = ltkg.Text * Math.Round(Convert.ToDouble(ltrate.Text))
            Dim VAT As Double
            If type = "USD" Then
                VAT = 0.0
                lblvat.Text = "0.0"
                grditemproduct.Columns(5).Visible = False
            Else

                ' ''VAT = Math.Round(Convert.ToDouble((lblvat.Text * ltamount.Text) / 100))*********MUBYN
                VAT = (Convert.ToDouble((lblvat.Text * ltamount.Text) / 100))
            End If
            ' ''lblvatinrs.Text = Math.Round(VAT).ToString("N2")***********MUBYN
            lblvatinrs.Text = (VAT).ToString("N2")
            ltamount.Text = Math.Round(Convert.ToDouble(ltamount.Text)).ToString("N2")


        End If
        If e.Row.RowType = DataControlRowType.Footer Then
            Dim lblfreight As Label = DirectCast(e.Row.FindControl("lblfreight"), Label)
            '   Dim ltitemtypeid As Literal = DirectCast(e.Row.FindControl("ltitemtypeid"), Literal)

            If Not lblfreight Is Nothing Then
                lblfreight.Text = ItemDetailBLL.GetFright("Quotation", ltitemtypeid.Text).ToString
                lblfreight.Text = (CDbl(lblfreight.Text)).ToString("N2")
            End If
        End If


        '    Dim gvr As GridViewRow = DirectCast(sender, Repeater).NamingContainer

        'now you can find control like this,
        '   Dim lbl_name As Label = DirectCast(gvr.FindControl("lblversion"), Label)


    End Sub
    Protected Sub rptmaidq_ItemDataBound(sender As Object, e As RepeaterItemEventArgs) Handles rptmaidq.ItemDataBound
        Try

            Dim lblqtn As Label = DirectCast(e.Item.FindControl("lblqtn"), Label)

            '  Dim lblversion As Label = DirectCast(e.Item.FindControl("lblversion"), Label)
            '   Dim lblamt As Label = DirectCast(e.Item.FindControl("lblamt"), Label)

          
            ' Dim rep1 As Repeater = TryCast(e.Item.FindControl("rptqtndetails"), Repeater)

            Dim grditemproduct As GridView = TryCast(e.Item.FindControl("grditemproduct"), GridView)

            grditemproduct.DataSource = ItemDetailBLL.FillItemDT("Quotation", Convert.ToInt32(lblqtn.Text), AccId)
            grditemproduct.DataBind()

           
            If grditemproduct.Rows.Count > 0 Then
                Dim lttotalamount As Literal = DirectCast(grditemproduct.FooterRow.FindControl("lttotalamount"), Literal)
                Dim lttotalvat As Literal = DirectCast(grditemproduct.FooterRow.FindControl("lttotalvat"), Literal)
                Dim lblfreight As Label = DirectCast(grditemproduct.FooterRow.FindControl("lblfreight"), Label)

                Dim ltamount As Literal = TryCast(grditemproduct.FindControl("ltamount"), Literal)
                Dim lblvat As Literal = TryCast(grditemproduct.FindControl("lblvat"), Literal)
                Dim lblvatinrs As Literal = TryCast(grditemproduct.FindControl("lblvatinrs"), Literal)
                '  lblvatinrs.Text = VAT.ToString("N2")
                '  ltamount.Text = Math.Round(Convert.ToDouble(ltamount.Text)).ToString("N2")

                If String.IsNullOrEmpty(lblfreight.Text) Then
                    lblfreight.Text = "0.00"
                End If
                FooterTotalAmount = 0.0
                VatAmount = 0.0
                For i As Integer = 0 To grditemproduct.Rows.Count - 1
                    ltamount = DirectCast(grditemproduct.Rows(i).FindControl("ltamount"), Literal)
                    lblvatinrs = DirectCast(grditemproduct.Rows(i).FindControl("lblvatinrs"), Literal)
                    VatAmount = VatAmount + lblvatinrs.Text
                    FooterTotalAmount = FooterTotalAmount + ltamount.Text
                Next
                Dim FreightTax As Double = ConfigurationManager.AppSettings("freightvalue")
                Dim freightamt As Double = (Convert.ToDouble(lblfreight.Text) * CDbl(FreightTax) / 100).ToString("N2")
                VatAmount = VatAmount + freightamt
                lttotalamount.Text = Math.Round(FooterTotalAmount + VatAmount + Convert.ToDouble(lblfreight.Text), 0, MidpointRounding.AwayFromZero).ToString("N2")
                ' ''lttotalvat.Text = Math.Round(VatAmount).ToString("N2")***********MUBYN
                lttotalvat.Text = (VatAmount).ToString("N2")

                Dim lblamt As Label = DirectCast(grditemproduct.Parent.FindControl("lblamt"), Label)
                lblamt.Text = "₹ " + lttotalamount.Text
            End If

            ' rep1.DataSource = QuotationBLL.FillQDetailbyID("getQuotationDetailsById", Convert.ToInt32(lblqtn.Text))
            ' rep1.DataBind()

            '  Next

        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            '   ExecptionBLL.Insert(System.IO.Path.GetFileName(Request.Url.AbsolutePath), System.Reflection.MethodBase.GetCurrentMethod().Name, error1, Session("UserId")) 'ViewSponsor", "fillVisa", error1, Session("UserId"))
            Throw ex
            'ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try

    End Sub
    Public Sub CheckPrivi()
        Try
            Dim ds As DataSet = UserBLL.CheckPrivi(Session("UserRoleID"), "Quotation.aspx")
            Dim strArr() As String
            Dim TemStr As String = ""
            Dim dtPrivi As New DataTable
            dtPrivi = Session("dtPrivilege")
            Dim rows() As DataRow = dtPrivi.Select("Menu_URL = 'Quotation.aspx'")

            TemStr = rows(0).Item("Val").ToString()
            strArr = TemStr.Split(",")
            If (strArr.Length > 3) Then
                If MainID = 0 Then
                    If strArr(2) = "1" Then
                    Else
                        Response.Redirect("index.aspx")
                    End If
                Else
                    'If strArr(1) = "1" Or strArr(2) = "1" Or strArr(3) = "1" Then
                    If strArr(2) = "1" Then
                    Else
                        Response.Redirect("index.aspx")
                    End If
                End If
            End If
        Catch ex As Exception

        End Try
    End Sub
End Class
