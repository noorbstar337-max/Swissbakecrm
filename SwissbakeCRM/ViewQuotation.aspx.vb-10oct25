            lnkedit.CssClass = "btn btn-primary"
            ProformaBLL.Update(txtduedate.Text.Trim, txtpayablenow.Text.Trim, Session("UserId"), Session("UserId"), MainID)
            ltpayablenow.Text = txtpayablenow.Text
            ltproformadate.Text = txtduedate.Text.Trim
        ElseIf e.CommandName = "deletelink" Then
            If deletestatus.Value = "yes" Then
