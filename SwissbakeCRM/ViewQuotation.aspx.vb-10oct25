            Else
                MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
                FillProforma()
            End If

        End If
    End Sub

    Private Sub RegisterPostBackControl()
        For Each row As GridViewRow In grdproforma.Rows
            Dim lkprintpdf As LinkButton = TryCast(row.FindControl("lkprintpdf"), LinkButton)
            ScriptManager.GetCurrent(Me).RegisterPostBackControl(lkprintpdf)
            Dim lkemail As LinkButton = TryCast(row.FindControl("lkemail"), LinkButton)
            ScriptManager.GetCurrent(Me).RegisterPostBackControl(lkemail)
            'Dim lnkedit As LinkButton = TryCast(row.FindControl("lnkedit"), LinkButton)
            'ScriptManager.GetCurrent(Me).RegisterAsyncPostBackControl(lnkedit)
            'Dim lnkdelete As LinkButton = TryCast(row.FindControl("lnkdelete"), LinkButton)
            'ScriptManager.GetCurrent(Me).RegisterAsyncPostBackControl(lnkdelete)
        Next
    End Sub

    Public Shared Function HtmlToPdf(outputFilenamePrefix As String, urls As String) As String
        Dim urlsSeparatedBySpaces As String = String.Empty
        Try

            If (urls Is Nothing) OrElse (urls.Length = 0) Then
                Throw New Exception("No input URLs provided for HtmlToPdf")
            Else
                urlsSeparatedBySpaces = [String].Join(" ", urls)
            End If
            'Concatenate URLs
            Dim outputFolder As String = HttpContext.Current.Server.MapPath("~/img/Pdf")
            Dim outputFilename As String = (outputFilenamePrefix & Convert.ToString("_")) + DateTime.Now.ToString("yyyy-MM-dd-hh-mm-ss-fff") + ".PDF"
            ' assemble destination PDF file name
            ' needs to be false in order to redirect output
            ' redirect all 3, as it should be all 3 or none
            Dim p As New Process
            p.StartInfo.FileName = HttpContext.Current.Server.MapPath("~/bin/wkhtmltopdf.exe")
            p.StartInfo.Arguments = urlsSeparatedBySpaces + " " + outputFilename
            p.StartInfo.UseShellExecute = False
            p.StartInfo.RedirectStandardError = True
            p.StartInfo.RedirectStandardInput = True
            p.StartInfo.RedirectStandardOutput = True
            p.StartInfo.WorkingDirectory = HttpContext.Current.Server.MapPath(outputFolder)
            p.Start()
            ' read the output here...
            Dim output = p.StandardOutput.ReadToEnd
            Dim errorOutput = p.StandardError.ReadToEnd()

            ' ...then wait n milliseconds for exit (as after exit, it can't read the output)
            p.WaitForExit(60000)

            ' read the exit code, close process
            Dim returnCode As Integer = p.ExitCode
            p.Close()

            ' if 0 or 2, it worked so return path of pdf
            If (returnCode = 0) OrElse (returnCode = 2) Then
                Return outputFolder & outputFilename
            Else
                Throw New Exception(errorOutput)
                ExecptionBLL.Insert("ViewQuotation", "updatelink", errorOutput, 1)
            End If
        Catch exc As Exception
            ExecptionBLL.Insert("ViewQuotation", "updatelink", exc.Message, 1)
            Throw New Exception(Convert.ToString((Convert.ToString("Problem generating PDF from HTML, URLs: ") & urlsSeparatedBySpaces) + ", outputFilename: ") & outputFilenamePrefix, exc)
        End Try
    End Function


