    Public Sub FillProforma()
        Try
            grdproforma.DataSource = ProformaBLL.ProfromaByType("Quotation", MainID, Session("UserId"))
            grdproforma.DataBind()
            Dim ds As DataSet
            ds = DirectCast(grdproforma.DataSource, DataSet)
            lblcontact.Text = ds.Tables(0).Rows.Count
            If lblcontact.Text > 0 Then
                lblcontact.Text = "Proforma (" + lblcontact.Text.ToString + ")"
                aedit.Visible = False
               
                btnopneprofroma.Visible = False
            Else
                lblcontact.Text = "No Proforma"
            End If
   

            Dim dtcheck As DataSet = QuotationBLL.Checkorderexist(MainID)
            Dim checkcname As String = dtcheck.Tables(0).Rows(0)("checkname").ToString()
            If checkcname = "Already Exist" Then

                aedit.Visible = False
            End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("ViewQuotation", "lkquicktask_Click", error1, Session("UserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub

