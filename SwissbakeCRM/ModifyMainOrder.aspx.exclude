<%@ Page Title="" Language="VB" MasterPageFile="~/MainPage.master" AutoEventWireup="false" CodeFile="ModifyMainOrder.aspx.vb" Inherits="ModifyMainOrder" %>

<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="Server">
</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder2" runat="Server">
</asp:Content>
<asp:Content ID="Content3" ContentPlaceHolderID="ContentPlaceHolder1" runat="Server">
    <div class="row">
        <div class="col-md-12">
            <div class="content-header">
                <div class="header-section">
                    <h1 style="font-weight: 400;">
                        <%-- <i class="hi hi-tasks" style="margin: -8px"></i>Modify Task<br>--%>
                     Sale Order
                    </h1>
                </div>
            </div>
            <ul class="breadcrumb breadcrumb-top">
                <li><a href="index.aspx">Home</a></li>
                <li><a href="Activity.aspx">Sale Order</a></li>
                <li>
                    <asp:Label ID="lbltitle2" runat="server"></asp:Label></li>
                <%-- <li>Modify Task</li>--%>
            </ul>
            <div class="col-md-12">
                <div class="widget">
                    <div class="widget-extra themed-background-dark">
                        <%--<div class="pull-right">
                            <div class="btn-group" style="margin-top: 4px; margin-right: -10px">
                                <asp:LinkButton ID="btntopsave" runat="server" OnClientClick="if (!Page_ClientValidate('MasterGroup')){ return false; } this.disabled = true; this.value = 'Saving...';"
                                    UseSubmitBehavior="false" class="btn btn-sm btn-primary" ValidationGroup="MasterGroup"><i class="fa fa-floppy-o"></i> Save</asp:LinkButton>
                                <a class="btn btn-sm btn-primary" href="/Product.aspx"><i class="fa fa-times"></i>Cancel</a>
                            </div>
                        </div>--%>
                        <h4 class="widget-content-light">
                            <strong>Sales</strong> Order
                        </h4>
                    </div>

                    <div class="widget-extra-full">
                        <div class="form-horizontal form-bordered">
                            <div class="col-md-12">
                                <br />
                            </div>
                            
                            
                            
                            
                            
                            
                            
                            <div class="col-md-12">
                                <label class="col-md-2 control-label" for="example-hf-password">Select Type</label>
                                <div class="col-md-3">
                                    <asp:DropDownList ID="ddrelatedtype" runat="server" AutoPostBack="true" data-toggle="tooltip" title="Related Type" CssClass="form-control">
                                        <asp:ListItem Value="None">None</asp:ListItem>
                                        <asp:ListItem Value="Lead">Lead</asp:ListItem>
                                        <asp:ListItem Value="Prospect">Prospect</asp:ListItem>
                                        <asp:ListItem Value="Account">Account</asp:ListItem>
                                        <asp:ListItem Value="Opportunity">Opportunity</asp:ListItem>
                                       <%-- <asp:ListItem Value="Account">Account</asp:ListItem>
                                        <asp:ListItem Value="Contact">Contact</asp:ListItem>
                                        <asp:ListItem Value="Potential">Potential</asp:ListItem>
                                        <asp:ListItem Value="Vendor">Vendor</asp:ListItem>
                                        <asp:ListItem Value="Quote">Quote</asp:ListItem>--%>
                                    </asp:DropDownList>
                                    <asp:RequiredFieldValidator ID="RequiredFieldValidator13" runat="server" ControlToValidate="ddrelatedtype" ValidationGroup="DemoMasterGroup" CssClass="MasterValidationCSS"
                                        ErrorMessage="Please enter  Task name" SetFocusOnError="true"></asp:RequiredFieldValidator>
                                </div>
                                <div class="col-md-3">
                                    <asp:DropDownList ID="ddrelatedtypeid" runat="server" AutoPostBack="true" name="example-chosen" class="select-chosen" data-toggle="tooltip" title="Related Type ID"></asp:DropDownList>
                                   
                                </div>
                                   <div class="col-md-3">
                                        <asp:DropDownList ID="ddpayment" runat="server" class="select-chosen">
                        <asp:ListItem Value="Select Payment Mode" Selected="True">Select Payment Mode</asp:ListItem>
                        <asp:ListItem Value="Credit">Credit cards</asp:ListItem>
                        <asp:ListItem Value="Debit">Debit cards</asp:ListItem>
                        <asp:ListItem Value="Net">Net Banking</asp:ListItem>
                        <asp:ListItem Value="Bank">Bank Transfer</asp:ListItem>
                        <asp:ListItem Value="Cheque">Cheque</asp:ListItem>
                    </asp:DropDownList>
                    <asp:RequiredFieldValidator ID="RequiredFieldValidator6" runat="server" ControlToValidate="ddpayment" InitialValue="Select Payment Mode" ValidationGroup="paymentGroup" CssClass="MasterValidationCSS"
                        ErrorMessage="Please select payment mode"></asp:RequiredFieldValidator>
                                   </div>
                            </div>
                            
                            

                            <%--<div class="col-md-12">
                                <div class="">
                                    <br />
                                    <asp:Button Text="Save" runat="server" ID="btnadd" OnClientClick="if (!Page_ClientValidate('MasterGroup')){ return false; } this.disabled = true; this.value = 'Saving...';"
                                        UseSubmitBehavior="false" class="btn btn-alt btn-primary" ValidationGroup="MasterGroup" />
                                    <asp:LinkButton ID="hfcancel"  Text="Cancel" runat="server" NavigateUrl="~/Task.aspx" class="btn btn-alt btn-danger" />
                                </div>
                            </div>--%>

                          

                            <div style="clear: both"></div>
                        </div>
                        
                    </div>
                    <asp:UpdatePanel ID="UpdatePanel1" runat="server" UpdateMode="conditional">
                <ContentTemplate>

    <asp:GridView ID="GridView1" runat="server" AutoGenerateColumns="False" DataKeyNames="Product_Id,Packing_Packing"
                               CssClass="table table-striped table-vcenter table-hover" 
                                AllowPaging="True" PageSize="10" AllowSorting="True" OnRowDataBound="GridView1_RowDataBound1">
                <Columns>
                    <asp:TemplateField HeaderText="SwissBake Products" HeaderStyle-CssClass="MasterGridviewHeader" ItemStyle-CssClass="MasterGridviewItem"
                        ItemStyle-HorizontalAlign="Center" SortExpression="PrdCategory_ID">
                        <ItemTemplate>
                           
                            <asp:Label ID="lblproductId" runat="server" Text='<%#Eval("Product_Id")%>' Visible="false" />
                            <asp:Label ID="lblname" runat="server" Text='<%#Eval("Product_Name")%>' /><br />
                        </ItemTemplate>
                        <ItemStyle BorderWidth="2px" />
                    </asp:TemplateField>
                    <asp:TemplateField HeaderText="Code" HeaderStyle-CssClass="MasterGridviewHeader" ItemStyle-CssClass="MasterGridviewItem"
                        ItemStyle-HorizontalAlign="Center" SortExpression="PrdCategory_ID">
                        <ItemTemplate>

                            <asp:Label ID="lblcode" runat="server" Text='<%#Eval("Product_Code")%>' /><br />
                        </ItemTemplate>
                        <ItemStyle BorderWidth="2px" />
                    </asp:TemplateField>

                    <asp:TemplateField HeaderText="SKU" HeaderStyle-CssClass="MasterGridviewHeader" ItemStyle-CssClass="MasterGridviewItem"
                        ItemStyle-HorizontalAlign="Center" SortExpression="PrdCategory_ID">
                        <ItemTemplate>

                            <asp:Label ID="lblunit" runat="server" Text='<%#Eval("Packing_Packing")%>' /><br />
                        </ItemTemplate>
                        <ItemStyle BorderWidth="2px" />
                    </asp:TemplateField>
                    <asp:TemplateField HeaderText="Rate/kg" HeaderStyle-CssClass="MasterGridviewHeader" ItemStyle-CssClass="MasterGridviewItem"
                        ItemStyle-HorizontalAlign="Center" SortExpression="PrdCategory_ID">
                        <ItemTemplate>
                            <asp:Label ID="lbldiscount" runat="server" Text='<%#Eval("Discount_Discount")%>' Visible="false" />
                            ₹  <asp:Label ID="lblrate" runat="server" Text='<%#Eval("Product_Rate")%>' Visible="false" />
                            <asp:Label ID="lblvat" runat="server" Text='<%#Eval("Product_Vat")%>' Visible="false" />
                            <asp:Literal ID="Literal1" runat="server"></asp:Literal><br />

                        </ItemTemplate>
                        <ItemStyle BorderWidth="2px" />
                    </asp:TemplateField>

                    <asp:TemplateField HeaderText="No of Pack" HeaderStyle-CssClass="MasterGridviewHeader" ItemStyle-CssClass="MasterGridviewItem"
                        ItemStyle-HorizontalAlign="Center" SortExpression="PrdCategory_ID">
                        <ItemTemplate>
                            <%-- <asp:DropDownList ID="DropDownList1" runat="server" Style="width: 64px;"></asp:DropDownList>--%>
                            <asp:Label ID="lblstock" runat="server" Text='<%#Eval("Product_Stock")%>' Visible="false"></asp:Label>
                            <asp:TextBox ID="txtOrderQty"  runat="server" Style="width: 54px;" min="0" OnTextChanged="txtOrderQty_TextChanged"  AutoPostBack="true"></asp:TextBox>
                            <asp:Label ID="lblout" runat="server" Text="Out Of Stock" Style="color: red; font-weight: bold;"
                                Visible="false"></asp:Label>
                            <asp:Label ID="lblamount" runat="server" Visible="false"></asp:Label>
                        </ItemTemplate>
                        <ItemStyle BorderWidth="2px" />
                    </asp:TemplateField>

                        <asp:TemplateField HeaderText="Kgs" HeaderStyle-CssClass="MasterGridviewHeader" ItemStyle-CssClass="MasterGridviewItem"
                        ItemStyle-HorizontalAlign="Center" SortExpression="PrdCategory_ID">
                        <ItemTemplate>
                            <%-- <asp:DropDownList ID="DropDownList1" runat="server" Style="width: 64px;"></asp:DropDownList>--%>
                          
                          <%--  <asp:TextBox ID="txtkgs" type="number" runat="server" Style="width: 64px;" min="0" ReadOnly="true"></asp:TextBox>--%>
                            <asp:Label ID="lblkgs" runat="server" text="-"></asp:Label>
                        </ItemTemplate>
                        <ItemStyle BorderWidth="2px" />
                    </asp:TemplateField>

                   <asp:TemplateField HeaderText="Amount"  HeaderStyle-CssClass="MasterGridviewHeader" ItemStyle-CssClass="MasterGridviewItem"
                                    ItemStyle-HorizontalAlign="Center" SortExpression="PrdCategory_ID">
                                    <ItemTemplate>
                  <asp:Literal ID="lbltotalamount2" runat="server" visible="false"></asp:Literal>
                     <asp:Label ID="lbltotalamount" runat="server" Visible="false"></asp:Label>
                                         <asp:Label ID="lbltotalamount1" runat="server" Text="-"></asp:Label>
                                    </ItemTemplate>
                                    <ItemStyle BorderWidth="2px" />

                                  
                                </asp:TemplateField>
                </Columns>
                 <PagerStyle CssClass="MasterGridviewPaging" HorizontalAlign="Right" BackColor="White" />

                                <FooterStyle HorizontalAlign="Center" BackColor="White" />
                                <PagerSettings PageButtonCount="4" />

                                <EmptyDataTemplate>
                                    <asp:Label ID="s" runat="server" Text="No Record Found"></asp:Label><br />
                                    <br />
                                </EmptyDataTemplate>
                                <EmptyDataRowStyle HorizontalAlign="Center" />
            </asp:GridView>

                </ContentTemplate>
                <Triggers>
                  
                    <asp:AsyncPostBackTrigger  ControlID="GridView1" />
                </Triggers>
            </asp:UpdatePanel>
                </div>
                 <asp:Button ID="btnsubmit" Visible="false" OnClientClick="this.disabled = true; this.value = 'Saving...';"
                    UseSubmitBehavior="false" runat="server" Text="Place Order" Style="width: 138px; border: 1px solid #A39A9A; padding: 7px; background-color: #B31616; color: white; float: right; margin-right: 15px;" />


            </div>
        </div>
    </div>
</asp:Content>

