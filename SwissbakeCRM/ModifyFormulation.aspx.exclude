    <div class="row">
        <div class="col-md-12">
            <div class="block full ">
                <div class="block-title ">
                    <h2><strong>Lab Management</strong></h2>
                </div>
              
                <ul class="nav nav-pills nav-justified clickable-steps">
                    <li runat="server" id="liFormulation">
                        <asp:HyperLink runat="server" ID="lnkFormulation" style="background-color: #1bbae1;">
                        <span class="badge pull-right"></span>
                        <b><i class="gi gi-group themed-color-dark"></i></b><strong>&nbsp;&nbsp;Formulation</strong>
                        </asp:HyperLink>
                    </li>
                    <li runat="server" id="liRecipe" class="col-md-4">
                        <asp:HyperLink runat="server" ID="lnkRecipe">
                        <b><i class="fa fa-newspaper-o   themed-color-dark"></i></b>
                        <strong>&nbsp;&nbsp;Recipe</strong>
                        </asp:HyperLink>
                    </li>
                    <li runat="server" id="liTrial" class="col-md-4">
                        <asp:HyperLink runat="server" ID="lnkTrial">
                        <span class="badge pull-right"></span>
                        <b><i class="fa fa-gear themed-color-dark"></i></b><strong>&nbsp;&nbsp;Trial</strong>
                        </asp:HyperLink>
                    </li>
                </ul>
                <br />
                <%--<div class="row">--%>
                <asp:HiddenField ID="hfBtnPrint" runat="server"/>
                <%-- Fromulation Starts --%>
                <div class="widget">
                    <div class="widget-extra themed-background-dark">
                        <h5 class="widget-content-light abc">
                            <strong>Formulation (<asp:Label ID="lblFormulationNo" runat="server" data-toggle="tooltip" ></asp:Label>) 
                                <a runat="server" ID="btnprint" class="btn btn-alt btn-xs btn-primary" target="_blank" style="margin-left:10px;">Print</a>                                
                                <a runat="server" ID="btnprintblank" class="btn btn-alt btn-xs btn-primary" target="_blank">Print Blank</a> </strong>
                             <strong><asp:Label  runat="server" ID="lblapproved" style="float:right;"></asp:Label></strong>
                             <span class="pull-right" id="modifyspan" runat="server">By&nbsp;<a style="text-decoration: none;"><asp:Label ID="lblmodifiedname" runat="server" Font-Bold="true"></asp:Label></a>&nbsp;on&nbsp;<a style="text-decoration: none;"><asp:Label ID="lblmodifieddate" Font-Bold="true" runat="server" Font-Italic="true"></asp:Label></a>
                                  </span>
                        </h5>
                        
                    </div>

                    <div class="block full ">

                        <div class="widget-extra-full">
                            <div class="form-horizontal form-bordered  ">
                                <div class="col-md-12">
                                    <asp:UpdatePanel ID="UpdatePanel6" runat="server">
                                        <ContentTemplate>
                                            <script type="text/javascript" >
                                                Sys.Application.add_load(custom);
                                            </script>

                                            <asp:HiddenField ID="HiddenField1" runat="server" />
                                            <%-- Fromulation Starts --%>
                                            <%--<div class="col-md-12">--%>
                                            <%--<div class="widget">--%>
                                            <%--<div class="block" style="display: table; width: 100%;">--%>
                                            <asp:UpdatePanel ID="UpdatePanel2" runat="server">
                                                <ContentTemplate>
                                                    <%--          <div class="col-lg-3">
                                                            <label for="example-nf-email" class="col-md-6">Formulation No.</label>
                                                            <div class="col-md-6">
                                                                <asp:Label ID="lblFormulationNo" runat="server" data-toggle="tooltip" title="Enter Formulation No."></asp:Label>
                                                            </div>
                                                        </div>--%>
                                                    <div style="clear: both"></div>
                                                    <div class="col-xs-11">
                                                        <div class="col-md-3">
                                                            <label for="example-nf-email" class="col-md-6">Formulation Type</label>
                                                            <div class="col-md-6">
                                                                <asp:DropDownList ID="ddlFormulationType" runat="server" data-toggle="tooltip" title="Select Product Type" CssClass="form-control select-chosen" TabIndex="1" AutoPostBack="true">
                                                                    <asp:ListItem Value="0">Existing Product</asp:ListItem>
                                                                    <asp:ListItem Value="1">New Product</asp:ListItem>
                                                                    <asp:ListItem Value="2">Competitor Product</asp:ListItem>
                                                                </asp:DropDownList>
                                                                <asp:RequiredFieldValidator ID="rfddlFormulationType" runat="server" ControlToValidate="ddlFormulationType" ValidationGroup="MasterGroup" CssClass="MasterValidationCSS"
                                                                    ErrorMessage="This is required" Display="Dynamic"></asp:RequiredFieldValidator>
                                                                <br />
                                                            </div>
                                                        </div>
                                                        <div class="col-md-3" id="divDDLProduct" runat="server">
                                                            <label for="example-nf-email" class="col-md-3">Product </label>
                                                            <div class="col-md-9">
                                                                <asp:DropDownList ID="ddlProduct" runat="server" AutoPostBack="true" data-toggle="tooltip" title="Select Product" CssClass="form-control select-chosen" TabIndex="2">
                                                                </asp:DropDownList>
                                                                <asp:RequiredFieldValidator ID="rfddlProduct" runat="server" ControlToValidate="ddlProduct" ValidationGroup="MasterGroup" CssClass="MasterValidationCSS"
                                                                    ErrorMessage="This is Required" InitialValue="Select Product" Display="Dynamic"></asp:RequiredFieldValidator>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-3" id="divTxtProduct" runat="server" visible="false">
                                                            <label for="example-nf-email" class="col-md-3">Product </label>
                                                            <div class="col-md-9">
                                                                <asp:TextBox ID="txtProduct" runat="server" AutoPostBack="true" data-toggle="tooltip" placeholder="Enter Product" title="Enter Product" CssClass="form-control" TabIndex="2">
                                                                </asp:TextBox>
                                                                <asp:Label Visible="false" ID="lblProdExist" runat="server" Text="Product already Exist" ForeColor="Red"></asp:Label>
                                                                <asp:RequiredFieldValidator ID="rftxtProduct" runat="server" ControlToValidate="txtProduct" ValidationGroup="MasterGroup" CssClass="MasterValidationCSS"
                                                                    ErrorMessage="This is required" Display="Dynamic"></asp:RequiredFieldValidator>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-3" id="div1" runat="server">
                                                            <label for="example-nf-email" class="col-md-6">Mix Type</label>
                                                            <div class="col-md-6">
                                                                <asp:DropDownList ID="ddlMixTypeForm" runat="server" data-toggle="tooltip" title="Select Product" CssClass="form-control select-chosen" TabIndex="2">
                                                                    <asp:ListItem Value="Bread">Bread</asp:ListItem>
                                                                    <asp:ListItem Value="Cake">Cake</asp:ListItem>
                                                                </asp:DropDownList>
                                                                <asp:RequiredFieldValidator ID="RequiredFieldValidator2" runat="server" ControlToValidate="ddlProduct" ValidationGroup="MasterGroup" CssClass="MasterValidationCSS"
                                                                    ErrorMessage="This is Required"  Display="Dynamic"></asp:RequiredFieldValidator>
                                                            </div>
                                                            <asp:Label ID="lblMixError" runat="server" Style="color: red;" Visible="false">Please update Mix Type of selected Product</asp:Label>
                                                        </div>
                                                        <div class="col-md-3">
                                                            <label for="example-nf-email" class="col-md-5">Quantity(KG) </label>
                                                            <div class="col-md-7">
                                                                <asp:TextBox ID="txtQuantityForm" runat="server" data-toggle="tooltip" placeholder="Enter Quantity" onkeyup="this.value=this.value.replace(/[^\d\.]/g,'');" title="Enter Quantity" CssClass="form-control decimal" TabIndex="3"></asp:TextBox>
                                                                <asp:Label ID="lblKG" runat="server" Style="color: red;" Visible="false">This is required</asp:Label>
                                                                <asp:RequiredFieldValidator ID="RftxtQuantityForm" runat="server" ControlToValidate="txtQuantityForm" ValidationGroup="MasterGroup" CssClass="MasterValidationCSS"
                                                                    ErrorMessage="This is required" Display="Dynamic"></asp:RequiredFieldValidator>
                                                                <asp:RegularExpressionValidator ID="RegExptxtQuantityForm" runat="server" Display="Dynamic" ValidationGroup="MasterGroup" CssClass="MasterValidationCSS" ControlToValidate="txtQuantityForm" ErrorMessage="0 is not valid."
                                                                    ValidationExpression="^(?=.*[1-9])(?:[1-9]\d*\.?|0?\.)\d*$"></asp:RegularExpressionValidator>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <%--<asp:Button ID="ntntest" ValidationGroup="1"  runat="server"  Text="test" />--%>
                                                    <div class="col-md-1 pull-right">
                                                        <asp:Button Text="Submit" runat="server" ID="btnSubmit" OnClientClick="if (!Page_ClientValidate('MasterGroup')){ return false; } this.disabled = true; this.value = 'Exploring...';"
                                                            UseSubmitBehavior="false" class="btn btn-xs btn-success" ValidationGroup="MasterGroup" OnClick="btnSubmit_Click" />
                                                        <%--<asp:Button Text="Submit Quotation" runat="server" ID="btnadd" OnClientClick="if (!Page_ClientValidate('MasterGroup1')){ return false; } this.disabled = true; this.value = 'Saving...';"
                            UseSubmitBehavior="false" class="btn btn-alt btn-sm btn-primary" ValidationGroup="MasterGroup1" Style="width: 183px; border: 1px solid #A39A9A; padding: 7px; background-color: #B31616; color: white; margin-right: 15px;" />--%>
                                                    </div>
                                                    <div style="clear: both"></div>


                                                    <br />
                                                    <br />
                                                </ContentTemplate>
                                                <Triggers>
                                                    <%--  <asp:PostBackTrigger ControlID="gvLMS" />--%>
                                                </Triggers>
                                            </asp:UpdatePanel>

                                            <div class="table-responsive">
                                                <div class="widget-extra-full">
                                                    <div class="form-horizontal">
