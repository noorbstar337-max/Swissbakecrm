                                                                    <asp:LinkButton ID="Calc" data-toggle="tooltip" title="Calculate Total" class="btn btn-success" runat="server" OnClientClick="if (!Page_ClientValidate('MasterGroup')){ return false; } this.disabled = true; this.value = 'Adding...';"
