                        Dim txtComment As TextBox = DirectCast(grdGPTravelling.Rows(rowIndex).Cells(0).FindControl("txtComment"), TextBox)
                        Dim txtFeedback As TextBox = DirectCast(grdGPTravelling.Rows(rowIndex).Cells(0).FindControl("txtFeedback"), TextBox)
                        grdGPTravelling.Rows(i).Cells(0).Text = Convert.ToString(i + 1)
                        Dim approved, Ordered As String
                        If ddlApproved.SelectedValue = 0 Then
                            approved = False
                        Else
                            approved = True
                        End If

                        If ddlApproved.SelectedValue = 0 Then
                            Ordered = False
                        Else
                            Ordered = True
                        End If

                     
                        'drCurrentRow = dt.NewRow()
                        'drCurrentRow("RowNumber") = i + 1
                        dt.Rows(i)("RowNumber") = i + 1
                        dt.Rows(i)("SampleRequestDetail_ProductId") = ddlGridProductName.SelectedValue
                        dt.Rows(i)("SampleRequestDetail_ProductQnty") = txtQuantity.Text
                        dt.Rows(i)("SampleRequestDetail_Remark") = txtComment.Text
                        dt.Rows(i)("SampleRequestDetail_Feedback") = txtFeedback.Text
                        dt.Rows(i)("SampleRequestDetail_Approved") = approved
                        dt.Rows(i)("SampleRequestDetail_Ordered") = Ordered

                        ddlGridProductName.SelectedValue = dt.Rows(i)("SampleRequestDetail_ProductId").ToString
