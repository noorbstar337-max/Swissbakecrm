                        txtFeedback.Text = dt.Rows(i)("SampleRequestDetail_Feedback").ToString
                        Ordered = dt.Rows(i)("SampleRequestDetail_Ordered").ToString
                        approved = dt.Rows(i)("SampleRequestDetail_Approved").ToString
                        rowIndex += 1

                        grdGPTravelling.Rows(i).Cells(0).Text = Convert.ToString(i + 1)

                        If i < dt.Rows.Count - 1 Then
                            ddlGridProductName.Enabled = False
                        End If
                    Next

                End If
                'If dt.Rows.Count = 1 Then
