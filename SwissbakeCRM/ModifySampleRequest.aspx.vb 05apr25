	Public Sub RegistrationMail()
		Try
			MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
			Dim sb As New StringBuilder
			Dim count As Integer = 1
			Dim s As String = ""
			Dim body As String = String.Empty
			Dim reader As StreamReader = New StreamReader(Server.MapPath("~/Email/SampleRequest_Placing.html"))
			body = reader.ReadToEnd
			'	Dim ds As DataSet = ViewState("GridRowItems")
			'	Dim dt As DataTable = ds.Tables(0)
			sb.Append("<table border='1' cellspacing='0' cellpadding='5' style='border-color: rgb(247, 247, 247);width:100%;text-align:center;'><tr>")
			sb.Append("<th><center>SR</center></th>")
			sb.Append("<th><center>PRODUCT NAME</center></th>")
			sb.Append("<th style='width:15%;'><center>ORDERED QTY</center></th></tr>")
			For i As Integer = 0 To grdGPTravelling.Rows.Count - 1
				Dim ddlGridProductName As DropDownList = DirectCast(grdGPTravelling.Rows(i).FindControl("ddlGridProductName"), DropDownList)
				'Dim ddlQuantity As DropDownList = DirectCast(grdGPTravelling.Rows(i).FindControl("ddlQuantity"), DropDownList)
				Dim txtQuantity As TextBox = DirectCast(grdGPTravelling.Rows(i).FindControl("txtQuantity"), TextBox)
				sb.Append("<tr><td>" + count.ToString() + "</td>")
				sb.Append("<td>" + ddlGridProductName.SelectedItem.Text + "</td>")
                sb.Append("<td>" + txtQuantity.Text + " KG </td></tr>")
				count = count + 1
			Next
			sb.Append("</table>")
            body = body.Replace("#Table", sb.ToString)
            Dim dt As DataSet = SampleBLL.InsertCity("Insertcity", ddrelatedtypeid.SelectedValue, ddrelatedtype.SelectedValue)
            If dt.Tables(0).Rows(0)(0) = "" Then
                body = body.Replace("#COMPANY", ddrelatedtypeid.SelectedItem.Text + "(" + dt.Tables(0).Rows(0)(1) + "- City is not mention)")
            Else
                body = body.Replace("#COMPANY", ddrelatedtypeid.SelectedItem.Text + "(" + dt.Tables(0).Rows(0)(1) + "-" + dt.Tables(0).Rows(0)(0) + ")")
            End If
            'body = body.Replace("#COMPANY", ddrelatedtypeid.SelectedItem.Text)
			If MainID = 0 Then
				body = body.Replace("#UPDATE", "")
			Else
				body = body.Replace("#UPDATE", "(Updated)")
			End If
			body = body.Replace("#SALES", Session("UName"))
			'Dim ds As DataSet = UserBLL.Email(Session("UserId"))
            Dim email As String = UserBLL.Email(Session("UserId"))

            If email <> "" Then
                email = email + ",gufran@swissbake.in,farhan@swissbake.in"
                SendMailBLL.SendMail(email, body.ToString, "Sample Request Received")
            Else
                SendMailBLL.SendMail("accounts@swissbake.in", body.ToString, "Sample Request Received")
            End If
			reader.Dispose()
		Catch ex As Exception
			Dim error1 As String = ex.Message.Replace(Chr(34), "")
			error1 = error1.Replace(Chr(39), "")
			'ExecptionBLL.Insert("ModifyQuotation", "btnadd_Click", error1, Session("UserId"))
			ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
		End Try
	End Sub
