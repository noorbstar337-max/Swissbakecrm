    Protected Sub txtProduct_TextChanged(sender As Object, e As EventArgs) Handles txtProduct.TextChanged
        Try
            Dim Exist As String = LMSBLL.CheckProdExist(txtProduct.Text)
            If Exist = "True" Then
                lblProdExist.Visible = True
                btnSubmit.Visible = False
            Else
                lblProdExist.Visible = False
                btnSubmit.Visible = True
            End If
        Catch ex As Exception

        End Try
    End Sub

