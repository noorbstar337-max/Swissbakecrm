Imports DynamicparcelEnumerations
Imports System.Data
Imports System.Data.SqlClient
Imports System.Net

Partial Class ModifyFormulation
    ' Inherits _PageBaseClass
    Inherits System.Web.UI.Page
    Dim Flag As Integer
    Dim Flag1 As Integer
    Dim MainID As Integer

    Protected Sub Page_Init(sender As Object, e As EventArgs) Handles Me.Init
        Try
            If Session("LMSUserRoleID") = Nothing Then

                TryCast(Me.Master, LMSMasterPage).MaintainSession()
                If (Request.QueryString("Id") = Nothing) Then
                    Response.Redirect("LMSDashboard.aspx")
                End If
                If Request.QueryString("chk") = "v" Then
                    DisableViewMode()
                Else

                End If
                LMSBLL.CheckLMSPrivilegeForModify(Session("LMSUserRoleID"), "Formulation.aspx")
            Else
                If (Request.QueryString("Id") = Nothing) Then
                    Response.Redirect("LMSDashboard.aspx")
                End If
                If Request.QueryString("chk") = "v" Then
                    DisableViewMode()
                Else

                End If
                LMSBLL.CheckLMSPrivilegeForModify(Session("LMSUserRoleID"), "Formulation.aspx")
            End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("ModifyFormulation", "Page_Init", error1, Session("LMSUserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "');window.location='LMSDashboard.aspx';", True)
        End Try
    End Sub

    Protected Sub Page_Load(sender As Object, e As EventArgs) Handles Me.Load
        Try
            If Not IsPostBack Then
                Dim dt As DataSet = LMSPrivilegeBLL.CheckLMSPrivilege(Session("LMSUserRoleID"), "Formulation.aspx")
                If dt.Tables(0).Rows.Count > 0 Then
                    If Request.QueryString("chk") = "e" Then
                        If dt.Tables(0).Rows(0)("Prvg_RUpdate") = True Then
                        Else
                            Response.Redirect("LMSDashboard.aspx")
                        End If
                    Else
                        If dt.Tables(0).Rows(0)("Prvg_Rview") = True Then
                        Else
                            Response.Redirect("LMSDashboard.aspx")
                        End If
                        If dt.Tables(0).Rows(0)("Prvg_RAdd") = True Then
                        Else
                            Response.Redirect("LMSDashboard.aspx")
                        End If
                    End If
                Else
                    Response.Redirect("LMSDashboard.aspx")
                End If
                'If Request.QueryString("chk") = "v" Then
                '    DisableViewMode()
                'Else

                'End If
                MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
                LMSassigncontrol.Uhftype.Value = "Formulation"
                LMSassigncontrol.Uhftypeid.Value = MainID
                'MultiView1.ActiveViewIndex = 0
                liFormulation.Attributes("class") = "active"

                'If Request.QueryString("chk") = "v" Then
                '    FillddlProductForm()
                '    FillFormulationNo()
                '    FillDetailForm()

                '    DisableViewMode()
                'Else
                If MainID = 0 Then
                    lnkRecipe.NavigateUrl = "ModifyRecipe.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(MainID)) '+ "&Fid=" + HttpUtility.UrlEncode(Security.Encrypt(MainID))
                    btnprint.Visible = False
                    btnprintblank.Visible = False
                    modifyspan.Visible = False

                    FillddlProductForm()
                    FillFormulationNo()
                Else

                    Dim dt1 As DataSet = LMSBLL.FillGridByID(MainID, "CountRecipe")

                    If dt1.Tables(0).Rows.Count = 0 Then
                        lnkRecipe.NavigateUrl = "ModifyRecipe.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(0)) + "&Fid=" + HttpUtility.UrlEncode(Security.Encrypt(MainID)) + "&M=" + HttpUtility.UrlEncode(Security.Encrypt(0))
                    Else
                        lnkRecipe.NavigateUrl = "ModifyRecipe.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(dt1.Tables(0).Rows(0)(0))) + "&Fid=" + HttpUtility.UrlEncode(Security.Encrypt(MainID)) + "&M=" + HttpUtility.UrlEncode(Security.Encrypt(0))

                    End If
                    btnprint.Visible = True
                    btnprintblank.Visible = True
                    modifyspan.Visible = True

                    DisableProdz()
                    FillddlProductForm()
                    gvLMS.Visible = True
                    btnFormulationSaveNext.Visible = True
                    btnFormulationSave.Visible = True
                    btnFormulationSaveApprove.Visible = True
                    btnCalc.Visible = True
                    FillDetailForm()
                    btnCalc_Click(Nothing, Nothing)
                    If Request.QueryString("chk") = "v" Then
                        DisableViewMode()
                    End If
                End If
                'End If

                lnkFormulation.Enabled = False
                lnkTrial.Enabled = False
            End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
#Region "Formulation"
