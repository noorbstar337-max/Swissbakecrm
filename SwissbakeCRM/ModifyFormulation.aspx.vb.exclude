    Protected Sub btnFormulationSaveNext_Click(sender As Object, e As EventArgs) Handles btnFormulationSaveNext.Click
        Try
            InsertFormulation()

            If MainID = 0 Then
                Response.Redirect("ModifyRecipe.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(MainID)) + "&Fid=" + HttpUtility.UrlEncode(Security.Encrypt(ViewState("Formulation_Id"))))
            Else
                Dim dt As DataSet = LMSBLL.FillGridByID(ViewState("Formulation_Id"), "CountRecipe")
                If dt.Tables(0).Rows.Count <> 0 Then
                    If dt.Tables(0).Rows.Count > 1 Then
                        Response.Redirect("ModifyRecipe.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(dt.Tables(0).Rows(0)(0))) + "&Fid=" + HttpUtility.UrlEncode(Security.Encrypt(ViewState("Formulation_Id"))) + "&M=" + HttpUtility.UrlEncode(Security.Encrypt(1)))
                    Else
                        If dt.Tables(0).Rows(0)(0) = Nothing Then
                            Response.Redirect("ModifyRecipe.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(0)) + "&Fid=" + HttpUtility.UrlEncode(Security.Encrypt(ViewState("Formulation_Id"))) + "&M=" + HttpUtility.UrlEncode(Security.Encrypt(0)))
                        Else
                            Response.Redirect("ModifyRecipe.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(dt.Tables(0).Rows(0)(0))) + "&Fid=" + HttpUtility.UrlEncode(Security.Encrypt(ViewState("Formulation_Id"))) + "&M=" + HttpUtility.UrlEncode(Security.Encrypt(0)))
                        End If
                    End If
                Else
                    Response.Redirect("ModifyRecipe.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(0)) + "&Fid=" + HttpUtility.UrlEncode(Security.Encrypt(ViewState("Formulation_Id"))))
                End If

            End If

            'Response.Redirect("LabManagement.aspx?view=RecipeView" + "&id=" + Security.Encrypt(HttpUtility.UrlEncode(MainID.ToString)))
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub

    Protected Sub btnFormulationSave_Click(sender As Object, e As EventArgs) Handles btnFormulationSave.Click
        Try
            InsertFormulation()
            Response.Redirect("Formulation.aspx")
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
