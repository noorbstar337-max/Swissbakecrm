        function FillDeliveryAddr() {
            debugger;
            var txtaddressbill = document.getElementById('<%=txtaddressbill.ClientID%>');
            var txtpincodebill = document.getElementById('<%=txtpincodebill.ClientID%>');
            var ddlcountrybill = document.getElementById('<%=ddlcountrybill.ClientID%>');
            var ddlstatebill = document.getElementById('<%=ddlstatebill.ClientID%>');
            var txtcitybill = document.getElementById('<%=txtcitybill.ClientID%>');

            var txtDelAddress = document.getElementById('<%=txtDelAddress.ClientID%>');
            var txtDelPin = document.getElementById('<%=txtDelPin.ClientID%>');
            var ddlDelCountry = document.getElementById('<%=ddlDelCountry.ClientID%>');
            var ddlDelState = document.getElementById('<%=ddlDelState.ClientID%>');
            var txtDelCity = document.getElementById('<%=txtDelCity.ClientID%>');

            var chkSameAddress = document.getElementById('<%=chkSameAddress.ClientID%>');

            if (chkSameAddress.checked) {
                txtDelAddress.value = txtaddressbill.value;
                txtDelPin.value = txtpincodebill.value;

                // Country selection
                ddlDelCountry.value = ddlcountrybill.value;

                // Manually trigger country change event
                ddlDelCountry.dispatchEvent(new Event('change'));

                // Wait for state dropdown to load and then set the state value
                setTimeout(function () {
                    ddlDelState.value = ddlstatebill.value;

                    // In case the state dropdown is populated dynamically, trigger change event
                    ddlDelState.dispatchEvent(new Event('change'));
                }, 1000); // Increased timeout to 1 sec for reliable state loading

                txtDelCity.value = txtcitybill.value;
            } else {
                txtDelAddress.value = '';
                txtDelPin.value = '';
                ddlDelCountry.value = '';
                ddlDelState.value = '';
                txtDelCity.value = '';
            }
        }


    </script>
