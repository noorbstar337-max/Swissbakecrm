    Protected Sub Page_Init(sender As Object, e As EventArgs) Handles Me.Init
        If Session("UserId") = Nothing Then
            TryCast(Me.Master, MainPage).MaintainSession()
        End If
    End Sub

    Protected Sub Page_Load(sender As Object, e As EventArgs) Handles Me.Load
        Try
            ''SearchControl.ULkadd.Visible = True
            'SearchControl.ULkadd.Text = "Quick Add"
            'SearchControl.Uhfadd.NavigateUrl = Page.ResolveUrl("ModifyLead.aspx?ID=" + HttpUtility.UrlEncode(Security.Encrypt(0)) + "&returnurl=y")
            If Not IsPostBack Then
                'fillGlobalSearch()
                GridView1.AllowCustomPaging = True
                'Hfgridview.Value = "LeadGridviewByAssign"
                'hfsearch.Value = "SearchLeadByAssign"
                'hftotalrecord.Value = "LeadTotalNumberOfRecord"
                fillLead()
                CheckPrivilage()
                'Above Line For Passing Mode In Search Lead Control
