Imports System.Drawing

Partial Class Lead
    Inherits _PageBaseClass
    Private MainId As Integer
    Private Type As String
    Dim Query As String
    Dim ModuleName As String
    Dim strNames As New List(Of String)
    Dim sb As New StringBuilder
