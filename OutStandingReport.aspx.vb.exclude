    Protected Sub btnExportExcel_Click(sender As Object, e As EventArgs) Handles btnExportExcel.Click
        Try
            Response.Clear()
            Response.Buffer = True
            Response.AddHeader("content-disposition", "attachment;filename=GridViewExport.xls")
            Response.Charset = ""
            Response.ContentType = "application/vnd.ms-excel"
            Dim sw As New StringWriter()
            Dim hw As New HtmlTextWriter(sw)

            If String.IsNullOrEmpty(txtsearch.Text.Trim) And String.IsNullOrEmpty(DynamicparcelDataManipulation.DateFormat(txtstartdate.Text)) Then
                GridView1.DataSource = reportBLL.topaccount()
                GridView1.DataBind()
            ElseIf String.IsNullOrEmpty(txtsearch.Text) And Not String.IsNullOrEmpty(DynamicparcelDataManipulation.DateFormat(txtstartdate.Text)) Then
                GridView1.DataSource = reportBLL.TopAccountInPeriod(DynamicparcelDataManipulation.DateFormat(txtstartdate.Text), DynamicparcelDataManipulation.DateFormat(txtEndDate.Text))
                GridView1.DataBind()
            ElseIf Not String.IsNullOrEmpty(txtsearch.Text) And String.IsNullOrEmpty(DynamicparcelDataManipulation.DateFormat(txtstartdate.Text)) Then
                GridView1.DataSource = reportBLL.TopAccountInPeriodSearchnoDate(txtsearch.Text)
                GridView1.DataBind()
            Else
                GridView1.DataSource = reportBLL.TopAccountInPeriodSearch(DynamicparcelDataManipulation.DateFormat(txtstartdate.Text), DynamicparcelDataManipulation.DateFormat(txtEndDate.Text), txtsearch.Text.Trim)
                GridView1.DataBind()
            End If

            GridView1.RenderControl(hw)

            'style to format numbers to string 
            Dim style As String = "<style> .textmode { mso-number-format:\@; } </style>"
            Response.Write(style)
            Response.Output.Write(sw.ToString())
            Response.Flush()
            Response.End()
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert("CustomMis", "btnExportExcel_Click", error1, Session("UserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
            ' Throw ex
        End Try
    End Sub

