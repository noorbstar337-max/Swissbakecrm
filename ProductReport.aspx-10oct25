                                    <td class="text-center" style="width: 100px"><i class="fa fa-inr " /><%#DynamicparcelDataManipulation.FixNullFromDB(Eval("OrDetail_Rate"))%></td>
                                    <td class="text-center" style="width: 100px"><i class="fa fa-inr " /><%#DynamicparcelDataManipulation.FixNullFromDB(CInt(Eval("total")).ToString("N2"))%></td>
                                    <td class="text-center" style="width: 100px"><%#DynamicparcelDataManipulation.FixNullFromDB(Eval("U_FirstName"))%>
                                         
                                    </td>
