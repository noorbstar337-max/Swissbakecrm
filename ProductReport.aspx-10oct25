                                    <td class="text-center" style="width: 100px">
                                        <asp:Label ID="lblQty" runat="server" />&nbsp;<i class="fa">KG</i></td>
                                    <td class="text-center" style="width: 100px"><i class="fa fa-inr " style="display:none;"/>&nbsp;<asp:Label ID="lblrate" runat="server" Visible="false"/></td>
                                    <td class="text-center" style="width: 100px"><i class="fa fa-inr " />&nbsp;<asp:Label ID="lblprice" runat="server" /></td>
                                    <td class="text-center" style="width: 100px;" ></td>

                                </tr>
                                </table>
                            </FooterTemplate>
                        </asp:Repeater>
                    </tbody>
                    <tfoot>
                    </tfoot>
                    <%-- <tfoot>
                        <tr>
                            <th class="text-center">Order ID</th>                           
