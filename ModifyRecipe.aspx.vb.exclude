            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert(System.IO.Path.GetFileName(Request.Url.AbsolutePath), System.Reflection.MethodBase.GetCurrentMethod().Name, error1, Session("LMSUserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub

    Protected Sub rpPopUp_ItemDataBound(sender As Object, e As RepeaterItemEventArgs) Handles rpPopUp.ItemDataBound
        Try
            Dim lblRecipe_IdPop As Label = DirectCast(e.Item.FindControl("lblRecipe_IdPop"), Label)

            Dim gvRecipeIngPOP As GridView = TryCast(e.Item.FindControl("gvRecipeIngPOP"), GridView)
            Dim dt As DataSet = LMSBLL.FillGridByID(Convert.ToInt32(lblRecipe_IdPop.Text), "DispRecipeIngredients")
            gvRecipeIngPOP.DataSource = dt.Tables(1)
            gvRecipeIngPOP.DataBind()

            'Dim gvRecipeProcDisplay As GridView = TryCast(e.Item.FindControl("gvRecipeProcDisplay"), GridView)
            'gvRecipeProcDisplay.DataSource = dt.Tables(2)
            'gvRecipeProcDisplay.DataBind()
            'Dim btnCopyRecipe As LinkButton = DirectCast(e.Item.FindControl("btnCopyRecipe"), LinkButton)

        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert(System.IO.Path.GetFileName(Request.Url.AbsolutePath), System.Reflection.MethodBase.GetCurrentMethod().Name, error1, Session("LMSUserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
#End Region
    Protected Sub btnprint_ServerClick(sender As Object, e As EventArgs) Handles btnprint.ServerClick
        Try
            MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
            Response.Redirect("Printrecipe.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(MainID)))
        Catch ex As Exception

        End Try

    End Sub


    Protected Sub btnprintblank_ServerClick(sender As Object, e As EventArgs) Handles btnprintblank.ServerClick
        Try
            MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
            Response.Redirect("Printrecipe.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(MainID)) + "&print=b")
        Catch ex As Exception

        End Try
    End Sub

End Class
