Imports DynamicparcelEnumerations
Imports System.Data
Imports System.Data.SqlClient
Imports System.Net
Partial Class ModifyRecipe
    Inherits _PageBaseClass
    'Inherits System.Web.UI.Page
    Dim Flag As Integer
    Dim version As Double = 0.0
    Dim MainID As Integer
    Dim Fid As Integer
    Dim M As Integer

    Protected Sub Page_Init(sender As Object, e As EventArgs) Handles Me.Init
        Try
            If Session("LMSUserId") = Nothing Then

                TryCast(Me.Master, LMSMasterPage).MaintainSession()
                If (Request.QueryString("Id") = Nothing) Then
                    Response.Redirect("LMSDashboard.aspx")
                End If
                If Request.QueryString("chk") = "v" Then
                    DisableViewMode()
                Else

                End If
                LMSBLL.CheckLMSPrivilegeForModify(Session("LMSUserRoleID"), "Recipe.aspx")
            Else
                If (Request.QueryString("Id") = Nothing) Then
                    Response.Redirect("LMSDashboard.aspx")
                End If
                If Request.QueryString("chk") = "v" Then
                    DisableViewMode()
                Else

                End If
                LMSBLL.CheckLMSPrivilegeForModify(Session("LMSUserRoleID"), "Recipe.aspx")
            End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert(System.IO.Path.GetFileName(Request.Url.AbsolutePath), System.Reflection.MethodBase.GetCurrentMethod().Name, error1, Session("LMSUserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "');window.location='LMSDashboard.aspx';", True)
        End Try
    End Sub

    Protected Sub Page_Load(sender As Object, e As EventArgs) Handles Me.Load
        Try

            If Not IsPostBack Then
                Dim dt As DataSet = LMSPrivilegeBLL.CheckLMSPrivilege(Session("LMSUserRoleID"), "Recipe.aspx")
                If dt.Tables(0).Rows.Count > 0 Then
                    If Request.QueryString("chk") = "e" Then
                        If dt.Tables(0).Rows(0)("Prvg_RUpdate") = True Then
                        Else
                            Response.Redirect("LMSDashboard.aspx")
                        End If
                    Else
                        If dt.Tables(0).Rows(0)("Prvg_Rview") = True Then
                        Else
                            Response.Redirect("LMSDashboard.aspx")
                        End If
                        If dt.Tables(0).Rows(0)("Prvg_RAdd") = True Then
                        Else
                            Response.Redirect("LMSDashboard.aspx")
                        End If
                    End If
                Else
                    Response.Redirect("LMSDashboard.aspx")
                End If
                MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
                If Request.QueryString("Fid") <> Nothing Then
                    Fid = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Fid")))
                End If
                LMSassigncontrol.Uhftype.Value = "Recipe"
                LMSassigncontrol.Uhftypeid.Value = MainID
                liRecipe.Attributes("class") = "active"
                'lnkFormulation.NavigateUrl = "ModifyFormulation.aspx?ID=" + HttpUtility.UrlEncode(Security.Encrypt(MainID)) + "&returnurl=y"
                'lnkRecipe.NavigateUrl = "ModifyRecipe.aspx?ID=" + HttpUtility.UrlEncode(Security.Encrypt(MainID)) + "&returnurl=y"
                'lnkTrial.NavigateUrl = "ModifyTrial.aspx?ID=" + HttpUtility.UrlEncode(Security.Encrypt(MainID)) + "&returnurl=y"

                If MainID = "0" Then
                    btnprint.Visible = False
                    btnprintblank.Visible = False
                    modifyspan.Visible = False
                    btnRecipeSaveApprove.Visible = False
                    btnRecipeDisApprove.Visible = False
                    btnRecipeSaveNext.Visible = False
                    If Fid = "0" Then
                        divRecipeHistory.Visible = False
                        divFormulationType.Visible = False
                        ddlFormulationNo.Visible = True
                        FillddlProductRecipe()
                        FillRecipeNo()
                        AddRecipeFirstRow()
                        AddProcedureFirstRow()
                    Else
                        ViewState("Formulation_Id") = Fid
                        divFormulationType.Visible = False
                        divFormulationNo.Visible = False
                        divDDLProduct.Visible = False
                        divTxtProduct.Visible = False
                        divRecipeHistory.Visible = False
                        FillddlProductRecipe()
                        FillRecipeNo()
                        AddRecipeFirstRow()
                        AddProcedureFirstRow()
                        'btnRecipeSaveApprove.Visible = True
                        'btnRecipeDisApprove.Visible = True
                        'btnRecipeSaveNext.Visible = True
                        btnRecipeSaveNew.Visible = True
                    End If
                Else
                    btnprint.Visible = True
                    btnprintblank.Visible = True
                    If Fid = "0" Then
                        divRecipeHistory.Visible = False
                        divFormulationType.Visible = False
                        divFormulationNo.Visible = False
                        divDDLProduct.Visible = False
                        divTxtProduct.Visible = False
                        FillddlProductRecipe()
                        AddRecipeFirstRow()
                        AddProcedureFirstRow()
                        DisableFormulation()
                        FillDetailRecipe()
                        gvIngredient.HeaderRow.Visible = False
                        ' FillRecipeHistory()
                    Else
                        If Request.QueryString("M") <> Nothing Then
                            M = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("M")))
                        End If
                        If M = 0 Then
                            divRecipeHistory.Visible = False
                            divFormulationType.Visible = False
                            divFormulationNo.Visible = False
                            divDDLProduct.Visible = False
                            divTxtProduct.Visible = False
                            FillddlProductRecipe()
                            AddRecipeFirstRow()
                            AddProcedureFirstRow()
                            DisableFormulation()
                            FillDetailRecipe()
                            gvIngredient.HeaderRow.Visible = False
                        Else
                            FillPopUp()
                            mpe.Show()
                        End If
                    End If
                    If Request.QueryString("chk") = "v" Then
                        DisableViewMode()
                    End If

                End If
                ' GetRecipeDynamic()
                'FillRecipe()
            End If
            'gvIngredient.HeaderRow.Visible = False
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert(System.IO.Path.GetFileName(Request.Url.AbsolutePath), System.Reflection.MethodBase.GetCurrentMethod().Name, error1, Session("LMSUserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub

#Region "Recipe"
    Public Sub FillddlProductRecipe()
        Try
            Dim ds As DataSet
            ds = LMSBLL.DropdownWithUserId("FillProductByID", Session("LMSUserId"), Session("LMSUserRoleID"))
            ddlProduct.DataSource = ds.Tables(0)
            ddlProduct.DataTextField = "Product_Name"
            ddlProduct.DataValueField = "Product_Id"

            ddlProduct.DataBind()
            ddlProduct.Items.Insert(0, New ListItem("Select Product", "0"))
            'ddlProduct.Items.Insert(0, "Select Product")
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert(System.IO.Path.GetFileName(Request.Url.AbsolutePath), System.Reflection.MethodBase.GetCurrentMethod().Name, error1, Session("LMSUserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
    Protected Sub ddlProduct_SelectedIndexChanged(sender As Object, e As EventArgs) Handles ddlProduct.SelectedIndexChanged
        Try
            If ddlProduct.SelectedValue = "0" Then
                ddlFormulationNo.SelectedValue = 0
                ddlFormulationNo.Enabled = False
            Else
                ddlFormulationNo.Enabled = True
                FillFormulationNoInRecipe()
            End If
            ddlMixer.SelectedValue = 0
            ddlBlade.SelectedValue = 0
            ddlMould.SelectedValue = 0
            ddlOven.SelectedValue = 0
            AddRecipeFirstRow()
            AddProcedureFirstRow()
            txtRemarkIngre.Text = ""
            txtRemarkProc.Text = ""
            divRecipeHistory.Visible = False
            btnRecipeSaveApprove.Visible = False
            btnRecipeDisApprove.Visible = False
            btnRecipeSaveNext.Visible = False
            btnRecipeSaveNew.Visible = False
            lblFormNoTab.Text = ""
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert(System.IO.Path.GetFileName(Request.Url.AbsolutePath), System.Reflection.MethodBase.GetCurrentMethod().Name, error1, Session("LMSUserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
    Private Sub FillFormulationNoInRecipe()
        Try
            Dim ds As DataSet
            Dim value As String() = ddlProduct.SelectedValue.Split("^")

            If value(1) = 0 Then
                ds = LMSBLL.DropdownByName("FillFormulationNoByName", value(0))
            Else
                ds = LMSBLL.DropdownById("FillFormulationNo", value(1))
            End If
            ddlFormulationNo.DataSource = ds.Tables(0)
            ddlFormulationNo.DataTextField = "Formulation_No"
            ddlFormulationNo.DataValueField = "Formulation_Id"
            ddlFormulationNo.DataBind()
            ddlFormulationNo.Items.Insert(0, New ListItem("Select Formulation No", "0"))
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert(System.IO.Path.GetFileName(Request.Url.AbsolutePath), System.Reflection.MethodBase.GetCurrentMethod().Name, error1, Session("LMSUserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub

    Private Sub FillRecipeNo()
        Try
            Dim RecipeNo As String = LMSBLL.RecipeNo()
            lblRecipeNo.Text = RecipeNo
            LMSassigncontrol.UhfTypeCode.Value = RecipeNo
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert(System.IO.Path.GetFileName(Request.Url.AbsolutePath), System.Reflection.MethodBase.GetCurrentMethod().Name, error1, Session("LMSUserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
    Public Sub CopyDetailRecipe()
        Try
            'MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
            'If Request.QueryString("Fid") <> Nothing Then
            '    Fid = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Fid")))
            'End If
            Dim dt As DataSet
            'If MainID = 0 Then
            dt = LMSBLL.FillGridByID(ViewState("RecipeIDForFill"), "DispRecipeIngredients")
            ' Else
            'btnRecipeSaveApprove.Visible = True
            'btnRecipeDisApprove.Visible = True
            'btnRecipeSaveNext.Visible = True
            'btnRecipeSave.Visible = True
            'dt = LMSBLL.FillGridByID(MainID, "DispRecipeIngredients")
            'End If
            Dim dtUser As New DataTable
            dtUser = dt.Tables(0)
            Dim drLogin As DataRow
            If dtUser.Rows.Count > 0 Then

                drLogin = dtUser.Rows(0)
                'If DynamicparcelDataManipulation.FixNullFromDB(drLogin("Recipe_Approved")) = "Approved" Then
                '    lblapproved.Text = "Approved"
                '    btnRecipeSaveApprove.Visible = False
                '    btnRecipeDisApprove.Visible = False
                'ElseIf DynamicparcelDataManipulation.FixNullFromDB(drLogin("Recipe_Approved")) = "Pending" Then
                '    lblapproved.Text = "Pending"
                '    btnRecipeSaveApprove.Visible = True
                '    btnRecipeDisApprove.Visible = True
                'Else
                '    lblapproved.Text = "Rejected"
                '    btnRecipeSaveApprove.Visible = False
                '    btnRecipeDisApprove.Visible = False
                'End If
                'lblmodifiedname.Text = DynamicparcelDataManipulation.FixNullFromDB(drLogin("U_FirstName"))
                'lblmodifieddate.Text = DynamicparcelDataManipulation.AlphaDateFormat(DynamicparcelDataManipulation.FixNullFromDB(drLogin("Recipe_ModifiedDate")).ToString())
                ddlFormulationNo.SelectedValue = DynamicparcelDataManipulation.FixNullFromDB(drLogin("Recipe_FormulationId"))
                hfFRNo.Value = ddlFormulationNo.SelectedItem.Text
