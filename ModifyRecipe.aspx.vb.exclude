    Protected Sub btnRecipeSaveNext_Click(sender As Object, e As EventArgs) Handles btnRecipeSaveNext.Click
        Try
            InsertRecipe()
            'Response.Redirect("ModifyTrial.aspx?ID=" + HttpUtility.UrlEncode(Security.Encrypt(MainID)) + "&Rid=" + HttpUtility.UrlEncode(Security.Encrypt(ViewState("Recipe_Id"))))
            If MainID = 0 Then
                Response.Redirect("ModifyTrial.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(MainID)) + "&Rid=" + HttpUtility.UrlEncode(Security.Encrypt(ViewState("Recipe_Id"))))
            Else
                Dim dt As DataSet = LMSBLL.FillGridByID(ViewState("Recipe_Id"), "CountTrial")
                If dt.Tables(0).Rows.Count <> 0 Then
                    If dt.Tables(0).Rows.Count > 1 Then
                        Response.Redirect("ModifyTrial.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(dt.Tables(0).Rows(0)(0))) + "&Rid=" + HttpUtility.UrlEncode(Security.Encrypt(ViewState("Recipe_Id"))) + "&M=" + HttpUtility.UrlEncode(Security.Encrypt(1)))
                    Else
                        If dt.Tables(0).Rows.Count = Nothing Then
                            Response.Redirect("ModifyTrial.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(0)) + "&Rid=" + HttpUtility.UrlEncode(Security.Encrypt(ViewState("Recipe_Id"))) + "&M=" + HttpUtility.UrlEncode(Security.Encrypt(0)))
                        Else
                            Response.Redirect("ModifyTrial.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(dt.Tables(0).Rows(0)(0))) + "&Rid=" + HttpUtility.UrlEncode(Security.Encrypt(ViewState("Recipe_Id"))) + "&M=" + HttpUtility.UrlEncode(Security.Encrypt(0)))
                        End If
                    End If
                Else
                    Response.Redirect("ModifyTrial.aspx?Id=" + HttpUtility.UrlEncode(Security.Encrypt(0)) + "&Rid=" + HttpUtility.UrlEncode(Security.Encrypt(ViewState("Recipe_Id"))))
                End If
            End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub

