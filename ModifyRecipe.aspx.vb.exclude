    Protected Sub rpRecipeHistory_ItemDataBound(sender As Object, e As RepeaterItemEventArgs) Handles rpRecipeHistory.ItemDataBound
        Try
            Dim lblRecipe_Id As Label = DirectCast(e.Item.FindControl("lblRecipe_Id"), Label)

            Dim gvRecipeIngDisplay As GridView = TryCast(e.Item.FindControl("gvRecipeIngDisplay"), GridView)
            Dim dt As DataSet = LMSBLL.FillGridByID(Convert.ToInt32(lblRecipe_Id.Text), "DispRecipeIngredients")
            gvRecipeIngDisplay.DataSource = dt.Tables(1)
            gvRecipeIngDisplay.DataBind()

            Dim gvRecipeProcDisplay As GridView = TryCast(e.Item.FindControl("gvRecipeProcDisplay"), GridView)
            gvRecipeProcDisplay.DataSource = dt.Tables(2)
            gvRecipeProcDisplay.DataBind()
            'Dim btnCopyRecipe As LinkButton = DirectCast(e.Item.FindControl("btnCopyRecipe"), LinkButton)

        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert(System.IO.Path.GetFileName(Request.Url.AbsolutePath), System.Reflection.MethodBase.GetCurrentMethod().Name, error1, Session("LMSUserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
