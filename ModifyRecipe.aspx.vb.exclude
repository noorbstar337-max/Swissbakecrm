    Public Sub GetRecipeDynamic()
        Try
            Dim strArr() As String
            Dim TemStr As String = ""
            Dim NameStr As String = ""
            Dim UrlStr As String = ""
            Dim IconStr As String = ""
            Dim ColorStr As String = ""
            Dim CategoryStr As String = ""
            Dim dtPrivi As New DataTable
            Dim strHTML As New StringBuilder

            Dim dt As DataSet = LMSBLL.FillGridByID(9, "FillDynamic")
            ' Dim dt As DataSet = LMSBLL.FillGridByID(ddlFormulationNo.SelectedValue, "FillDynamic")

            dtPrivi = dt.Tables(0)

            For i As Integer = 0 To dtPrivi.Rows.Count - 1
                '/Checking details page privilege here/
                TemStr = dtPrivi.Rows(i).Item("Recipe_Id").ToString()
                strArr = TemStr.Split(",")
                NameStr = dtPrivi.Rows(i).Item("Recipe_No").ToString()
                'UrlStr = dtPrivi.Rows(i).Item("Menu_URL").ToString()
                'IconStr = dtPrivi.Rows(i).Item("Menu_Icon").ToString()
                TemStr = NameStr.Replace(" ", "")
                CategoryStr = "ABC" 'dtPrivi.Rows(i).Item("Recipe_ProductId").ToString()

                strHTML.Append("<div id=")
                strHTML.Append(TemStr)
                strHTML.Append(" class='col-sm-2 col-lg-1'>")
                strHTML.Append(" <div class='media-items animation-fadeInQuickInv' data-category='")
                strHTML.Append(CategoryStr)
                strHTML.Append("'> <a href=")
                strHTML.Append(UrlStr)
                strHTML.Append(" class='")
                strHTML.Append(ColorStr)
                strHTML.Append("  '> <div class='media-items-content' style='padding: 1px 0 30px 0;'><i class='")
                strHTML.Append(IconStr)
                strHTML.Append(" fa-4x")
                strHTML.Append(ColorStr)
                strHTML.Append(" pull-left'></i></div><h4 style='font-size: 16px; padding-bottom: 7px; margin-top:-13px;'><strong>")
                strHTML.Append(NameStr)
                strHTML.Append("    </strong><br> </h4></a></div></div>")
            Next
            'divAdminMenu.InnerHtml = strHTML.ToString()
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert(System.IO.Path.GetFileName(Request.Url.AbsolutePath), System.Reflection.MethodBase.GetCurrentMethod().Name, error1, Session("LMSUserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
#Region "Recipe History"

    Protected Sub ddlFormulationNo_SelectedIndexChanged(sender As Object, e As EventArgs) Handles ddlFormulationNo.SelectedIndexChanged
        Try
            ViewState("Formulation_Id") = ddlFormulationNo.SelectedValue
            If ddlFormulationNo.SelectedValue <> 0 Then
                divRecipeHistory.Visible = True
                FillRecipeHistory()
            Else
                divRecipeHistory.Visible = False
            End If
            If MainID = 0 Then
                btnRecipeSaveApprove.Visible = False
                btnRecipeDisApprove.Visible = False
                btnRecipeSaveNext.Visible = False
            Else
                If Session("LMSUserId") = 1 Then
                    btnRecipeSaveApprove.Visible = True
                    btnRecipeDisApprove.Visible = True
                Else
                    btnRecipeSaveApprove.Visible = False
                    btnRecipeDisApprove.Visible = False
                End If
                btnRecipeSaveNext.Visible = True
            End If
            btnRecipeSaveNew.Visible = True
            If ddlFormulationNo.SelectedValue = 0 Then
                lblFormNoTab.Text = ""
            Else
                lblFormNoTab.Text = ddlFormulationNo.SelectedItem.Text
            End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert(System.IO.Path.GetFileName(Request.Url.AbsolutePath), System.Reflection.MethodBase.GetCurrentMethod().Name, error1, Session("LMSUserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub
    Public Sub FillRecipeHistory()
        Try
            MainID = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Id")))
            If Request.QueryString("Fid") <> Nothing Then
                Fid = Security.Decrypt(HttpUtility.UrlDecode(Request.QueryString("Fid")))
            End If
            If MainID = 0 Then
                If Fid = 0 Then
                    Dim value As String() = ddlProduct.SelectedValue.Split("^")

                    If value(1) = 0 Then
                        rpRecipeHistory.DataSource = LMSBLL.DropdownByIDName("getRecipeNoByName", Session("LMSUserRoleID"), value(0))
                        'rpRecipeHistory.DataSource = LMSBLL.DropdownWithUserId("getRecipeNo", Session("LMSUserRoleID"), ddlProduct.SelectedValue)
                    Else
                        rpRecipeHistory.DataSource = LMSBLL.DropdownWithUserId("getRecipeNo", Session("LMSUserRoleID"), value(1))
                    End If
                    'rpRecipeHistory.DataSource = LMSBLL.DropdownWithUserId("getRecipeNo", Session("LMSUserRoleID"), ddlFormulationNo.SelectedValue)
                Else
                    rpRecipeHistory.DataSource = LMSBLL.DropdownWithUserId("getRecipeNo", Session("LMSUserRoleID"), Fid)
                End If
            Else
                If Fid = 0 Then
                    rpRecipeHistory.DataSource = LMSBLL.DropdownWithUserId("getRecipeNo", Session("LMSUserRoleID"), MainID)
                Else
                    rpRecipeHistory.DataSource = LMSBLL.DropdownWithUserId("getRecipeNo", Session("LMSUserRoleID"), Fid)
                End If
            End If
            'If MainID = 0 Then
            '    If Fid = 0 Then
            '        rpRecipeHistory.DataSource = LMSBLL.FillGridByID(ddlFormulationNo.SelectedValue, "getRecipeCode")
            '    Else
            '        rpRecipeHistory.DataSource = LMSBLL.FillGridByID(Fid, "getRecipeCode")
            '    End If
            'Else
            '    If Fid = 0 Then
            '        rpRecipeHistory.DataSource = LMSBLL.FillGridByID(MainID, "getRecipeCode")
            '    Else
            '        rpRecipeHistory.DataSource = LMSBLL.FillGridByID(Fid, "getRecipeCode")
            '    End If
            'End If
            rpRecipeHistory.DataBind()

            Dim totalcount As Integer = rpRecipeHistory.Items.Count
            If totalcount > 0 Then
                lblRecipeHistory.Text = "Recipe History (" + totalcount.ToString + ")"
            Else
                divRecipeHistory.Visible = False
                'lblRecipeHistory.Text = "No Recipe History"
            End If
        Catch ex As Exception
            Dim error1 As String = ex.Message.Replace(Chr(34), "")
            error1 = error1.Replace(Chr(39), "")
            ExecptionBLL.Insert(System.IO.Path.GetFileName(Request.Url.AbsolutePath), System.Reflection.MethodBase.GetCurrentMethod().Name, error1, Session("LMSUserId"))
            ScriptManager.RegisterStartupScript(Page, Me.[GetType](), "Call", "alert('" + (error1.ToString).ToString + "')", True)
        End Try
    End Sub

